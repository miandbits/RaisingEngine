// Optional deterministic party combat. Legacy systems/battle remains unchanged.
const J& tacticsConfig(const J& c){return c["project"]["systems"]["tactics"];}
J& tacticsState(J& s){auto& sys=s["systems"];if(!sys.contains("tactics"))sys["tactics"]={{"growth",J::object()},{"equipment",J::object()},{"active",nullptr},{"last",nullptr}};return sys["tactics"];}
void tacticsLog(J& s,const std::string& text){auto& a=tacticsState(s)["active"];auto& log=a["log"];log.push_back(std::to_string(number(a["turn"]))+": "+text);if(log.size()>200)log.erase(log.begin());}
J tacticsFighter(const J& c,J& s,const std::string& id,const std::string& key){
 const auto& d=tacticsConfig(c);const auto& u=*find(d["units"],id);auto& t=tacticsState(s);auto stats=u["stats"];auto level=t["growth"].contains(id)?number(t["growth"][id]["level"]):1;
 if(u.contains("statAttributes"))for(auto it=u["statAttributes"].begin();it!=u["statAttributes"].end();++it){const auto character=u.value("characterId","");const auto& attributes=s.contains("roster")&&s["roster"]["attributes"].contains(character)?s["roster"]["attributes"][character]:s["attributes"];stats[it.key()]=std::max<int64_t>(it.key()=="maxHp"?1:0,number(attributes[it.value().get<std::string>()]));}
 if(u["control"]=="player")for(auto k:{"maxHp","attack","defense","speed"})stats[k]=number(stats[k])+(level-1)*number(d["growth"]["perLevel"][k]);
 if(t["equipment"].contains(id))for(const auto& eId:t["equipment"][id]){auto e=find(c["project"]["systems"]["equipment"],eId);if(e)for(auto k:{"maxHp","attack","defense"})stats[k]=number(stats[k])+number((*e)["modifiers"][k]);}
 stats["maxHp"]=std::max<int64_t>(1,number(stats["maxHp"]));return {{"id",key},{"unitId",id},{"faction",u["faction"]},{"control",u["control"]},{"row",u["row"]},{"column",u["column"]},{"hp",stats["maxHp"]},{"stats",stats},{"statuses",J::array()},{"cooldowns",J::object()},{"casting",nullptr}};
}
std::vector<std::string> tacticsTargets(const J& c,J& s,const J& actor,const J& skill){
 std::vector<J> targets;auto policy=str(skill,"target");bool enemy=policy=="enemy"||policy=="frontEnemy"||policy=="allEnemies";
 for(const auto& u:tacticsState(s)["active"]["units"])if(number(u["hp"])>0&&(policy=="self"?u["id"]==actor["id"]:enemy?u["faction"]!=actor["faction"]:u["faction"]==actor["faction"]))targets.push_back(u);
 std::sort(targets.begin(),targets.end(),[](const J&a,const J&b){if(a["row"]!=b["row"])return number(a["row"])<number(b["row"]);if(a["column"]!=b["column"])return number(a["column"])<number(b["column"]);return str(a,"id")<str(b,"id");});
 std::vector<std::string> out;for(const auto& u:targets)if(policy!="frontEnemy"||u["row"]==targets.front()["row"])out.push_back(str(u,"id"));return out;
}
J& tacticsUnit(J& s,const std::string& id){for(auto& u:tacticsState(s)["active"]["units"])if(u["id"]==id)return u;throw Fault("TACTICS_UNIT","전투원이 없습니다.","/systems/tactics");}
void tacticsApply(const J& c,J& s,J& actor,const J& skill,const std::string& targetId){
 const auto& d=tacticsConfig(c);auto targets=tacticsTargets(c,s,actor,skill);bool chosen=false;
 auto modified=[&](const J& u,const std::string& key){int64_t value=number(u["stats"][key]);for(const auto& x:u["statuses"])value+=number((*find(d["statuses"],x["id"]))[key]);return std::max<int64_t>(0,value);};
 for(const auto& id:targets){if(str(skill,"target").rfind("all",0)!=0&&id!=targetId)continue;chosen=true;auto& target=tacticsUnit(s,id);
  if(sample(s["rng"],100)>=number(skill["accuracy"])){tacticsLog(s,str(actor,"id")+" "+str(skill,"id")+" "+id+" miss");continue;}
  auto kind=str(skill,"kind");int64_t amount=kind=="damage"?std::max<int64_t>(1,number(skill["power"])+modified(actor,"attack")-modified(target,"defense")):kind=="heal"?number(skill["power"]):0;
  target["hp"]=std::clamp<int64_t>(number(target["hp"])+(kind=="heal"?amount:-amount),0,number(target["stats"]["maxHp"]));
  if(skill.contains("statusId")&&number(target["hp"])>0){J entries=J::array();for(const auto& x:target["statuses"])if(x["id"]!=skill["statusId"])entries.push_back(x);entries.push_back({{"id",skill["statusId"]},{"remaining",(*find(d["statuses"],skill["statusId"]))["turns"]}});target["statuses"]=entries;}
  tacticsLog(s,str(actor,"id")+" "+str(skill,"id")+" "+id+" "+std::to_string(amount));
 }
 if(!chosen)tacticsLog(s,str(actor,"id")+" "+str(skill,"id")+" target-lost");actor["cooldowns"][str(skill,"id")]=number(skill["cooldown"])+1;
}
void tacticsWave(const J& c,J& s){auto& a=tacticsState(s)["active"];const auto& e=*find(tacticsConfig(c)["encounters"],a["encounterId"]);J units=J::array();for(const auto& u:a["units"])if(u["control"]=="player")units.push_back(u);const int wave=number(a["wave"]);for(const auto& id:e["waves"][wave]["unitIds"])units.push_back(tacticsFighter(c,s,id,"wave-"+std::to_string(wave)+"-"+id.get<std::string>()));a["units"]=units;
 std::vector<J> order;for(const auto& u:units)order.push_back(u);std::sort(order.begin(),order.end(),[](const J&a,const J&b){for(auto k:{"speed"})if(a["stats"][k]!=b["stats"][k])return number(a["stats"][k])>number(b["stats"][k]);if(a["row"]!=b["row"])return number(a["row"])<number(b["row"]);if(a["column"]!=b["column"])return number(a["column"])<number(b["column"]);return str(a,"id")<str(b,"id");});a["order"]=J::array();for(const auto& u:order)a["order"].push_back(u["id"]);a["cursor"]=0;tacticsLog(s,"wave "+std::to_string(wave+1));
}
void tacticsFinish(const J& c,J& s,const std::string& outcome){auto& t=tacticsState(s);auto a=t["active"];const auto& d=tacticsConfig(c);const auto& e=*find(d["encounters"],a["encounterId"]);t["last"]={{"encounterId",a["encounterId"]},{"outcome",outcome},{"turn",a["turn"]},{"log",a["log"]},{"experience",outcome=="victory"?e["experience"]:J(0)}};t["active"]=nullptr;
 if(outcome=="victory"){
  for(const auto& unit:e["party"]){auto id=unit.get<std::string>();if(!t["growth"].contains(id))t["growth"][id]={{"experience",0},{"level",1}};auto& g=t["growth"][id];g["experience"]=number(g["experience"])+number(e["experience"]);g["level"]=std::min(number(d["growth"]["maxLevel"]),1+number(g["experience"])/number(d["growth"]["experiencePerLevel"]));}
  systemsReward(c,s,e["rewards"],"/systems/tactics/"+str(e,"id")+"/rewards",true,nullptr);auto& trip=s["systems"]["expedition"];if(!contains(trip["clearedNodes"],trip["nodeId"]))trip["clearedNodes"].push_back(trip["nodeId"]);s["phase"]="expedition";
  for(const auto& q:c["project"]["systems"]["quests"]){auto id=str(q,"id");if(q.value("encounterId","")==str(e,"id")&&s["systems"]["quests"].contains(id)&&s["systems"]["quests"][id]["status"]=="accepted"){auto& progress=s["systems"]["quests"][id];progress["progress"]=std::min(number(q["targetCount"]),number(progress["progress"])+1);if(progress["progress"]==q["targetCount"])progress["status"]="completed";}}
 }else finishExpedition(s,outcome=="defeat"?"defeated":"retreated");
}
void tacticsAdvance(const J& c,J& s){for(int safety=0;safety<512;safety++){
 auto& a=tacticsState(s)["active"];if(a.is_null())return;bool players=false,enemies=false;for(const auto& u:a["units"])if(number(u["hp"])>0){if(u["control"]=="player")players=true;else enemies=true;}
 if(!players){tacticsFinish(c,s,"defeat");return;}if(!enemies){const auto& e=*find(tacticsConfig(c)["encounters"],a["encounterId"]);if(number(a["wave"])+1==int64_t(e["waves"].size())){tacticsFinish(c,s,"victory");return;}a["wave"]=number(a["wave"])+1;tacticsWave(c,s);}
 auto& actor=tacticsUnit(s,a["order"][number(a["cursor"])].get<std::string>());a["turn"]=number(a["turn"])+1;auto next=[&]{a["cursor"]=(number(a["cursor"])+1)%a["order"].size();};if(number(actor["hp"])<=0){next();continue;}
 bool stunned=false;J remaining=J::array();for(auto entry:actor["statuses"]){const auto& d=*find(tacticsConfig(c)["statuses"],entry["id"]);actor["hp"]=std::clamp<int64_t>(number(actor["hp"])-number(d["damage"])+number(d["heal"]),0,number(actor["stats"]["maxHp"]));stunned|=d["stun"].get<bool>();entry["remaining"]=number(entry["remaining"])-1;if(number(entry["remaining"])>0)remaining.push_back(entry);}actor["statuses"]=remaining;for(auto& v:actor["cooldowns"])v=std::max<int64_t>(0,number(v)-1);
 if(number(actor["hp"])<=0||stunned){tacticsLog(s,str(actor,"id")+(number(actor["hp"])<=0?" down":" stunned"));next();continue;}
 if(!actor["casting"].is_null()){auto& cast=actor["casting"];cast["remaining"]=number(cast["remaining"])-1;if(number(cast["remaining"])<=0){const auto copy=cast;cast=nullptr;tacticsApply(c,s,actor,*find(tacticsConfig(c)["skills"],copy["skillId"]),str(copy,"targetId"));}next();continue;}
 if(actor["control"]=="player")return;
 const auto& unit=*find(tacticsConfig(c)["units"],actor["unitId"]);for(const auto& id:unit["skillIds"]){const auto& skill=*find(tacticsConfig(c)["skills"],id);auto targets=tacticsTargets(c,s,actor,skill);if(actor["cooldowns"].value(id.get<std::string>(),int64_t(0))==0&&!targets.empty()){if(number(skill["castTurns"])>0)actor["casting"]={{"skillId",id},{"targetId",targets[0]},{"remaining",skill["castTurns"]}};else tacticsApply(c,s,actor,skill,targets[0]);break;}}next();
 }need(false,"TACTICS_TURN_LIMIT","자동 진행 한도를 초과했습니다.","/systems/tactics");}
void startTactics(const J& c,J& s,const std::string& id){const auto& d=tacticsConfig(c);auto e=find(d["encounters"],id);need(e,"UNKNOWN_ENCOUNTER","전투 구성이 없습니다.","/systems/tactics");auto& t=tacticsState(s);t["last"]=nullptr;t["active"]={{"encounterId",id},{"wave",0},{"turn",0},{"cursor",0},{"order",J::array()},{"units",J::array()},{"log",J::array()}};for(const auto& unit:(*e)["party"])t["active"]["units"].push_back(tacticsFighter(c,s,unit,unit));tacticsWave(c,s);s["phase"]="battle";tacticsAdvance(c,s);}
void tacticsCommand(const J& c,J& s,const J& cmd){need(c["project"]["systems"].contains("tactics"),"TACTICS_UNAVAILABLE","다인 전투 규격이 없습니다.","/systems/tactics");const auto& d=tacticsConfig(c);auto& t=tacticsState(s);auto type=str(cmd,"type");
 if(type=="tacticsUnequip"){need(s["phase"]=="planning"||s["phase"]=="ready","WRONG_PHASE","전투 준비 중에만 장비를 변경할 수 있습니다.","/phase");auto id=str(cmd,"unitId"),slot=str(cmd,"slot");need(t["equipment"].contains(id)&&t["equipment"][id].contains(slot),"SLOT_EMPTY","장착한 장비가 없습니다.","/command/slot");t["equipment"][id].erase(slot);return;}
 if(type=="tacticsEquip"){need(s["phase"]=="planning"||s["phase"]=="ready","WRONG_PHASE","전투 준비 중에만 장비를 변경할 수 있습니다.","/phase");auto u=find(d["units"],cmd["unitId"]),e=find(c["project"]["systems"]["equipment"],cmd["equipmentId"]);need(u&&e&&(*u)["control"]=="player","UNKNOWN_EQUIPMENT","전투원 또는 장비가 없습니다.","/command");auto item=str(*e,"itemId");need(s["gameplay"]["inventory"].value(item,int64_t(0))>equipmentReserved(c,s,item),"INSUFFICIENT_ITEMS","장착 가능한 물품이 없습니다.","/command/equipmentId");t["equipment"][str(*u,"id")][str(*e,"slot")]=(*e)["id"];return;}
 auto& a=t["active"];need(!a.is_null()&&s["phase"]=="battle","WRONG_PHASE","진행 중인 다인 전투가 없습니다.","/phase");if(type=="tacticsFlee"){tacticsFinish(c,s,"fled");return;}
 auto& actor=tacticsUnit(s,a["order"][number(a["cursor"])].get<std::string>());const auto& unit=*find(d["units"],actor["unitId"]);auto skill=find(d["skills"],cmd["skillId"]);need(actor["id"]==cmd["unitId"]&&actor["control"]=="player"&&number(actor["hp"])>0,"TACTICS_TURN","현재 차례의 전투원을 선택하세요.","/command/unitId");need(skill&&contains(unit["skillIds"],(*skill)["id"])&&actor["cooldowns"].value(str(*skill,"id"),int64_t(0))==0&&actor["casting"].is_null(),"TACTICS_SKILL","사용할 수 없는 스킬입니다.","/command/skillId");auto targets=tacticsTargets(c,s,actor,*skill);need(std::find(targets.begin(),targets.end(),str(cmd,"targetId"))!=targets.end(),"TACTICS_TARGET","진영·배치·생존 조건에 맞는 대상을 선택하세요.","/command/targetId");
 if(number((*skill)["castTurns"])>0){actor["casting"]={{"skillId",(*skill)["id"]},{"targetId",cmd["targetId"]},{"remaining",(*skill)["castTurns"]}};tacticsLog(s,str(actor,"id")+" cast "+str(*skill,"id"));}else tacticsApply(c,s,actor,*skill,str(cmd,"targetId"));a["cursor"]=(number(a["cursor"])+1)%a["order"].size();tacticsAdvance(c,s);
