void StudioTests::reusableActivitiesAuthoring(){
  if(!qEnvironmentVariableIsSet("RAISING_QT_REUSABLE_ACTIVITIES"))QSKIP("Requires an isolated conditional-routing authoring project.");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_QT_PROJECT");
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
  auto settle=[&]{QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QTest::qWait(120);QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));};
  auto screenIds=[&]{QStringList out;for(auto s:w.projectData().value("visual").toObject().value("screens").toArray())out<<s.toObject().value("id").toString();return out;};const auto screensBefore=screenIds();
  w.findChild<QAction*>("showAuthoringWorkspace")->trigger();settle();auto dock=w.findChild<QDockWidget*>("authoringWorkspaceDock");QVERIFY(dock);
  auto selected=[&]{return dock->findChild<QTreeWidget*>("workspaceEntities")->currentItem()->data(0,Qt::UserRole).toJsonObject();};
  auto apply=[&]{dock->findChild<QPushButton*>("workspaceApply")->click();settle();};
  auto label=[&](QString text){auto e=dock->findChild<QLineEdit*>("workspaceField-label");QVERIFY(e);e->setText(text);QMetaObject::invokeMethod(e,"textEdited",Q_ARG(QString,text));};
  auto editLogic=[&](QString button,std::function<void(LogicEditor&)> edit){QTimer::singleShot(30,&w,[&]{auto d=static_cast<LogicEditor*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);edit(*d);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});dock->findChild<QPushButton*>(button)->click();};
  auto cost=[&](QString attribute,int amount){dock->findChild<QPushButton*>("workspaceAddCost")->click();auto t=dock->findChild<QTableWidget*>("workspaceCosts");const auto row=t->rowCount()-1;auto c=qobject_cast<QComboBox*>(t->cellWidget(row,0));c->setCurrentIndex(c->findData(attribute));qobject_cast<QSpinBox*>(t->cellWidget(row,1))->setValue(amount);};
  auto effect=[&](QString attribute,int amount,bool readSelf){editLogic("workspaceLogic-baseEffects",[&](LogicEditor& e){QVERIFY(logicTestSelect(e,{}));e.findChild<QPushButton*>("logicAdd")->click();const auto n=QString::number(e.value().toArray().size()-1);QVERIFY(logicTestSelect(e,{n}));QVERIFY(logicTestChoose(e,"logicType","add"));QVERIFY(logicTestSelect(e,{n,"target"}));QVERIFY(logicTestChoose(e,"logicType","attribute"));QVERIFY(logicTestChoose(e,"logic-attributeId",attribute));QVERIFY(logicTestSelect(e,{n,"value"}));if(readSelf){QVERIFY(logicTestChoose(e,"logicType","read"));QVERIFY(logicTestSelect(e,{n,"value","target"}));QVERIFY(logicTestChoose(e,"logicType","attribute"));QVERIFY(logicTestChoose(e,"logic-attributeId",attribute));}else QVERIFY(logicTestNumber(e,"value",amount));});};
  auto createActivity=[&](QString name){auto c=dock->findChild<QComboBox*>("workspaceAddKind");c->setCurrentIndex(c->findData("activity"));QTimer::singleShot(30,&w,[=]{auto d=qobject_cast<QInputDialog*>(QApplication::activeModalWidget());QVERIFY(d);d->setTextValue(name);QTest::keyClick(d->findChild<QLineEdit*>(),Qt::Key_Return);});dock->findChild<QPushButton*>("workspaceAdd")->click();settle();};
  createActivity("수련");const auto training=selected().value("id").toString();cost("money",1);effect("skill",0,true);apply();
  createActivity("연회");const auto banquet=selected().value("id").toString();cost("money",2);effect("stamina",5,false);apply();
  const auto flow=w.projectData().value("authoring").toObject().value("storyFlows").toArray().first().toObject();const auto infiltration=flow.value("activityId").toString();
  selectWorkspaceItem(dock,"activity:"+infiltration);label("잠입");cost("stamina",3);effect("skill",2,false);apply();
  const auto activity=contentDocument(w,"activities/"+infiltration+".json");const auto flag=activity.value("baseEffects").toArray().first().toObject().value("flagId").toString();QVERIFY(!flag.isEmpty());
  const auto meeting=flow.value("id").toString()+"-meeting";
  selectWorkspaceItem(dock,"event:"+meeting);label("잠입 중 만난 동료");editLogic("workspaceLogic-requirements",[&](LogicEditor& e){QVERIFY(logicTestChoose(e,"logicType","flag"));QVERIFY(logicTestChoose(e,"logic-flagId",flag));});apply();
  // Route every phase through the existing canvas; no screen is created or copied.
  selectWorkspaceItem(dock,"screenRouting:routing");dock->findChild<QPushButton*>("workspaceRouting")->click();auto routing=w.findChild<QDialog*>("screenRoutingDialog");QVERIFY(routing);
  auto rules=routing->findChild<QListWidget*>("routingConditions");while(rules->count()){rules->setCurrentRow(0);routing->findChild<QPushButton*>("routeRemove")->click();}
  auto target=routing->findChild<QComboBox*>("routingDefault");target->setCurrentIndex(target->findData("screen-1"));routing->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Ok)->click();settle();
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("rosterAuthoringDialog");QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);auto locals=d->findChild<QListWidget*>("rosterLocalAttributes");for(int i=0;i<locals->count();++i)locals->item(i)->setCheckState(locals->item(i)->data(Qt::UserRole)=="money"?Qt::Unchecked:Qt::Checked);auto table=d->findChild<QTableWidget*>("rosterMembers");d->findChild<QPushButton*>("rosterAddMember")->click();QCOMPARE(table->rowCount(),2);table->item(0,1)->setText("소운");table->item(1,1)->setText("연화");for(int row=0;row<2;++row){auto a=qobject_cast<QComboBox*>(table->cellWidget(row,2));a->setCurrentIndex(a->findData(training));for(int col=3;col<table->columnCount();++col){auto title=table->horizontalHeaderItem(col)->text();auto spin=qobject_cast<QSpinBox*>(table->cellWidget(row,col));if(title=="검술")spin->setValue(row==0?10:40);if(title=="체력")spin->setValue(row==0?60:80);}}d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editRoster")->trigger();settle();
  // Rewrite the encounter through the script editor, retaining both branches.
  QTimer::singleShot(30,&w,[&]{auto d=static_cast<ScriptAuthoringDialog*>(w.findChild<QDialog*>("scriptAuthoringDialog"));QVERIFY(d);QTimer::singleShot(20000,d,&QDialog::reject);auto picker=d->findChild<QComboBox*>("scriptDocument");for(int i=0;i<picker->count();++i)if(picker->itemText(i).contains(meeting+".json"))picker->setCurrentIndex(i);scriptSelectNode(*d,"greeting");d->findChild<QPlainTextEdit*>("script-text")->setPlainText("밀서를 찾았지만 경비가 다가온다. 함께 빠져나갈까?");scriptSelectNode(*d,"question");d->findChild<QPlainTextEdit*>("script-prompt")->setPlainText("동료와 함께할 것인가?");auto choices=d->findChild<QTableWidget*>("scriptChoices");choices->item(0,1)->setText("동료와 함께 탈출한다");choices->item(1,1)->setText("혼자 빠져나온다");scriptSelectNode(*d,"choice-1-reply");d->findChild<QPlainTextEdit*>("script-text")->setPlainText("네가 등을 맡아줘서 무사히 나왔어. 연회에서 다시 만나자.");d->findChild<QDialogButtonBox*>("scriptButtons")->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("scriptAuthoringAction")->trigger();settle();
  auto openCanvas=[&]{auto list=w.findChild<QListWidget*>("projectList");for(int i=0;i<list->count();++i)if(list->item(i)->data(Qt::UserRole)=="screen-1"){list->setCurrentRow(i);list->setFocus();QTest::keyClick(list,Qt::Key_Return);break;}settle();};openCanvas();
  // Clear obsolete demonstration captions through the workspace, then keep
  // the reusable cards above the schedule/result/dialogue content areas.
  for(const auto& id:QStringList{"text-4","text-5"}){selectWorkspaceItem(dock,"screenElement:screen-1/"+id);QTimer::singleShot(30,&w,[&]{auto question=qobject_cast<QMessageBox*>(QApplication::activeModalWidget());QVERIFY(question);question->button(QMessageBox::Yes)->click();});dock->findChild<QPushButton*>("workspaceDelete")->click();settle();}
  selectWorkspaceItem(dock,"screenElement:screen-1/text-2");dock->findChild<QPushButton*>("workspaceCanvas")->click();settle();auto relationY=w.findChild<QSpinBox*>("elementY");relationY->setValue(130);QMetaObject::invokeMethod(relationY,"editingFinished");settle();
  // One component definition, two instances, three activity-filtered variants.
  QString component,child;
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("componentsDialog");QVERIFY(d);QTimer::singleShot(30000,d,&QDialog::reject);auto type=d->findChild<QComboBox*>("componentTemplate");type->setCurrentIndex(type->findData("empty"));d->findChild<QPushButton*>("addComponent")->click();d->findChild<QLineEdit*>("componentName")->setText("활동 안내 카드");d->findChild<QSpinBox*>("componentWidth")->setValue(540);d->findChild<QSpinBox*>("componentHeight")->setValue(50);d->findChild<QPushButton*>("addComponentChild")->click();d->findChild<QLineEdit*>("child-label")->setText("활동 안내");d->findChild<QLineEdit*>("child-text")->setText("다음 활동을 선택하세요");d->findChild<QSpinBox*>("child-width")->setValue(530);d->findChild<QSpinBox*>("child-height")->setValue(40);d->findChild<QSpinBox*>("child-fontSize")->setValue(24);d->findChild<QPushButton*>("applyComponentChild")->click();
    d->findChild<QPushButton*>("componentPresentation")->click();auto outer=d->findChild<QDialog*>("presentationVariantsDialog");QVERIFY(outer);
    for(const auto &pair:QList<QPair<QString,QString>>{{training,"수련 · 자신만의 내공을 쌓는다"},{infiltration,"잠입 · 경비의 빈틈을 살핀다"},{banquet,"연회 · 지친 몸과 마음을 달랜다"}}){outer->findChild<QPushButton*>("variantAdd")->click();auto edit=outer->findChild<QDialog*>("presentationVariantEdit");edit->findChild<QLineEdit*>("variantName")->setText(pair.second);auto a=edit->findChild<QComboBox*>("variantActivity");QVERIFY(a->findData(pair.first)>0);a->setCurrentIndex(a->findData(pair.first));QVERIFY(!a->currentText().isEmpty());auto p=edit->findChild<QComboBox*>("variantProperty");p->setCurrentIndex(p->findData("text"));edit->findChild<QLineEdit*>("variantValue")->setText(pair.second);edit->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Ok)->click();QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);}
    outer->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);d->grab().save(engine+"/.cache/reusable-activities/component.png");d->findChild<QPushButton*>("placeComponent")->click();});w.findChild<QAction*>("editComponents")->trigger();settle();
  const auto first=w.selectedId();const auto definition=w.projectData().value("visual").toObject().value("components").toArray().last().toObject();component=definition.value("id").toString();child=definition.value("elements").toArray().first().toObject().value("id").toString();QCOMPARE(definition.value("elements").toArray().first().toObject().value("variants").toArray().size(),3);
  auto geometry=[&](int x,int y){for(auto pair:QList<QPair<const char*,int>>{{"elementX",x},{"elementY",y}}){auto f=w.findChild<QSpinBox*>(pair.first);f->setValue(pair.second);QMetaObject::invokeMethod(f,"editingFinished");settle();}};geometry(40,75);
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("componentsDialog");QVERIFY(d);auto library=d->findChild<QListWidget*>("componentLibrary");library->setCurrentRow(library->count()-1);d->findChild<QPushButton*>("placeComponent")->click();});w.findChild<QAction*>("editComponents")->trigger();settle();const auto second=w.selectedId();geometry(660,75);
  // Change the definition once after both instances exist. Cancelled edits leave it intact.
  auto editDefinition=[&](bool accept){QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("componentsDialog");QVERIFY(d);auto library=d->findChild<QListWidget*>("componentLibrary");library->setCurrentRow(library->count()-1);d->findChild<QListWidget*>("componentChildren")->setCurrentRow(0);d->findChild<QLineEdit*>("child-text")->setText(accept?"함께 성장할 다음 활동을 선택하세요":"취소할 문구");d->findChild<QDialogButtonBox*>()->button(accept?QDialogButtonBox::Save:QDialogButtonBox::Cancel)->click();});w.findChild<QAction*>("editComponents")->trigger();settle();};editDefinition(true);const auto after=w.projectData();editDefinition(false);QCOMPARE(w.projectData(),after);
  QCOMPARE(screenIds(),screensBefore);QVERIFY(w.projectData().value("visual").toObject().value("routing").toObject().value("conditions").toArray().isEmpty());
  w.findChild<QAction*>("saveProject")->trigger();settle();w.openProject(root);settle();QCOMPARE(w.projectData(),after);
  QFile info(engine+"/.cache/reusable-activities/authoring.json");QVERIFY(info.open(QIODevice::WriteOnly));info.write(QJsonDocument(QJsonObject{{"root",root},{"training",training},{"infiltration",infiltration},{"banquet",banquet},{"component",component},{"child",child},{"instances",QJsonArray{first,second}},{"meeting",meeting},{"screen","screen-1"},{"screensBefore",QJsonArray::fromStringList(screensBefore)}}).toJson());info.close();
  QFile steps(engine+"/.cache/reusable-activities/smoke.json");QVERIFY(steps.open(QIODevice::WriteOnly));steps.write("[{\"checkpoint\":\"authored\"}]");steps.close();w.playAutomation=steps.fileName();w.playReport=engine+"/.cache/reusable-activities/smoke-report.json";QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,30000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
}
