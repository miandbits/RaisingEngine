void StudioTests::timeSessionAuthoringRoundtrip(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile input(engine+"/.cache/character-state-authoring-proof.json");QVERIFY(input.open(QIODevice::ReadOnly));const auto root=QJsonDocument::fromJson(input.readAll()).object().value("project").toString();
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);QVERIFY(w.projectData().value("progression").isUndefined());
  const auto evidence=engine+"/docs/evidence/time-sessions";QDir().mkpath(evidence);
  bool filled=false;QTimer poll;poll.setInterval(30);connect(&poll,&QTimer::timeout,&w,[&]{auto d=w.findChild<QDialog*>("contentEditor");if(!d||filled)return;filled=true;poll.stop();d->findChild<QLineEdit*>("contentLabel")->setText(QString::fromUtf8("두 시간 뒤의 방문"));auto scope=d->findChild<QComboBox*>("content-eventScope");scope->setCurrentIndex(scope->findData("shared"));auto trigger=d->findChild<QComboBox*>("content-eventTrigger");trigger->setCurrentIndex(trigger->findData("interaction"));d->findChild<QSpinBox*>("content-throughPeriod")->setValue(35);auto lines=d->findChild<QTableWidget*>("dialogueTable");QVERIFY(lines->rowCount()>0);lines->item(0,1)->setText(QString::fromUtf8("약속한 시간이 되었네요. 이야기한 뒤 하던 행동을 이어가세요."));d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});poll.start();
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QInputDialog*>();QVERIFY(d);d->setTextValue("time-visit");d->accept();});w.findChild<QAction*>("createContent-event")->trigger();QTRY_VERIFY_WITH_TIMEOUT(filled&&!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  QTimer::singleShot(50,&w,[&]{auto d=w.findChild<QDialog*>("timeSessionsDialog");QVERIFY(d);d->findChild<QLineEdit*>("timeUnit")->setText(QString::fromUtf8("시간"));d->findChild<QSpinBox*>("timeApMax")->setValue(6);d->findChild<QSpinBox*>("timeApInitial")->setValue(4);d->findChild<QSpinBox*>("timeApRecovery")->setValue(1);auto actions=d->findChild<QTableWidget*>("timedActions");QCOMPARE(actions->rowCount(),2);for(int i=0;i<2;i++){qobject_cast<QCheckBox*>(actions->cellWidget(i,0))->setChecked(true);qobject_cast<QSpinBox*>(actions->cellWidget(i,2))->setValue(i==0?5:4);qobject_cast<QSpinBox*>(actions->cellWidget(i,3))->setValue(i==0?3:2);}d->findChild<QPushButton*>("addTimeAppointment")->click();auto table=d->findChild<QTableWidget*>("timeAppointments");table->item(0,0)->setText("visit-after-two");auto event=qobject_cast<QComboBox*>(table->cellWidget(0,1));event->setCurrentIndex(event->findData("time-visit"));qobject_cast<QSpinBox*>(table->cellWidget(0,2))->setValue(2);d->grab().save(evidence+"/time-authoring.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  w.findChild<QAction*>("editTimeSessions")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));const auto authored=w.projectData().value("progression");QVERIFY(authored.isObject());
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(w.projectData().value("progression").isUndefined());w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData().value("progression"),authored);
  {QFile debug(engine+"/.cache/stage3-authoring-view.json");if(debug.open(QIODevice::WriteOnly))debug.write(QJsonDocument(w.currentView()).toJson());}
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),authored);
  QTimer::singleShot(50,&w,[&]{auto d=w.findChild<QDialog*>("timeSessionsDialog");QVERIFY(d);QCOMPARE(d->findChild<QTableWidget*>("timeAppointments")->rowCount(),1);QCOMPARE(d->findChild<QSpinBox*>("timeApInitial")->value(),4);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editTimeSessions")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),authored);w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);
  QFile proof(engine+"/.cache/time-session-authoring-proof.json");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(QJsonDocument(QJsonObject{{"project",root},{"guiCreated",true},{"undoRedo",true},{"saveReopen",true}}).toJson());
}
void StudioTests::timeSessionPlayIntegration(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile proof(engine+"/.cache/time-session-authoring-proof.json");QVERIFY(proof.open(QIODevice::ReadOnly));const auto root=QJsonDocument::fromJson(proof.readAll()).object().value("project").toString();
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);w.playAutomation=engine+"/docs/evidence/time-sessions/play-steps.json";w.playReport=engine+"/docs/evidence/time-sessions/editor-play-report.json";QVERIFY(QFileInfo::exists(w.playAutomation));QFile::remove(w.playReport);
  QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,60000);QCOMPARE(finished.first().first().toInt(),0);QFile report(w.playReport);QVERIFY(report.open(QIODevice::ReadOnly));const auto result=QJsonDocument::fromJson(report.readAll()).object();QVERIFY(result.value("ok").toBool());int found=0;for(const auto &v:result.value("steps").toArray())if(v.toObject().value("command").toObject().value("checkpoint")=="complete"){const auto state=v.toObject().value("ui").toObject().value("state").toObject();QCOMPARE(state.value("progression").toObject().value("tick").toInt(),5);QVERIFY(state.value("progression").toObject().value("pending").isNull());found++;}QCOMPARE(found,1);w.grab().save(engine+"/docs/evidence/time-sessions/editor-play.png");
}
