bool prepareTextBindingFixture(const QString &engine,const QString &target,const QJsonObject &connection){
  if(!copyScreenSettingsFixture(engine+"/examples/academy-visual",target))return false;
  QFile file(target+"/project.json");if(!file.open(QIODevice::ReadOnly))return false;auto project=QJsonDocument::fromJson(file.readAll()).object();file.close();
  project["userFields"]=QJsonArray{QJsonObject{{"id","player-name"},{"type","text"},{"label","Name"},{"initial",QString::fromUtf8("미😀")},{"minLength",1},{"maxLength",16}}};
  auto visual=project.value("visual").toObject();auto screens=visual.value("screens").toArray();
  QJsonObject source{{"id","shared-name"},{"kind","text"},{"label","Source"},{"text","SOURCE CONSTANT"},{"x",40},{"y",50},{"width",230},{"height",60},{"fontSize",22},{"color","#112233"}};for(auto it=connection.begin();it!=connection.end();++it)source[it.key()]=it.value();
  for(int i=0;i<screens.size();++i){auto screen=screens[i].toObject();if(screen.value("id")=="title"){auto elements=screen.value("elements").toArray();elements.append(source);screen["elements"]=elements;screens[i]=screen;}}
  QJsonObject targetElement{{"id","shared-name"},{"kind","text"},{"label","Target"},{"text","KEEP TARGET CONSTANT"},{"x",71},{"y",82},{"width",305},{"height",42},{"fontSize",19},{"fill","#123456"},{"color","#abcdef"},{"locked",true},{"hidden",true},{"binding","attribute-value"},{"attributeId","skill"},{"characterId","mentor"},{"relationshipId","trust"},{"valueFormat","Old {label}: {value}"}};
  screens.append(QJsonObject{{"id","binding-a"},{"label","Target A"},{"elements",QJsonArray{targetElement}}});targetElement["text"]="KEEP B";screens.append(QJsonObject{{"id","binding-b"},{"label","Target B"},{"elements",QJsonArray{targetElement}}});
  screens.append(QJsonObject{{"id","binding-panel"},{"label","Not text"},{"elements",QJsonArray{QJsonObject{{"id","shared-name"},{"kind","panel"},{"x",1},{"y",2},{"width",100},{"height",100}}}}});
  visual["screens"]=screens;project["visual"]=visual;if(!file.open(QIODevice::WriteOnly|QIODevice::Truncate))return false;file.write(QJsonDocument(project).toJson());return true;
}
void selectTextBindingSource(StudioWindow &w){selectSettingsScreen(w,"title");QMetaObject::invokeMethod(w.findChild<ScreenCanvas*>("screenCanvas"),"selectionChanged",Q_ARG(QString,QString("shared-name")));}
QJsonObject batchTargetElement(const StudioWindow &w,const QString &screen){return settingsScreen(w,screen).value("elements").toArray().first().toObject();}
QJsonObject withoutTextBinding(QJsonObject element){for(auto key:{"binding","attributeId","characterId","relationshipId","itemId","userFieldId","valueFormat"})element.remove(key);return element;}
}

void StudioTests::textBindingBatchRoundtrip(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QTemporaryDir temp(engine+"/.cache/qt-text-binding-XXXXXX");QVERIFY(temp.isValid());QVERIFY(prepareTextBindingFixture(engine,temp.path(),{{"binding","user-field"},{"userFieldId","player-name"},{"valueFormat",QString::fromUtf8("이름: {value}")}}));
  StudioWindow w(engine);w.show();w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);selectTextBindingSource(w);QCOMPARE(w.selectedId(),QString("shared-name"));const auto before=w.projectData();const int revision=w.currentView().value("revision").toInt();
  QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("textBindingBatchDialog");QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);auto table=d->findChild<QTableWidget*>("textBindingTargets");QCOMPARE(table->rowCount(),2);auto apply=d->findChild<QDialogButtonBox*>("textBindingBatchButtons")->button(QDialogButtonBox::Apply);QVERIFY(!apply->isEnabled());QCOMPARE(table->item(0,0)->checkState(),Qt::Unchecked);QCOMPARE(table->item(0,1)->data(Qt::UserRole).toString(),QString("binding-a"));table->item(0,0)->setCheckState(Qt::Checked);QVERIFY(apply->isEnabled());QVERIFY(d->findChild<QPlainTextEdit*>("textBindingPreview")->toPlainText().contains("KEEP TARGET CONSTANT"));apply->click();});w.findChild<QAction*>("applyTextBindingBatch")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto changed=w.projectData();QCOMPARE(w.currentView().value("revision").toInt(),revision+1);const auto oldA=before.value("visual").toObject().value("screens").toArray().at(4).toObject().value("elements").toArray().first().toObject();auto expectedA=withoutTextBinding(oldA);expectedA["binding"]="user-field";expectedA["userFieldId"]="player-name";expectedA["valueFormat"]=QString::fromUtf8("이름: {value}");QCOMPARE(batchTargetElement(w,"binding-a"),expectedA);
  auto expected=before,visual=expected.value("visual").toObject();auto screens=visual.value("screens").toArray();for(int i=0;i<screens.size();++i){auto screen=screens[i].toObject();if(screen.value("id")=="binding-a"){screen["elements"]=QJsonArray{expectedA};screens[i]=screen;}}visual["screens"]=screens;expected["visual"]=visual;QCOMPARE(changed,expected);
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),before);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),changed);w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),changed);selectTextBindingSource(w);
  const auto noOpRevision=w.currentView().value("revision");QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("textBindingBatchDialog");QVERIFY(d);auto table=d->findChild<QTableWidget*>("textBindingTargets");table->item(0,0)->setCheckState(Qt::Checked);QVERIFY(!d->findChild<QDialogButtonBox*>("textBindingBatchButtons")->button(QDialogButtonBox::Apply)->isEnabled());d->reject();});w.findChild<QAction*>("applyTextBindingBatch")->trigger();QCOMPARE(w.currentView().value("revision"),noOpRevision);
}

void StudioTests::textBindingBatchKindsAndGuards(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());
  const QList<QJsonObject> cases{{{"binding","attribute-value"},{"attributeId","knowledge"},{"valueFormat","{label} = {value}"}},{{"binding","relationship-value"},{"characterId","mentor"},{"relationshipId","trust"}},{{"binding","calendar"}},{{"binding","none"}}};
  for(const auto &connection:cases){QTemporaryDir temp(engine+"/.cache/qt-text-binding-XXXXXX");QVERIFY(temp.isValid());QVERIFY(prepareTextBindingFixture(engine,temp.path(),connection));StudioWindow w(engine);w.show();w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);selectTextBindingSource(w);const auto before=w.projectData(),oldA=batchTargetElement(w,"binding-a"),oldB=batchTargetElement(w,"binding-b");
    QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("textBindingBatchDialog");QVERIFY(d);d->findChild<QPushButton*>("textBindingSelectAll")->click();d->findChild<QPushButton*>("textBindingSelectNone")->click();QVERIFY(!d->findChild<QDialogButtonBox*>("textBindingBatchButtons")->button(QDialogButtonBox::Apply)->isEnabled());d->findChild<QPushButton*>("textBindingSelectAll")->click();d->reject();});w.findChild<QAction*>("applyTextBindingBatch")->trigger();QCOMPARE(w.projectData(),before);
    QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("textBindingBatchDialog");QVERIFY(d);d->findChild<QPushButton*>("textBindingSelectAll")->click();d->findChild<QDialogButtonBox*>("textBindingBatchButtons")->button(QDialogButtonBox::Apply)->click();});w.findChild<QPushButton*>("textBindingBatch")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
    auto expectedA=withoutTextBinding(oldA),expectedB=withoutTextBinding(oldB);for(auto it=connection.begin();it!=connection.end();++it){expectedA[it.key()]=it.value();expectedB[it.key()]=it.value();}QCOMPARE(batchTargetElement(w,"binding-a"),expectedA);QCOMPARE(batchTargetElement(w,"binding-b"),expectedB);w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),before);
    // An independent edit while the modal is open must not be overwritten.
    QJsonObject concurrent;QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("textBindingBatchDialog");QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);d->findChild<QPushButton*>("textBindingSelectAll")->click();auto name=w.findChild<QLineEdit*>("elementName");QVERIFY(name);name->setText("Concurrent label");QMetaObject::invokeMethod(name,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);concurrent=w.projectData();QVERIFY(concurrent!=before);d->findChild<QDialogButtonBox*>("textBindingBatchButtons")->button(QDialogButtonBox::Apply)->click();QVERIFY(d->isVisible());QVERIFY(!d->findChild<QLabel*>("textBindingBatchError")->text().isEmpty());d->reject();});w.findChild<QAction*>("applyTextBindingBatch")->trigger();QCOMPARE(w.projectData(),concurrent);
  }
}
