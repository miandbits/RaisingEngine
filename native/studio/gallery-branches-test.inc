void StudioTests::galleryBranchesAuthoring(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());
  const auto root=engine+"/.cache/gallery-branches-editor-"+QString::number(QDateTime::currentMSecsSinceEpoch());
  const auto evidence=engine+"/.cache/gallery-branches";QDir().mkpath(evidence);
  StudioWindow w(engine);w.resize(1500,960);w.show();
  QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("newProjectDialog");QVERIFY(d);auto mode=d->findChild<QComboBox*>("newProjectTemplate");mode->setCurrentIndex(mode->findData("existing"));d->findChild<QLineEdit*>("newProjectSource")->setText(engine+"/tests/fixtures/projects/last-grandson-polished");d->findChild<QLineEdit*>("newProjectDestination")->setText(root);d->findChild<QDialogButtonBox*>("newProjectButtons")->button(QDialogButtonBox::Ok)->click();});
  w.findChild<QAction*>("newProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),30000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto original=w.projectData();
  QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("projectSettingsDialog");QVERIFY(d);QTimer::singleShot(20000,d,&QDialog::reject);d->resize(1160,900);d->findChild<QTabWidget*>()->setCurrentIndex(2);d->findChild<QPushButton*>("projectGalleryCreateBranches")->click();QVERIFY(!d->findChild<QComboBox*>("projectGalleryBranchScreen")->currentData().toString().isEmpty());d->grab().save(evidence+"/editor-settings.png");d->findChild<QDialogButtonBox*>("projectSettingsButtons")->button(QDialogButtonBox::Ok)->click();});
  w.findChild<QAction*>("projectSettings")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto generated=w.projectData();const auto screenId=generated.value("gallery").toObject().value("branchScreenId").toString();QVERIFY(!screenId.isEmpty());
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),original);
  w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),generated);
  auto list=w.findChild<QListWidget*>("projectList");for(int i=0;i<list->count();++i)if(list->item(i)->data(Qt::UserRole)==screenId){auto item=list->item(i);list->scrollToItem(item);QTest::mouseClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());QTest::mouseDClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());break;}
  auto tree=w.findChild<QTreeWidget*>("hierarchy");QVERIFY(tree);QTreeWidgetItemIterator it(tree);bool selected=false;while(*it){if((*it)->data(0,Qt::UserRole).toString()=="branches"){tree->scrollToItem(*it);QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(*it).center());selected=true;break;}++it;}QVERIFY(selected);
  QTimer::singleShot(100,&w,[&]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QCOMPARE(d->findChild<QComboBox*>("dataUiSource")->currentData().toString(),QString("galleryBranches"));auto fields=d->findChild<QComboBox*>("dataUiFilterField");QVERIFY(fields->findData("locked")>=0);QVERIFY(fields->findData("branchId")>=0);d->findChild<QSpinBox*>("dataUiColumns")->setValue(2);d->grab().save(evidence+"/editor-bindings.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  w.findChild<QAction*>("editDataUi")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  QTimer::singleShot(100,&w,[&]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);auto library=d->findChild<QListWidget*>("componentLibrary");library->setCurrentRow(library->count()-1);auto children=d->findChild<QListWidget*>("componentChildren");children->setCurrentRow(4);QCOMPARE(d->findChild<QComboBox*>("child-action")->currentData().toString(),QString("galleryBranch"));d->findChild<QLineEdit*>("child-text")->setText("이 선택의 기억 보기");d->grab().save(evidence+"/editor-card.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  w.findChild<QAction*>("editComponents")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto authored=w.projectData();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QCOMPARE(w.projectData(),authored);
  w.findChild<QAction*>("validateProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
  QFile proof(evidence+"/editor-project.txt");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(root.toUtf8());
}
