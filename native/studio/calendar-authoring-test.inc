void StudioTests::customCalendarAuthoring(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.show();QTemporaryDir directory(engine+"/.cache/qt-calendar-XXXXXX");QVERIFY(directory.isValid());const auto root=directory.path()+"/game";
 QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("newProjectDialog");if(!d)return;auto mode=d->findChild<QComboBox*>("newProjectTemplate");mode->setCurrentIndex(mode->findData("academy-demo"));d->findChild<QLineEdit*>("newProjectDestination")->setText(root);d->findChild<QDialogButtonBox*>("newProjectButtons")->button(QDialogButtonBox::Ok)->click();});w.findChild<QAction*>("newProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
 bool correct=false;QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("projectSettingsDialog");if(!d)return;d->findChild<QCheckBox*>("projectCustomCalendar")->setChecked(true);d->findChild<QSpinBox*>("projectCalendarUnits")->setValue(13);d->findChild<QSpinBox*>("projectCalendarDays")->setValue(28);d->findChild<QSpinBox*>("projectStartYear")->setValue(1);d->findChild<QSpinBox*>("projectStartMonth")->setValue(1);d->findChild<QSpinBox*>("projectDurationMonths")->setValue(104);d->findChild<QSpinBox*>("projectPeriodsPerMonth")->setValue(4);d->findChild<QLineEdit*>("projectCalendar-monthLabel")->setText("Phase");d->findChild<QLineEdit*>("projectCalendar-periodLabel")->setText("Week");correct=d->findChild<QLabel*>("projectCalendarSummary")->text().contains("Year 8 · Phase 13 · Week 4");d->findChild<QTabWidget*>()->setCurrentIndex(1);d->grab().save(engine+"/.cache/calendar/editor-calendar.png");d->findChild<QDialogButtonBox*>("projectSettingsButtons")->button(QDialogButtonBox::Ok)->click();});w.findChild<QAction*>("projectSettings")->trigger();QVERIFY(correct);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData().value("calendar").toObject().value("monthsPerYear").toInt(),13);
 w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));const auto saved=w.projectData();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),saved);
 bool guarded=false;QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("projectSettingsDialog");if(!d)return;d->findChild<QSpinBox*>("projectStartMonth")->setValue(13);d->findChild<QCheckBox*>("projectCustomCalendar")->setChecked(false);d->findChild<QDialogButtonBox*>("projectSettingsButtons")->button(QDialogButtonBox::Ok)->click();guarded=d->isVisible()&&!d->findChild<QLabel*>("projectSettingsError")->text().isEmpty()&&d->findChild<QSpinBox*>("projectStartMonth")->value()==13;d->reject();});w.findChild<QAction*>("projectSettings")->trigger();QVERIFY(guarded);QCOMPARE(w.projectData(),saved);
}
