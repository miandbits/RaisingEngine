void StudioTests::customStatesAuthoring() {
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),project=qEnvironmentVariable("RAISING_QT_PROJECT");QVERIFY(!project.isEmpty());
  StudioWindow w(engine);w.show();w.openProject(project);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
  auto settle=[&]{QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);};
  auto open=[&]{w.findChild<QAction*>("editCustomStates")->trigger();return w.findChild<QDialog*>("customStatesDialog");};
  auto dialog=open();QVERIFY(dialog);dialog->findChild<QPushButton*>("stateGroupAdd")->click();auto d=dialog->findChild<QDialog*>("stateGroupDialog");QVERIFY(d);
  d->findChild<QLineEdit*>("stateGroupName")->setText("행동 모드");auto table=d->findChild<QTableWidget*>("stateValuesTable");QCOMPARE(table->rowCount(),1);const auto idle=table->item(0,0)->data(Qt::UserRole).toString();
  d->findChild<QPushButton*>("stateValueAdd")->click();table->item(1,0)->setText("수련");const auto training=table->item(1,0)->data(Qt::UserRole).toString();
  d->findChild<QPushButton*>("stateValueAdd")->click();table->item(2,0)->setText("연회");const auto banquet=table->item(2,0)->data(Qt::UserRole).toString();
  d->findChild<QComboBox*>("stateInitialValue")->setCurrentIndex(0);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Ok)->click();
  dialog->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();settle();
  const auto group=w.projectData().value("stateGroups").toArray().first().toObject();const auto gid=group.value("id").toString();QCOMPARE(group.value("initialValueId").toString(),idle);
  // Real content editor + shared visual logic editor: append a state effect to rest.
  QTimer::singleShot(40,&w,[&]{auto c=w.findChild<QDialog*>("contentEditor");QVERIFY(c);QTimer::singleShot(15000,c,&QDialog::reject);
    QTimer::singleShot(20,c,[&]{auto e=static_cast<LogicEditor*>(w.findChild<QDialog*>("logicEditor"));QVERIFY(e);QVERIFY(logicTestSelect(*e,{}));e->findChild<QPushButton*>("logicAdd")->click();const auto n=e->value().toArray().size()-1;QVERIFY(logicTestSelect(*e,{QString::number(n)}));QVERIFY(logicTestChoose(*e,"logicType","setState"));QVERIFY(logicTestChoose(*e,"logic-stateGroupId",gid));QVERIFY(logicTestChoose(*e,"logic-stateValueId",training));e->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
    c->findChild<QPushButton*>("contentLogic-baseEffects")->click();c->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  QVERIFY(openContentDocument(w,"activities/rest.json"));settle();QCOMPARE(contentDocument(w,"activities/rest.json").value("baseEffects").toArray().last().toObject().value("op").toString(),QString("setState"));
  // Event requirements and its selected choice effect use the same named states.
  const auto flow=w.projectData().value("authoring").toObject().value("storyFlows").toArray().first().toObject();
  QString eventFile;for(const auto &v:w.currentView().value("documents").toArray()){auto doc=v.toObject();if(doc.value("kind")=="event"&&doc.value("file").toString().endsWith("-meeting.json"))eventFile=doc.value("file").toString();}QVERIFY(!eventFile.isEmpty());
  QTimer::singleShot(40,&w,[&]{auto author=static_cast<ScriptAuthoringDialog*>(w.findChild<QDialog*>("scriptAuthoringDialog"));QVERIFY(author);QTimer::singleShot(20000,author,&QDialog::reject);
    auto picker=author->findChild<QComboBox*>("scriptDocument");bool selected=false;for(int i=0;i<picker->count();++i)if(picker->itemText(i).contains(eventFile)){picker->setCurrentIndex(i);selected=true;break;}QVERIFY(selected);
    QTimer::singleShot(20,author,[&]{auto e=static_cast<LogicEditor*>(w.findChild<QDialog*>("logicEditor"));QVERIFY(e);QVERIFY(logicTestSelect(*e,{}));QVERIFY(logicTestChoose(*e,"logicType","stateIs"));QVERIFY(logicTestChoose(*e,"logic-stateGroupId",gid));QVERIFY(logicTestChoose(*e,"logic-stateValueId",training));e->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
    author->findChild<QPushButton*>("scriptRequirements")->click();scriptSelectNode(*author,"choice-1-effect");
    QTimer::singleShot(20,author,[&]{auto e=static_cast<LogicEditor*>(w.findChild<QDialog*>("logicEditor"));QVERIFY(e);QVERIFY(logicTestSelect(*e,{}));e->findChild<QPushButton*>("logicAdd")->click();QVERIFY(logicTestSelect(*e,{QString::number(e->value().toArray().size()-1)}));QVERIFY(logicTestChoose(*e,"logicType","setState"));QVERIFY(logicTestChoose(*e,"logic-stateValueId",banquet));e->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
    author->findChild<QPushButton*>("script-effects")->click();author->findChild<QDialogButtonBox*>("scriptButtons")->button(QDialogButtonBox::Save)->click();});
  w.findChild<QAction*>("scriptAuthoringAction")->trigger();settle();QCOMPARE(contentDocument(w,eventFile).value("requirements").toObject().value("op").toString(),QString("stateIs"));
  // One canvas, state-driven presentation. No screen duplication or external JSON writes.
  auto list=w.findChild<QListWidget*>("projectList");bool found=false;for(int i=0;i<list->count();++i)if(list->item(i)->data(Qt::UserRole)=="screen-1"){list->setCurrentRow(i);list->setFocus();QTest::keyClick(list,Qt::Key_Return);found=true;break;}QVERIFY(found);
  auto palette=w.findChild<QToolButton*>("elementPalette");for(auto a:palette->menu()->actions())if(a->text()=="텍스트"){a->trigger();break;}settle();const auto elementId=w.selectedId();
  for(auto pair:QList<QPair<const char*,int>>{{"elementX",400},{"elementY",155},{"elementWidth",500},{"elementHeight",50}}){auto field=w.findChild<QSpinBox*>(pair.first);field->setValue(pair.second);QMetaObject::invokeMethod(field,"editingFinished");settle();}
  auto field=w.findChild<QLineEdit*>("buttonText");field->setText("평상시 · 다음 행동을 고른다");QMetaObject::invokeMethod(field,"editingFinished");settle();
  for(const auto &pair:QList<QPair<QString,QString>>{{training,"수련 · 기운을 가다듬는다"},{banquet,"연회 · 인연을 쌓는다"}}){
    w.findChild<QPushButton*>("presentationVariants")->click();auto outer=w.findChild<QDialog*>("presentationVariantsDialog");outer->findChild<QPushButton*>("variantAdd")->click();auto edit=outer->findChild<QDialog*>("presentationVariantEdit");edit->findChild<QLineEdit*>("variantName")->setText(pair.second);auto property=edit->findChild<QComboBox*>("variantProperty");property->setCurrentIndex(property->findData("text"));edit->findChild<QLineEdit*>("variantValue")->setText(pair.second);edit->findChild<QPushButton*>("variantCondition")->click();auto e=static_cast<LogicEditor*>(edit->findChild<QDialog*>("logicEditor"));QVERIFY(e);QVERIFY(logicTestChoose(*e,"logicType","stateIs"));QVERIFY(logicTestChoose(*e,"logic-stateValueId",pair.first));e->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();edit->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Ok)->click();QVERIFY(!edit->isVisible());outer->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();settle();
  }
  {QJsonObject element;for(const auto &screen:w.projectData().value("visual").toObject().value("screens").toArray())for(const auto &v:screen.toObject().value("elements").toArray())if(v.toObject().value("id")==elementId)element=v.toObject();const auto variants=element.value("variants").toArray();QCOMPARE(variants.size(),2);QCOMPARE(variants[0].toObject().value("when").toObject().value("op").toString(),QString("stateIs"));QCOMPARE(variants[0].toObject().value("values").toObject().value("text").toString(),QString("수련 · 기운을 가다듬는다"));}
  // References prevent destructive deletion. Cancel preserves the existing group.
  dialog=open();dialog->findChild<QPushButton*>("stateGroupRemove")->click();dialog->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();QVERIFY(dialog->isVisible());QVERIFY(!dialog->findChild<QLabel*>("customStatesError")->text().isEmpty());dialog->reject();settle();QCOMPARE(w.projectData().value("stateGroups").toArray().size(),1);
  {QFile debug(QDir(engine).filePath(".cache/custom-states/authored-draft.json"));QVERIFY(debug.open(QIODevice::WriteOnly));debug.write(QJsonDocument(w.currentView()).toJson());}
  w.findChild<QAction*>("saveProject")->trigger();settle();QVERIFY(!w.currentView().value("dirty").toBool());w.openProject(project);settle();QCOMPARE(w.projectData().value("stateGroups").toArray().first().toObject(),group);
  QFile info(QDir(engine).filePath(".cache/custom-states/authoring.json"));QVERIFY(info.open(QIODevice::WriteOnly));info.write(QJsonDocument(QJsonObject{{"project",project},{"elementId",elementId},{"groupId",gid},{"idle",idle},{"training",training},{"banquet",banquet},{"eventFile",eventFile}}).toJson());info.close();
  QVERIFY(w.grab().save(QDir(engine).filePath(".cache/custom-states/authoring.png")));
}
