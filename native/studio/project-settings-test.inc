#include <QTemporaryDir>
void StudioTests::projectSetupAuthoring(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.show();
  QTemporaryDir directory(engine+"/.cache/qt-project-setup-XXXXXX");QVERIFY(directory.isValid());const auto root=directory.path()+"/created";
  bool created=false;QTimer::singleShot(100,&w,[&]{auto dialog=w.findChild<QDialog*>("newProjectDialog");if(!dialog)return;auto mode=dialog->findChild<QComboBox*>("newProjectTemplate");mode->setCurrentIndex(mode->findData("academy-demo"));dialog->findChild<QLineEdit*>("newProjectDestination")->setText(root);created=true;dialog->findChild<QDialogButtonBox*>("newProjectButtons")->button(QDialogButtonBox::Ok)->click();});
  w.findChild<QAction*>("newProject")->trigger();QVERIFY(created);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);QCOMPARE(w.projectData().value("durationMonths").toInt(),2);
  const auto original=w.projectData();int expectedMoney=0;for(auto d:w.currentView().value("documents").toArray())if(d.toObject().value("kind")=="attributes")for(auto a:d.toObject().value("data").toObject().value("attributes").toArray())if(a.toObject().value("id")=="money")expectedMoney=a.toObject().value("initial").toInt();expectedMoney=original.value("initialState").toObject().value("attributes").toObject().value("money").toInt(expectedMoney);bool configured=false;QTimer::singleShot(100,&w,[&]{auto dialog=w.findChild<QDialog*>("projectSettingsDialog");if(!dialog)return;dialog->findChild<QLineEdit*>("projectTitle")->setText("Production test");dialog->findChild<QLineEdit*>("projectGameId")->setText("INVALID ID");auto accept=dialog->findChild<QDialogButtonBox*>("projectSettingsButtons")->button(QDialogButtonBox::Ok);accept->click();if(dialog->findChild<QLabel*>("projectSettingsError")->text().isEmpty())return;dialog->findChild<QLineEdit*>("projectGameId")->setText("production-test");dialog->findChild<QSpinBox*>("projectStartYear")->setValue(1209);dialog->findChild<QSpinBox*>("projectStartMonth")->setValue(4);dialog->findChild<QSpinBox*>("projectDurationMonths")->setValue(96);dialog->findChild<QSpinBox*>("projectPeriodsPerMonth")->setValue(4);auto playback=dialog->findChild<QComboBox*>("projectSchedulePlayback");playback->setCurrentIndex(playback->findData("continuous"));configured=dialog->findChild<QSpinBox*>("projectInitial-money")->value()==expectedMoney&&dialog->findChild<QLabel*>("projectCalendarSummary")->text().contains("1217")&&dialog->findChild<QComboBox*>("projectProtagonist")->currentText()!=dialog->findChild<QComboBox*>("projectProtagonist")->currentData().toString()&&dialog->findChild<QComboBox*>("projectDefaultEnding")->currentText()!=dialog->findChild<QComboBox*>("projectDefaultEnding")->currentData().toString();dialog->findChild<QSpinBox*>("projectInitial-money")->setValue(550);accept->click();});
  w.findChild<QAction*>("projectSettings")->trigger();QVERIFY(configured);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData().value("durationMonths").toInt(),96);QCOMPARE(w.projectData().value("initialState").toObject().value("attributes").toObject().value("money").toInt(),550);
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),original);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  const auto changed=w.projectData();QCOMPARE(changed.value("periodsPerMonth").toInt(),4);QCOMPARE(changed.value("schedulePlayback").toString(),QString("continuous"));auto expectedAttributes=original.value("initialState").toObject().value("attributes").toObject();expectedAttributes["money"]=550;QCOMPARE(changed.value("initialState").toObject().value("attributes").toObject(),expectedAttributes);QTimer::singleShot(100,&w,[&]{auto dialog=w.findChild<QDialog*>("projectSettingsDialog");if(!dialog)return;dialog->findChild<QLineEdit*>("projectTitle")->setText("Cancel this");dialog->reject();});w.findChild<QAction*>("projectSettings")->trigger();QCOMPARE(w.projectData(),changed);
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),changed);
  const auto copied=directory.path()+"/reused";QTimer::singleShot(100,&w,[&]{auto dialog=w.findChild<QDialog*>("newProjectDialog");if(!dialog)return;auto mode=dialog->findChild<QComboBox*>("newProjectTemplate");mode->setCurrentIndex(mode->findData("existing"));dialog->findChild<QLineEdit*>("newProjectSource")->setText(root);dialog->findChild<QLineEdit*>("newProjectDestination")->setText(copied);dialog->findChild<QDialogButtonBox*>("newProjectButtons")->button(QDialogButtonBox::Ok)->click();});w.findChild<QAction*>("newProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&w.currentView().value("root").toString()==QDir::toNativeSeparators(copied),20000);QCOMPARE(w.projectData(),changed);
}
