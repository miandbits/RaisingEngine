void StudioTests::goalPartialApproval(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_PARTIAL_PROJECT"),evidence=engine+"/docs/evidence/goal-partial";QVERIFY(!root.isEmpty());QDir().mkpath(evidence);
 StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
 auto action=w.findChild<QAction*>("goalImpact");QVERIFY(action);action->trigger();QTRY_VERIFY_WITH_TIMEOUT(w.findChild<QDialog*>("goalImpactDialog")&&!w.busy(),20000);
 auto dialog=w.findChild<QDialog*>("goalImpactDialog");auto routes=dialog->findChild<QTableWidget*>("goalImpactTable");auto changes=dialog->findChild<QTableWidget*>("goalImpactChanges");auto partial=dialog->findChild<QPushButton*>("goalImpactPartial");auto restore=dialog->findChild<QPushButton*>("goalImpactRestore");auto history=dialog->findChild<QComboBox*>("goalImpactHistory");auto note=dialog->findChild<QLineEdit*>("goalImpactApprovalNote");QVERIFY(routes&&changes&&partial&&restore&&history&&note);
 auto selectRoute=[&]{for(int i=0;i<routes->rowCount();i++)if(routes->item(i,0)->text().endsWith(" · partial-meal")){routes->selectRow(i);return i;}return -1;};QVERIFY(selectRoute()>=0);QVERIFY(changes->rowCount()>3);QVERIFY(!partial->isEnabled());
 auto findChange=[&](QString text){for(int i=0;i<changes->rowCount();i++)if(changes->item(i,2)->text()==text)return i;return -1;};
 int money=findChange(tr("소지금")),stamina=findChange(tr("체력"));QVERIFY(money>=0&&stamina>=0);
 changes->selectRow(money);QVERIFY(dialog->findChild<QPlainTextEdit*>("goalImpactDetails")->toPlainText().contains("#2"));
 QTest::mouseClick(changes->viewport(),Qt::LeftButton,Qt::NoModifier,changes->visualItemRect(changes->item(money,0)).center());QCOMPARE(changes->item(money,0)->checkState(),Qt::Checked);int count=1;for(int i=0;i<changes->rowCount();i++)if(changes->item(i,1)->text().contains(tr("비용 정의"))||changes->item(i,1)->text().contains(tr("효과 정의"))){changes->item(i,0)->setCheckState(Qt::Checked);count++;}QCOMPARE(count,3);QVERIFY(partial->isEnabled());note->setText(tr("돈·비용·효과 정의만 승인"));dialog->grab().save(evidence+"/selected-changes.png");
 QSignalSpy ready(&w,&StudioWindow::goalImpactReady);partial->click();QTRY_VERIFY_WITH_TIMEOUT(ready.count()==1&&!w.busy(),60000);QCOMPARE(routes->item(selectRoute(),1)->text(),tr("변화 있음"));QVERIFY(dialog->findChild<QLabel*>("goalImpactChangeSummary")->text().contains(tr("승인 3")));QVERIFY(changes->item(findChange(tr("체력")),1)->text().contains(tr("미승인")));QVERIFY(changes->item(findChange(tr("소지금")),1)->text().contains(tr("승인됨")));dialog->grab().save(evidence+"/partial-approved.png");
 changes->item(findChange(tr("체력")),0)->setCheckState(Qt::Checked);note->setText(tr("체력 추가 승인"));partial->click();QTRY_VERIFY_WITH_TIMEOUT(ready.count()==2&&!w.busy(),60000);QVERIFY(dialog->findChild<QLabel*>("goalImpactChangeSummary")->text().contains(tr("승인 4")));
 int prior=-1;for(int i=0;i<history->count();i++)if(history->itemText(i).startsWith(tr("부분 승인 3개"))){prior=i;break;}QVERIFY(prior>=0);history->setCurrentIndex(prior);note->setText(tr("체력 승인 전으로 복원"));restore->click();QTRY_VERIFY_WITH_TIMEOUT(ready.count()==3&&!w.busy(),60000);QVERIFY(dialog->findChild<QLabel*>("goalImpactChangeSummary")->text().contains(tr("승인 3")));QVERIFY(changes->item(findChange(tr("체력")),1)->text().contains(tr("미승인")));dialog->grab().save(evidence+"/partial-restored.png");
 prior=-1;for(int i=0;i<history->count();i++)if(history->itemText(i).startsWith(tr("부분 승인 0개"))){prior=i;break;}QVERIFY(prior>=0);history->setCurrentIndex(prior);restore->click();QTRY_VERIFY_WITH_TIMEOUT(ready.count()==4&&!w.busy(),60000);QVERIFY(dialog->findChild<QLabel*>("goalImpactChangeSummary")->text().contains(tr("승인 0")));
 dialog->findChild<QPushButton*>("goalImpactGraph")->click();QTRY_VERIFY_WITH_TIMEOUT(w.findChild<QDialog*>("goalCompareDialog")&&!w.busy(),20000);auto compare=w.findChild<QDialog*>("goalCompareDialog");QTRY_COMPARE_WITH_TIMEOUT(compare->findChild<QSpinBox*>("goalCompareRightStep")->value(),2,20000);compare->close();
 QFile out(evidence+"/gui-verification.json");QVERIFY(out.open(QIODevice::WriteOnly));out.write(QJsonDocument(QJsonObject{{"ok",true},{"project",root},{"selectedKinds",3},{"remainingRegression",true},{"restorePartialRevision",true},{"restoreOriginal",true},{"graphJump",2}}).toJson());
}
