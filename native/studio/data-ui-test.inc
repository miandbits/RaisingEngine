void StudioTests::dataUiEditRoundtrip(){
  auto root=qEnvironmentVariable("RAISING_DATA_UI_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_DATA_UI_PROJECT to an authored collection sample");auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1440,1000);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);
  auto list=w.findChild<QListWidget*>("projectList");for(int i=0;i<list->count();i++)if(list->item(i)->data(Qt::UserRole)=="screen-6"){auto item=list->item(i);list->scrollToItem(item);QTest::mouseClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());QTest::mouseDClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());break;}
  qInfo("Roundtrip opened");const QJsonValue tables=w.projectData()["visual"].toObject()["dataTables"];
  for(int round=0;round<3;round++){qInfo("Roundtrip %d",round);
    QTimer::singleShot(100,&w,[round]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(10000,d,&QDialog::reject);qInfo("Roundtrip dialog");auto entry=d->findChild<QComboBox*>("dataUiEntry");entry->setCurrentIndex(entry->findData("collection-1"));auto confirm=d->findChild<QCheckBox*>("dataUiConfirmPurchases");QVERIFY(confirm);confirm->setChecked(true);auto field=d->findChild<QComboBox*>("dataUiFilterField");field->setCurrentIndex(field->findData(round==2?"show":"title"));d->findChild<QLineEdit*>("dataUiFilterValue")->setText(round==0?"123":"true");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editDataUi")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
    QJsonObject collection;for(auto s:w.projectData()["visual"].toObject()["screens"].toArray())if(s.toObject()["id"]=="screen-6")for(auto e:s.toObject()["elements"].toArray())if(e.toObject()["id"]=="collection-1")collection=e.toObject();QJsonValue value=collection["rowFilter"].toObject()["value"];if(round<2){QVERIFY(value.isString());QCOMPARE(value.toString(),round==0?QString("123"):QString("true"));}else QVERIFY(value.isBool()&&value.toBool());QCOMPARE(w.projectData()["visual"].toObject()["dataTables"],tables);
  }
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView()["dirty"].toBool());QVERIFY(w.projectData()["visual"].toObject()["confirmPurchases"].toBool());
}

void StudioTests::dataUiAuthoring(){
  auto root=qEnvironmentVariable("RAISING_DATA_UI_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_DATA_UI_PROJECT to a fresh rules-lab copy");auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1440,1000);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);
  auto viewport=w.findChild<QComboBox*>("viewportMode");QVERIFY(viewport);viewport->setCurrentIndex(viewport->findData("responsive"));QMetaObject::invokeMethod(viewport,"activated",Q_ARG(int,viewport->currentIndex()));QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);qInfo("Data UI project opened");QVERIFY(w.projectData()["visual"].toObject()["dataTables"].toArray().empty());
  auto evidence=engine+"/.cache/qt-data-ui-evidence";QDir().mkpath(evidence);
  auto edit=[&](std::function<void(QDialog*)> fn){QTimer::singleShot(100,&w,[fn]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QCOMPARE(d->objectName(),QString("dataUiDialog"));QTimer::singleShot(15000,d,&QDialog::reject);fn(d);});w.findChild<QAction*>("editDataUi")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));};
  auto open=[&](QString id){auto l=w.findChild<QListWidget*>("projectList");for(int i=0;i<l->count();i++)if(l->item(i)->data(Qt::UserRole)==id){auto item=l->item(i);l->scrollToItem(item);QTest::mouseClick(l->viewport(),Qt::LeftButton,Qt::NoModifier,l->visualItemRect(item).center());QTest::mouseDClick(l->viewport(),Qt::LeftButton,Qt::NoModifier,l->visualItemRect(item).center());return;}QFAIL("Missing screen");};
  auto number=[&](const char*key,int n){auto f=w.findChild<QSpinBox*>(key);QVERIFY(f);f->setValue(n);QMetaObject::invokeMethod(f,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);};
  auto button=[&](QString target,QString label,int x,int y){w.findChild<QAction*>("addButton")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);auto t=w.findChild<QLineEdit*>("buttonText");t->setText(label);QMetaObject::invokeMethod(t,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);auto combo=w.findChild<QComboBox*>("actionTarget");int at=combo->findData(target);QVERIFY(at>=0);combo->setCurrentIndex(at);QMetaObject::invokeMethod(combo,"activated",Q_ARG(int,at));QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);number("elementX",x);number("elementY",y);};
  auto choose=[](QDialog*d,const char*key,QString val){auto c=d->findChild<QComboBox*>(key);if(!c)return false;int at=c->findData(val);if(at<0)return false;c->setCurrentIndex(at);return true;};
  auto binding=[](QDialog*d,QString child,QString property,QString field,QString format={}){d->findChild<QPushButton*>("dataUiBindingAdd")->click();auto t=d->findChild<QTableWidget*>("dataUiBindings");int r=t->rowCount()-1;qobject_cast<QComboBox*>(t->cellWidget(r,0))->setCurrentText(child);auto p=qobject_cast<QComboBox*>(t->cellWidget(r,1));p->setCurrentIndex(p->findData(property));qobject_cast<QComboBox*>(t->cellWidget(r,2))->setCurrentText(field);t->item(r,3)->setText(format);};
  const QStringList screenNames{"Data products","Data policies","Data relationships","Designer table"},sources{"shopOffers","policyOptions","relationships","table"};
  for(int k=0;k<4;k++){qInfo("Data UI screen %d",k);
    QTimer::singleShot(100,&w,[&,k]{auto d=qobject_cast<QInputDialog*>(QApplication::activeModalWidget());QVERIFY(d);d->setTextValue(screenNames[k]);d->accept();});w.findChild<QAction*>("newScreen")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
    qInfo("Screen created");edit([&,k](QDialog*d){qInfo("Workshop open");
      if(k==0)d->findChild<QPushButton*>("dataUiCreateTemplate")->click();
      if(k==3){d->findChild<QTabWidget*>()->setCurrentIndex(1);d->findChild<QPushButton*>("dataTableAdd")->click();d->findChild<QLineEdit*>("dataTableName")->setText("Designer services");
        const QStringList ids{"title","command","target","show","quantity"},types{"text","text","text","boolean","number"};
        for(int c=0;c<ids.size();c++){qInfo("Column %d",c);d->findChild<QPushButton*>("dataColumnAdd")->click();auto t=d->findChild<QTableWidget*>("dataTableColumns");t->item(c,0)->setText(ids[c]);t->item(c,1)->setText(ids[c]);auto type=qobject_cast<QComboBox*>(t->cellWidget(c,2));type->setCurrentIndex(type->findData(types[c]));}
        for(int r=0;r<3;r++){qInfo("Row %d",r);d->findChild<QPushButton*>("dataRowAdd")->click();auto t=d->findChild<QTableWidget*>("dataTableRows");QStringList vals{r==0?"Rest service":r==1?"Prayer service":"Hidden service","executeAction",r==1?"action-5":"action-4",r==2?"false":"true","1"};for(int c=0;c<vals.size();c++)t->item(r,c+1)->setText(vals[c]);}
        // Invalid primitive input is caught without losing the authored table.
        auto t=d->findChild<QTableWidget*>("dataTableRows");t->item(0,5)->setText("not-a-number");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();QVERIFY(d->isVisible());QVERIFY(!d->findChild<QLabel*>("dataUiError")->text().isEmpty());t->item(0,5)->setText("2");d->grab().save(evidence+"/designer-table.png");d->findChild<QTabWidget*>()->setCurrentIndex(0);
      }
      qInfo("Bind source %d",k);QVERIFY(choose(d,"dataUiSource",sources[k]));d->findChild<QLineEdit*>("dataUiName")->setText(screenNames[k]);
      if(k==0)QVERIFY(choose(d,"dataUiSourceId","florist"));
      if(k<3)d->findChild<QPushButton*>("dataUiBindingDefaults")->click();
      else{QVERIFY(choose(d,"dataUiSourceId","table-1"));binding(d,"title","text","title");binding(d,"value","text","target","Action {value}");binding(d,"button","text","title");binding(d,"button","action","command");binding(d,"button","actionId","target");binding(d,"button","quantity","quantity");QVERIFY(choose(d,"dataUiFilterField","show"));d->findChild<QLineEdit*>("dataUiFilterValue")->setText("true");
        qInfo("Edit collection condition");QTimer::singleShot(100,d,[]{auto logic=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(logic);QVERIFY(logicTestChoose(*logic,"logicType","compare"));QVERIFY(logicTestChoose(*logic,"logic-comparator","gte"));QVERIFY(logicTestSelect(*logic,{"left"}));QVERIFY(logicTestChoose(*logic,"logicType","read"));QVERIFY(logicTestSelect(*logic,{"left","target"}));QVERIFY(logicTestChoose(*logic,"logic-attributeId","money"));QVERIFY(logicTestSelect(*logic,{"right"}));QVERIFY(logicTestNumber(*logic,"value",1));logic->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});d->findChild<QPushButton*>("dataUiCondition-enabled")->click();
      }
      d->grab().save(evidence+QString("/bindings-%1.png").arg(k));d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();
    });
    QJsonObject authoredScreen;for(auto s:w.projectData()["visual"].toObject()["screens"].toArray())if(s.toObject()["id"]==QString("screen-%1").arg(k+3))authoredScreen=s.toObject();QCOMPARE(authoredScreen["elements"].toArray().size(),1);QCOMPARE(authoredScreen["elements"].toArray().first().toObject()["kind"].toString(),QString("collection"));
    button("home","Home",20,20);for(int n=0;n<k;n++)button(QString("screen-%1").arg(n+3),screenNames[n],260+n*250,20);
    w.grab().save(evidence+QString("/canvas-%1.png").arg(k));open("home");button(QString("screen-%1").arg(k+3),screenNames[k],40+k*290,550);
  }
  open("market");button("screen-3","Data products",930,100);open("home");
  // Edit one shared primitive: all four collection references retain the same definition.
  QTimer::singleShot(100,&w,[&]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(10000,d,&QDialog::reject);auto library=d->findChild<QListWidget*>("componentLibrary");library->setCurrentRow(library->count()-1);auto children=d->findChild<QListWidget*>("componentChildren");children->setCurrentRow(0);d->findChild<QLineEdit*>("child-fill")->setText("#e8f0dd");children->setCurrentRow(3);auto action=d->findChild<QComboBox*>("child-action");action->setCurrentIndex(action->findData("navigate"));auto target=d->findChild<QComboBox*>("child-screenId");target->setCurrentIndex(target->findData("screen-6"));d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editComponents")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  for(auto v:w.currentView()["diagnostics"].toArray())QVERIFY2(v.toObject()["severity"]!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView()["dirty"].toBool());const auto authored=w.projectData();StudioWindow reopened(engine);reopened.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!reopened.busy()&&!reopened.projectData().empty(),20000);QCOMPARE(reopened.projectData(),authored);QCOMPARE(authored["visual"].toObject()["dataTables"].toArray().first().toObject()["rows"].toArray().size(),3);
  QFile f(evidence+"/authored-project.json");QVERIFY(f.open(QIODevice::WriteOnly));f.write(QJsonDocument(authored).toJson());
}
