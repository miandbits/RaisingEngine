void StudioTests::directionPlayIntegration(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile proof(engine+"/.cache/direction-proof.json");QVERIFY(proof.open(QIODevice::ReadOnly));const auto root=QJsonDocument::fromJson(proof.readAll()).object().value("project").toString();StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);w.playAutomation=engine+"/docs/evidence/direction/play-steps.json";w.playReport=engine+"/docs/evidence/direction/editor-play-report.json";QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,90000);QCOMPARE(finished.first().first().toInt(),0);QFile report(w.playReport);QVERIFY(report.open(QIODevice::ReadOnly));const auto data=QJsonDocument::fromJson(report.readAll()).object();QVERIFY(data.value("ok").toBool());QJsonObject saved,restored;for(auto v:data.value("steps").toArray()){auto step=v.toObject();auto tag=step.value("command").toObject().value("checkpoint").toString();if(tag=="saved")saved=step.value("ui").toObject();if(tag=="restored")restored=step.value("ui").toObject();}QVERIFY(!saved.isEmpty());QCOMPARE(saved.value("direction"),restored.value("direction"));QCOMPARE(saved.value("state"),restored.value("state"));w.grab().save(engine+"/docs/evidence/direction/editor-play.png");
}
