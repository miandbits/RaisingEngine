void StudioTests::integratedAuthoringRoundtrip(){
  if(!qEnvironmentVariableIsSet("RAISING_QT_INTEGRATED_AUTHORING"))QSKIP("Requires an isolated conditional-routing GUI-authored fixture.");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_QT_PROJECT");QVERIFY(!root.isEmpty());
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
  w.findChild<QAction*>("showAuthoringWorkspace")->trigger();auto dock=w.findChild<QDockWidget*>("authoringWorkspaceDock");QVERIFY(dock);
  auto settle=[&]{QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QTest::qWait(150);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));};settle();
  auto tree=dock->findChild<QTreeWidget*>("workspaceEntities");QVERIFY(tree->isColumnHidden(1));
  auto selected=[&]{return tree->currentItem()->data(0,Qt::UserRole).toJsonObject();};
  auto apply=[&]{dock->findChild<QPushButton*>("workspaceApply")->click();settle();};
  auto setName=[&](QString name){auto field=dock->findChild<QLineEdit*>("workspaceField-name");if(!field)field=dock->findChild<QLineEdit*>("workspaceField-label");QVERIFY(field);field->setText(name);QMetaObject::invokeMethod(field,"textEdited",Q_ARG(QString,name));};
  auto add=[&](QString kind,QString name){auto c=dock->findChild<QComboBox*>("workspaceAddKind");c->setCurrentIndex(c->findData(kind));if(!name.isEmpty())QTimer::singleShot(30,&w,[=]{auto d=qobject_cast<QInputDialog*>(QApplication::activeModalWidget());QVERIFY(d);d->setTextValue(name);QTest::keyClick(d->findChild<QLineEdit*>(),Qt::Key_Return);});dock->findChild<QPushButton*>("workspaceAdd")->click();settle();};
  add("attribute","기운");const auto attribute=selected().value("id").toString();QVERIFY(attribute.startsWith("attribute-"));dock->findChild<QSpinBox*>("workspaceField-initial")->setValue(10);dock->findChild<QComboBox*>("workspaceAttributeKind")->setCurrentIndex(1);apply();
  add("activity","내공 수련");const auto activity=selected().value("id").toString();QVERIFY(activity.startsWith("activity-"));
  // Activity creation is one undoable transaction, with no user-entered ID.
  dock->findChild<QPushButton*>("workspace-undoEdit")->click();settle();bool absent=true;for(auto d:w.currentView().value("documents").toArray())if(d.toObject().value("data").toObject().value("id")==activity)absent=false;QVERIFY(absent);dock->findChild<QPushButton*>("workspace-redoEdit")->click();settle();selectWorkspaceItem(dock,"activity:"+activity);
  const auto group=w.projectData().value("stateGroups").toArray().first().toObject();const auto gid=group.value("id").toString(),training=group.value("values").toArray()[1].toObject().value("id").toString(),banquet=group.value("values").toArray()[2].toObject().value("id").toString();
  auto effects=[&](QString button,QString state){QTimer::singleShot(30,&w,[&]{auto d=static_cast<LogicEditor*>(w.findChild<QDialog*>("logicEditor"));QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);QVERIFY(logicTestSelect(*d,{}));d->findChild<QPushButton*>("logicAdd")->click();QVERIFY(logicTestSelect(*d,{"0"}));QVERIFY(logicTestChoose(*d,"logicType","setState"));QVERIFY(logicTestChoose(*d,"logic-stateGroupId",gid));QVERIFY(logicTestChoose(*d,"logic-stateValueId",state));d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});dock->findChild<QPushButton*>(button)->click();};
  auto cost=[&](int value){dock->findChild<QPushButton*>("workspaceAddCost")->click();auto table=dock->findChild<QTableWidget*>("workspaceCosts");auto c=qobject_cast<QComboBox*>(table->cellWidget(0,0));c->setCurrentIndex(c->findData(attribute));qobject_cast<QSpinBox*>(table->cellWidget(0,1))->setValue(value);};
  cost(1);effects("workspaceLogic-baseEffects",banquet);apply();
  add("action",{});const auto action=selected().value("id").toString();setName("호흡 가다듬기");cost(2);effects("workspaceLogic-effects",training);apply();
  selectWorkspaceItem(dock,"attribute:"+attribute);dock->findChild<QPushButton*>("workspaceDelete")->click();QVERIFY(dock->findChild<QLabel*>("workspaceStatus")->text().contains("삭제할 수 없습니다"));
  selectWorkspaceItem(dock,"screen:screen-1");dock->findChild<QPushButton*>("workspaceAddButton")->click();settle();const auto button=w.selectedId();selectWorkspaceItem(dock,"screenElement:screen-1/"+button);
  auto text=dock->findChild<QLineEdit*>("workspaceField-text");text->setText("호흡 가다듬기");QMetaObject::invokeMethod(text,"textEdited",Q_ARG(QString,QString("호흡 가다듬기")));auto mode=dock->findChild<QComboBox*>("workspaceButtonMode");mode->setCurrentIndex(mode->findData("executeAction"));auto target=dock->findChild<QComboBox*>("workspaceButtonTarget");target->setCurrentIndex(target->findData(action));QCOMPARE(target->currentText(),QString("호흡 가다듬기"));apply();
  // Geometry uses the real canvas inspector; the action link uses the workspace.
  for(auto pair:QList<QPair<const char*,int>>{{"elementX",820},{"elementY",90},{"elementWidth",300},{"elementHeight",54}}){auto field=w.findChild<QSpinBox*>(pair.first);field->setValue(pair.second);QMetaObject::invokeMethod(field,"editingFinished");settle();}
  selectWorkspaceItem(dock,"screen:screen-1-copy-1");dock->findChild<QPushButton*>("workspaceAddText")->click();settle();const auto caption=w.selectedId();selectWorkspaceItem(dock,"screenElement:screen-1-copy-1/"+caption);
  dock->findChild<QPushButton*>("workspacePresentation")->click();auto outer=w.findChild<QDialog*>("presentationVariantsDialog");QVERIFY(outer);outer->findChild<QPushButton*>("variantAdd")->click();auto edit=outer->findChild<QDialog*>("presentationVariantEdit");edit->findChild<QLineEdit*>("variantName")->setText("수련 상태 안내");auto prop=edit->findChild<QComboBox*>("variantProperty");prop->setCurrentIndex(prop->findData("text"));edit->findChild<QLineEdit*>("variantValue")->setText("기운을 모으며 수련 중");edit->findChild<QPushButton*>("variantCondition")->click();auto logic=static_cast<LogicEditor*>(edit->findChild<QDialog*>("logicEditor"));QVERIFY(logicTestChoose(*logic,"logicType","stateIs"));QVERIFY(logicTestChoose(*logic,"logic-stateGroupId",gid));QVERIFY(logicTestChoose(*logic,"logic-stateValueId",training));logic->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();edit->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Ok)->click();outer->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();settle();
  for(auto pair:QList<QPair<const char*,int>>{{"elementX",820},{"elementY",90},{"elementWidth",380},{"elementHeight",54}}){auto field=w.findChild<QSpinBox*>(pair.first);field->setValue(pair.second);QMetaObject::invokeMethod(field,"editingFinished");settle();}
  selectWorkspaceItem(dock,"stateValue:"+gid+"/"+training);auto links=dock->findChild<QTreeWidget*>("workspaceReferences");QVERIFY(links->topLevelItem(0)->childCount()>0);
  // Named state -> condition-based screen connection stays in the same work flow.
  selectWorkspaceItem(dock,"screenRoute:0");dock->findChild<QPushButton*>("workspaceRouting")->click();auto routing=w.findChild<QDialog*>("screenRoutingDialog");QVERIFY(routing);routing->reject();
  dock->findChild<QPushButton*>("workspace-saveProject")->click();settle();QVERIFY(!w.currentView().value("dirty").toBool());w.openProject(root);settle();
  QJsonObject authored;for(auto d:w.currentView().value("documents").toArray())if(d.toObject().value("data").toObject().value("id")==activity)authored=d.toObject().value("data").toObject();QCOMPARE(authored.value("baseEffects").toArray().first().toObject().value("stateValueId").toString(),banquet);
  QFile info(engine+"/.cache/integrated-authoring/authoring.json");QVERIFY(info.open(QIODevice::WriteOnly));info.write(QJsonDocument(QJsonObject{{"root",root},{"attribute",attribute},{"activity",activity},{"action",action},{"button",button},{"caption",caption},{"groupId",gid},{"training",training},{"banquet",banquet}}).toJson());info.close();QVERIFY(dock->grab().save(engine+"/.cache/integrated-authoring/workspace.png"));
  QFile steps(engine+"/.cache/integrated-authoring/smoke.json");QVERIFY(steps.open(QIODevice::WriteOnly));steps.write("[{\"checkpoint\":\"workspace-project\"}]");steps.close();w.playAutomation=steps.fileName();w.playReport=engine+"/.cache/integrated-authoring/smoke-report.json";QSignalSpy finished(&w,&StudioWindow::playerFinished);dock->findChild<QPushButton*>("workspace-playProject")->click();settle();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,30000);QVERIFY(QFileInfo::exists(w.playReport));
}
