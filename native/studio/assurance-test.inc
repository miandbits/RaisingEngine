void StudioTests::benchmarkAuthoringSuite(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),base=qEnvironmentVariable("RAISING_BENCHMARK_ROOT",engine+"/.cache/genre-suite-"+QString::number(QDateTime::currentMSecsSinceEpoch()));QVERIFY(!QFileInfo::exists(base));QDir().mkpath(base);StudioWindow w(engine);w.show();w.openProject(engine+"/tests/fixtures/projects/direction-lab");QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);QJsonArray projects;
 for(const auto kind:QStringList{"schedule","free","relationship","adventure","roster","pet"}){const auto root=base+"/"+kind,title=tr("제작 시험 · ")+kind;bool authored=false;QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("benchmarkDialog");if(!d)return;auto combo=d->findChild<QComboBox*>("benchmarkKind");combo->setCurrentIndex(combo->findData(kind));d->findChild<QLineEdit*>("benchmarkTitle")->setText(title);d->findChild<QLineEdit*>("benchmarkRoot")->setText(root);d->findChild<QSpinBox*>("benchmarkBudget")->setValue(45);QDir().mkpath(engine+"/docs/evidence/genre-suite");d->grab().save(engine+"/docs/evidence/genre-suite/author-"+kind+".png");authored=true;d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("createBenchmark")->trigger();QVERIFY(authored);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));QCOMPARE(w.projectData().value("title").toString(),title);QCOMPARE(w.projectData().value("initialState").toObject().value("attributes").toObject().value("money").toInt(),45);w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QCOMPARE(w.projectData().value("title").toString(),title);projects.append(QJsonObject{{"kind",kind},{"root",root},{"title",title},{"budget",45}});}
 QFile proof(engine+"/.cache/genre-suite-proof.json");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(QJsonDocument(QJsonObject{{"guiTemplates",true},{"saveReopen",true},{"projects",projects}}).toJson());
}
void StudioTests::benchmarkPlayAndAssurance(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile proof(engine+"/.cache/genre-suite-proof.json");QVERIFY(proof.open(QIODevice::ReadOnly));const auto entries=QJsonDocument::fromJson(proof.readAll()).object().value("projects").toArray();QCOMPARE(entries.size(),6);StudioWindow w(engine);w.show();
 for(auto v:entries){const auto item=v.toObject();const auto kind=item.value("kind").toString();w.openProject(item.value("root").toString());QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);w.playAutomation=engine+"/docs/evidence/genre-suite/"+kind+"/play-steps.json";w.playReport=engine+"/docs/evidence/genre-suite/"+kind+"/editor-play-report.json";QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,90000);QCOMPARE(finished.first().first().toInt(),0);QFile report(w.playReport);QVERIFY(report.open(QIODevice::ReadOnly));auto result=QJsonDocument::fromJson(report.readAll()).object();QVERIFY(result.value("ok").toBool());QJsonObject final;for(auto step:result.value("steps").toArray())if(step.toObject().value("command").toObject().value("checkpoint")=="finished")final=step.toObject().value("ui").toObject().value("state").toObject();QCOMPARE(final.value("phase").toString(),QString("finished"));QCOMPARE(final.value("endingId").toString(),QString("success"));
  w.findChild<QAction*>("runAssurance")->trigger();auto d=w.findChild<QDialog*>("assuranceDialog");QVERIFY(d);d->findChild<QSpinBox*>("assuranceRuns")->setValue(32);d->findChild<QPushButton*>("assuranceStart")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),90000);auto summary=d->findChild<QLabel*>("assuranceSummary")->text();QVERIFY2(summary.contains(tr("검사 통과")),qPrintable(summary+"\n"+w.lastError));QVERIFY(d->findChild<QTableWidget*>("assuranceCoverage")->rowCount()>0);d->grab().save(engine+"/docs/evidence/genre-suite/"+kind+"/editor-assurance.png");d->close();QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);
 }
}
