#include "route-tree.hpp"
void StudioTests::workbenchBranchTree(){
  const auto root=qEnvironmentVariable("RAISING_WORKBENCH_ANALYSIS_PROJECT");if(root.isEmpty())QSKIP("Set archived 5000-run project; no new simulation is started");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1520,1020);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);w.findChild<QAction*>("showAnalysis")->trigger();auto pane=w.findChild<QWidget*>("analysisPane");auto mode=pane->findChild<QComboBox*>("analysisMapMode");QCOMPARE(mode->currentData().toString(),QString("tree"));auto tree=pane->findChild<RouteTreeView*>("analysisTree");QVERIFY(tree);
  auto cards=[&]{QList<QGraphicsItem*> found;for(auto item:tree->scene()->items())if(item->data(1)=="tree-node"&&!item->data(4).toBool())found.append(item);return found;};
  QTRY_VERIFY_WITH_TIMEOUT(cards().size()>3,120000);QVERIFY(pane->findChild<QLabel*>("analysisSummary")->text().contains("5000 / 5000"));
  // A true tree has one incoming connector per non-root visible card; no merged branches.
  const auto evidence=engine+"/.cache/qt-tree-evidence";QDir().mkpath(evidence);QTRY_VERIFY_WITH_TIMEOUT(pane->findChild<QTableWidget*>("analysisRunTable")->rowCount()>0,30000);pane->grab().save(evidence+"/branch-tree.png");
  QGraphicsItem *more=nullptr;for(auto item:tree->scene()->items())if(item->data(4).toBool()){more=item;break;}QVERIFY(more);const int firstPage=cards().size();tree->centerOn(more);QTest::qWait(100);QTest::mouseDClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->mapFromScene(more->sceneBoundingRect().center()));QTRY_VERIFY_WITH_TIMEOUT(cards().size()>firstPage,30000);
  QGraphicsItem *branch=nullptr;for(auto item:cards())if(item->data(3).toInt()>1&&item->data(3).toInt()<5000&&item->data(2).toList().size()>1){branch=item;break;}QVERIFY(branch);const auto prefix=branch->data(2).toList();const int matching=branch->data(3).toInt();tree->centerOn(branch);QTest::qWait(100);const QPoint point=tree->mapFromScene(branch->sceneBoundingRect().center());QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,point);auto count=pane->findChild<QLabel*>("analysisRunCount");QTRY_VERIFY_WITH_TIMEOUT(count->text().contains(QString("회차 %1개").arg(matching)),30000);QVERIFY(pane->findChild<QLabel*>("analysisNodeInfo")->text().contains("전체 경로"));
  // Clearing a filter must allow reselecting the same branch, not leave an inert highlight.
  pane->findChild<QPushButton*>("analysisClearFilter")->click();QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("회차 5000개"),10000);
  QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,point);QTRY_VERIFY_WITH_TIMEOUT(count->text().contains(QString("회차 %1개").arg(matching)),3000);
  // Compare the actual displayed IDs with the archived ordered paths, independently of the query API.
  QList<int> expected;QList<QJsonObject> branchRecords;QList<int> limited;
  const auto jobId=pane->findChild<QComboBox*>("analysisHistory")->currentData().toString();
  for(int run=0;run<5000;++run){QFile f(root+"/.studio/analysis/"+jobId+".runs/"+QString::number(run)+".json");QVERIFY(f.open(QIODevice::ReadOnly));const auto record=QJsonDocument::fromJson(f.readAll()).object();if(record.value("outcome")=="limit")limited.append(run);const auto route=record.value("route").toArray();bool matches=route.size()>=prefix.size();for(int i=0;matches&&i<prefix.size();++i)matches=route[i].toObject().value("nodeId").toString()==prefix[i].toString();if(matches){expected.append(run);branchRecords.append(record);}}
  QCOMPARE(expected.size(),matching);QVERIFY(!limited.empty());
  auto displayed=[&]{QList<int> ids;auto table=pane->findChild<QTableWidget*>("analysisRunTable");for(int i=0;i<table->rowCount();++i)ids.append(table->item(i,0)->text().toInt());return ids;};
  QCOMPARE(displayed(),expected.mid(0,100));
  auto next=pane->findChild<QPushButton*>("analysisNextRuns");auto previous=pane->findChild<QPushButton*>("analysisPreviousRuns");QVERIFY(next);QVERIFY(previous);
  if(expected.size()>100){next->click();QTRY_COMPARE_WITH_TIMEOUT(displayed(),expected.mid(100,100),10000);previous->click();QTRY_COMPARE_WITH_TIMEOUT(displayed(),expected.mid(0,100),10000);}
  const int before=cards().size();QTest::mouseDClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,point);QTRY_VERIFY_WITH_TIMEOUT(cards().size()>before,30000);pane->grab().save(evidence+"/branch-expanded.png");
  // Collapse keeps the selected prefix filter and hides only descendants.
  QGraphicsItem *same=nullptr;for(auto item:cards())if(item->data(2).toList()==prefix){same=item;break;}QVERIFY(same);tree->centerOn(same);QTest::qWait(100);QTest::mouseDClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->mapFromScene(same->sceneBoundingRect().center()));QCOMPARE(cards().size(),before);
  auto runs=pane->findChild<QTableWidget*>("analysisRunTable");QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()>0,30000);runs->setCurrentCell(0,0);pane->findChild<QPushButton*>("analysisOpenRun")->click();QTRY_VERIFY_WITH_TIMEOUT(pane->findChild<QLabel*>("analysisReplayInfo")->text().contains("명령 0 /"),15000);QVERIFY(pane->findChild<QTableWidget*>("analysisRouteTable")->rowCount()>prefix.size());
  pane->findChild<QTabWidget*>("analysisTabs")->setCurrentIndex(0);mode->setCurrentIndex(mode->findData("graph"));QMetaObject::invokeMethod(mode,"activated",Q_ARG(int,mode->currentIndex()));QVERIFY(pane->findChild<QGraphicsView*>("analysisGraph")->scene()->items().size()>50);mode->setCurrentIndex(mode->findData("tree"));QMetaObject::invokeMethod(mode,"activated",Q_ARG(int,mode->currentIndex()));QCOMPARE(cards().size(),before);
  QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("회차 5000개"),10000);QVERIFY(tree->scene()->selectedItems().empty());
  auto selectBranch=[&](const QVariantList &path){for(auto item:cards())if(item->data(2).toList()==path){tree->centerOn(item);QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->mapFromScene(item->sceneBoundingRect().center()));return true;}return false;};
  QVERIFY(selectBranch(prefix));QTRY_COMPARE_WITH_TIMEOUT(displayed(),expected.mid(0,100),10000);
  for(auto item:cards())if(item->data(2).toList()!=prefix&&item->data(2).toList().size()>1){const auto other=item->data(2).toList();QVERIFY(selectBranch(other));break;}
  QVERIFY(selectBranch(prefix));QTRY_COMPARE_WITH_TIMEOUT(displayed(),expected.mid(0,100),10000);
  // Conditions intersect with the selected path and apply without a second click on Apply.
  auto ending=pane->findChild<QComboBox*>("analysisEnding");auto attribute=pane->findChild<QComboBox*>("analysisFinalAttribute");auto outcome=pane->findChild<QComboBox*>("analysisOutcome");auto min=pane->findChild<QSpinBox*>("analysisAbilityMin");auto max=pane->findChild<QSpinBox*>("analysisAbilityMax");
  const auto firstState=branchRecords.first().value("state").toObject();const auto endingId=firstState.value("endingId").toString();const auto attrId=attribute->itemData(1).toString();const int value=firstState.value("attributes").toObject().value(attrId).toInt();
  QList<int> intersection;for(auto record:branchRecords){auto state=record.value("state").toObject();if(state.value("endingId").toString()==endingId&&state.value("attributes").toObject().value(attrId).toInt()==value)intersection.append(record.value("run").toInt());}QVERIFY(!intersection.empty());
  ending->setCurrentIndex(ending->findData(endingId));min->setValue(value);max->setValue(value);attribute->setCurrentIndex(1);
  QTRY_COMPARE_WITH_TIMEOUT(displayed(),intersection.mid(0,100),10000);QVERIFY(pane->findChild<QLabel*>("analysisActiveFilters")->text().contains("모두 충족"));
  min->setValue(value+1);QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("필터 오류"),10000);QCOMPARE(displayed().size(),0);
  attribute->setCurrentIndex(0);pane->findChild<QPushButton*>("analysisClearAllFilters")->click();QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("회차 5000개"),10000);
  outcome->setCurrentIndex(outcome->findData("limit"));QTRY_COMPARE_WITH_TIMEOUT(displayed(),limited,10000);
  pane->findChild<QPushButton*>("analysisClearFilter")->click();QTRY_COMPARE_WITH_TIMEOUT(displayed(),limited,10000);QVERIFY(pane->findChild<QLabel*>("analysisActiveFilters")->text().contains("limit"));
  outcome->setCurrentIndex(outcome->findData("error"));QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("회차 0개"),10000);QCOMPARE(displayed().size(),0);QVERIFY(!next->isEnabled());QVERIFY(!previous->isEnabled());
  pane->findChild<QPushButton*>("analysisClearAllFilters")->click();QTRY_VERIFY_WITH_TIMEOUT(count->text().contains("회차 5000개"),10000);QVERIFY(selectBranch(prefix));QTRY_COMPARE_WITH_TIMEOUT(displayed(),expected.mid(0,100),10000);
  // Loading additional siblings must not highlight the parent while retaining a different path filter.
  const int visibleBeforeMore=cards().size();for(auto item:tree->scene()->items())if(item->data(4).toBool()){tree->centerOn(item);QTest::mouseDClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->mapFromScene(item->sceneBoundingRect().center()));break;}
  QTRY_VERIFY_WITH_TIMEOUT(cards().size()>visibleBeforeMore,10000);QVERIFY(!tree->scene()->selectedItems().empty());QCOMPARE(tree->scene()->selectedItems().first()->data(2).toList(),prefix);QCOMPARE(displayed(),expected.mid(0,100));
  outcome->setCurrentIndex(outcome->findData("finished"));QTRY_VERIFY_WITH_TIMEOUT(!count->text().contains("적용 중"),10000);w.findChild<QAction*>("showAnalysis")->trigger();QCOMPARE(outcome->currentData().toString(),QString("finished"));QVERIFY(pane->findChild<QLabel*>("analysisActiveFilters")->text().contains("finished"));
  pane->grab().save(evidence+"/branch-filter-verified.png");
  QFile filterReport(evidence+"/filter-regression.json");QVERIFY(filterReport.open(QIODevice::WriteOnly));filterReport.write(QJsonDocument(QJsonObject{{"jobId",jobId},{"archivedRuns",5000},{"newSimulations",0},{"selectedPathRuns",matching},{"intersectionRuns",intersection.size()},{"exactArchivedRunIds",true},{"clearAndReselect",true},{"modeSwitchReselect",true},{"rapidSelection",true},{"pagination",true},{"automaticCombinedFilters",true},{"invalidRange",true},{"zeroResults",true},{"pathClearPreservesOutcome",true},{"clearAllFilters",true},{"loadMorePreservesSelection",true},{"reopenPreservesFilters",true}}).toJson());
  QFile report(evidence+"/acceptance.json");QVERIFY(report.open(QIODevice::WriteOnly));report.write(QJsonDocument(QJsonObject{{"archivedRuns",5000},{"selectedBranchRuns",matching},{"prefix",QJsonArray::fromVariantList(prefix)},{"visibleCards",before},{"newSimulations",0},{"expandCollapse",true},{"filteredReplay",true}}).toJson());
}
