void StudioTests::goalSearchAndRegister(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_SEARCH_PROJECT"),evidence=engine+"/docs/evidence/goal-search";
 QVERIFY(!root.isEmpty());QDir().mkpath(evidence);StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
 w.findChild<QAction*>("goalRoutes")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);auto routes=w.findChild<QDialog*>("goalRoutesDialog");QVERIFY(routes);const auto initialCount=routes->findChild<QTableWidget*>("goalRoutes")->rowCount();
 auto searchTarget=[&](QString kind,QString targetId,QString routeId){
  routes->findChild<QPushButton*>("goalSearchOpen")->click();auto dialog=w.findChild<QDialog*>("goalSearchDialog");QVERIFY(dialog);auto combo=dialog->findChild<QComboBox*>("goalSearchTarget");int choice=-1;
  for(int i=0;i<combo->count();i++){auto t=combo->itemData(i).toJsonObject();if(t.value("kind")==kind&&t.value("id")==targetId)choice=i;}QVERIFY(choice>=0);combo->setCurrentIndex(choice);dialog->findChild<QLineEdit*>("goalSearchId")->setText(routeId);dialog->findChild<QLineEdit*>("goalSearchName")->setText(tr("GUI 탐색 · ")+targetId);
  dialog->findChild<QPushButton*>("goalSearchStart")->click();auto save=dialog->findChild<QPushButton*>("goalSearchRegister");QTRY_VERIFY_WITH_TIMEOUT(save->isEnabled(),65000);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),5000);dialog->grab().save(evidence+"/gui-found-"+kind+".png");save->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(dialog->findChild<QLabel*>("goalSearchSummary")->text().contains(tr("등록 완료")),qPrintable(dialog->findChild<QLabel*>("goalSearchSummary")->text()));dialog->close();QTRY_VERIFY(w.findChild<QDialog*>("goalSearchDialog")==nullptr);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
 };
 searchTarget("event","month-01","gui-event");searchTarget("ending","wanderer","gui-ending");
 routes->findChild<QPushButton*>("goalRefresh")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);auto table=routes->findChild<QTableWidget*>("goalRoutes");QCOMPARE(table->rowCount(),initialCount+2);
 routes->findChild<QPushButton*>("goalRunAll")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),120000);QVERIFY(w.lastGoalReport.value("ok").toBool());routes->grab().save(evidence+"/gui-regression.png");
 // A failed existing route keeps its original bytes after alternative registration.
 int row=-1;for(int i=0;i<table->rowCount();i++)if(table->item(i,0)->data(Qt::UserRole).toJsonObject().value("route").toObject().value("id")=="success")row=i;QVERIFY(row>=0);table->setCurrentCell(row,0);
 auto ending=routes->findChild<QComboBox*>("goalEnding");ending->setCurrentIndex(ending->findData("wanderer"));routes->findChild<QPushButton*>("goalSave")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);
 for(int i=0;i<table->rowCount();i++)if(table->item(i,0)->data(Qt::UserRole).toJsonObject().value("route").toObject().value("id")=="success")row=i;table->setCurrentCell(row,0);
 routes->findChild<QPushButton*>("goalRun")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),30000);QVERIFY(!w.lastGoalReport.value("ok").toBool());
 QFile original(root+"/playtests/routes/success.json");QVERIFY(original.open(QIODevice::ReadOnly));auto before=original.readAll();original.close();
 routes->findChild<QPushButton*>("goalAlternative")->click();auto dialog=w.findChild<QDialog*>("goalSearchDialog");QVERIFY(dialog);dialog->findChild<QLineEdit*>("goalSearchId")->setText("gui-alternative");dialog->findChild<QSpinBox*>("goalSearchSeconds")->setValue(60);dialog->findChild<QPushButton*>("goalSearchStart")->click();auto save=dialog->findChild<QPushButton*>("goalSearchRegister");QTRY_VERIFY_WITH_TIMEOUT(save->isEnabled(),70000);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),5000);dialog->grab().save(evidence+"/gui-alternative.png");save->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY(dialog->findChild<QLabel*>("goalSearchSummary")->text().contains(tr("등록 완료")));QVERIFY(original.open(QIODevice::ReadOnly));QCOMPARE(original.readAll(),before);original.close();dialog->close();
 QTRY_VERIFY(w.findChild<QDialog*>("goalSearchDialog")==nullptr);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);routes->findChild<QPushButton*>("goalRefresh")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(table->rowCount(),initialCount+3);
 QFile proof(evidence+"/gui-verification.json");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(QJsonDocument(QJsonObject{{"ok",true},{"project",root},{"endingSearch",true},{"eventSearch",true},{"failedRouteAlternative",true},{"originalPreserved",true},{"registeredRoutes",initialCount+3}}).toJson());routes->close();
}
