void StudioTests::genericRulesLegacyProject(){
  const auto root=qEnvironmentVariable("RAISING_RULES_LEGACY_PROJECT");
  if(root.isEmpty())QSKIP("Set RAISING_RULES_LEGACY_PROJECT to a legacy project copy");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());
  StudioWindow w(engine);w.resize(1440,1000);w.show();w.openProject(root);
  QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);
  const auto before=w.projectData();
  const bool legacy=!before["gameplay"].toObject()["diets"].toArray().empty()||!before["gameplay"].toObject()["services"].toArray().empty();

  QTimer::singleShot(100,&w,[legacy]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(10000,d,&QDialog::reject);auto b=d->findChild<QPushButton*>("migrateFacilityRules");QVERIFY(b);QCOMPARE(b->isEnabled(),legacy);if(legacy)b->click();QVERIFY(!b->isEnabled());d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  w.findChild<QAction*>("editRules")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  const auto after=w.projectData();if(legacy)QVERIFY(after!=before);else QCOMPARE(after,before);const auto rules=after["gameplay"].toObject();
  QVERIFY(!rules.contains("diets"));QVERIFY(!rules.contains("services"));
  QVERIFY(!rules["actions"].toArray().empty());QVERIFY(!rules["policyGroups"].toArray().empty());
  for(auto v:w.currentView()["diagnostics"].toArray())QVERIFY2(v.toObject()["severity"]!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView()["dirty"].toBool());
  StudioWindow reopened(engine);reopened.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!reopened.busy()&&!reopened.projectData().empty(),20000);QCOMPARE(reopened.projectData(),after);
}

