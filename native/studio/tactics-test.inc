void StudioTests::tacticsAuthoringRoundtrip(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_TACTICS_PROJECT",engine+"/.cache/tactics-author-"+QString::number(QDateTime::currentMSecsSinceEpoch()));QVERIFY(!QFileInfo::exists(root));QVERIFY(copyWorkspaceSample(engine+"/tests/fixtures/projects/data-ui-lab",root));
 StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);const auto before=w.projectData();bool authored=false;
 QTimer::singleShot(100,&w,[&]{auto* d=w.findChild<QDialog*>("tacticsDialog");if(!d)return;auto rows=[&](QString id,QList<QStringList> values){auto t=d->findChild<QTableWidget*>(id);t->setRowCount(0);for(const auto& row:values){d->findChild<QPushButton*>(id+"Add")->click();for(int c=0;c<row.size();c++)t->item(t->rowCount()-1,c)->setText(row[c]);}};
  rows("partyUnits",{{"vanguard","Vanguard","apprentice","party","player","0","0","80","12","4","20","strike,guard"},{"mage","Mage","mentor","party","player","1","0","60","5","2","30","spark,venom,mend"},{"wolf","Wolf","","wild","ai","0","0","24","7","1","10","bite"},{"hexer","Hexer","","wild","ai","1","0","20","4","0","8","venom"},{"guardian","Guardian","","wild","ai","0","0","70","10","3","6","bite"}});
  d->findChild<QTableWidget*>("partyUnits")->item(1,12)->setText("stamina");
  rows("partySkills",{{"strike","Strike","frontEnemy","damage","0","100","0","0",""},{"guard","Guard","self","status","0","100","0","0","shield"},{"spark","Cast Spark","allEnemies","damage","20","100","1","1",""},{"venom","Venom","enemy","damage","1","100","0","0","poison"},{"mend","Mend","ally","heal","15","100","0","0",""},{"bite","Bite","frontEnemy","damage","0","100","0","0",""}});
  rows("partyStatuses",{{"shield","Shield","3","0","0","0","5","false"},{"poison","Poison","3","2","0","0","0","false"}});
  rows("partyEncounters",{{"forest-party","Forest waves","vanguard,mage","wolf,hexer;guardian","12","flower:1"}});
  auto links=d->findChild<QTableWidget*>("partyLinks");for(int r=0;r<links->rowCount();r++){if(links->item(r,1)->text()=="clearing")links->item(r,2)->setText("forest-party");if(links->item(r,1)->text()=="entrance")links->item(r,5)->setText("clearing,sealed-path");}
  d->findChild<QPushButton*>("partyLinksAdd")->click();QStringList branch{"forest","sealed-path","","reputation","99","entrance","false","Sealed path"};for(int c=0;c<branch.size();c++)links->item(links->rowCount()-1,c)->setText(branch[c]);
  d->findChild<QTableWidget*>("partyQuests")->item(0,1)->setText("forest-party");d->findChild<QCheckBox*>("partyPlaceScreens")->setChecked(true);d->findChild<QSpinBox*>("partyGrowth-experiencePerLevel")->setValue(10);
  QDir().mkpath(engine+"/docs/evidence/tactics");d->findChild<QTabWidget*>("tacticsTabs")->setCurrentIndex(0);d->grab().save(engine+"/docs/evidence/tactics/authoring-units.png");d->findChild<QTabWidget*>("tacticsTabs")->setCurrentIndex(4);d->grab().save(engine+"/docs/evidence/tactics/authoring-branches.png");
  authored=true;d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();
 });QTimer::singleShot(30000,&w,[&]{if(auto d=w.findChild<QDialog*>("tacticsDialog"))d->reject();});w.findChild<QAction*>("editTactics")->trigger();QVERIFY(authored);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));const auto after=w.projectData();QCOMPARE(after.value("systems").toObject().value("tactics").toObject().value("units").toArray().size(),5);
 w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),before);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),after);
 w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError+QString::fromUtf8(QJsonDocument(w.currentView().value("diagnostics").toArray()).toJson())));w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData(),after);
 QFile proof(engine+"/.cache/tactics-proof.json");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(QJsonDocument(QJsonObject{{"project",root},{"guiEdited",true},{"saveReopen",true},{"undoRedo",true}}).toJson());
}

void StudioTests::tacticsPlayIntegration(){
 const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile proof(engine+"/.cache/tactics-proof.json");QVERIFY(proof.open(QIODevice::ReadOnly));const auto root=QJsonDocument::fromJson(proof.readAll()).object().value("project").toString();StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
 w.playAutomation=engine+"/docs/evidence/tactics/play-steps.json";w.playReport=engine+"/docs/evidence/tactics/editor-play-report.json";QVERIFY(QFileInfo::exists(w.playAutomation));QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,90000);QCOMPARE(finished.first().first().toInt(),0);
 QFile report(w.playReport);QVERIFY(report.open(QIODevice::ReadOnly));auto result=QJsonDocument::fromJson(report.readAll()).object();QVERIFY(result.value("ok").toBool());QJsonObject saved,loaded;bool victory=false;for(auto v:result.value("steps").toArray()){auto step=v.toObject();auto tag=step.value("command").toObject().value("checkpoint").toString();auto state=step.value("ui").toObject().value("state").toObject();if(tag=="victory"){QCOMPARE(state.value("systems").toObject().value("tactics").toObject().value("last").toObject().value("outcome").toString(),QString("victory"));victory=true;}if(tag=="saved")saved=state;if(tag=="restored")loaded=state;}QVERIFY(victory);QVERIFY(!saved.isEmpty());QCOMPARE(saved,loaded);w.grab().save(engine+"/docs/evidence/tactics/editor-play.png");
}
