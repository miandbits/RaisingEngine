// Activity rules and presentation share one local draft and one final transaction.
namespace {
class ActivityPresentationEditor final : public QWidget {
public:
  QJsonObject project,scene;
  QString activityId,activityLabel;
  QJsonArray assets;
  std::function<bool(QJsonObject&,QString)> editTimeline;
  QMap<QString,QComboBox*> links,sceneFields;
  QMap<QString,QPushButton*> editButtons,copyButtons;
  QComboBox *repeat;
  QLabel *context=nullptr,*summary=nullptr,*thumbnail=nullptr;
  bool filling=false;
  ActivityPresentationEditor(QJsonObject draft,QJsonObject activity,QJsonArray available,std::function<bool(QJsonObject&,QString)> editor,QWidget *parent)
      :QWidget(parent),project(draft),scene(activity.value("presentation").toObject()),activityId(activity.value("id").toString()),activityLabel(activity.value("label").toString()),assets(available),editTimeline(editor) {
    setObjectName("activityPresentationPage");auto box=new QVBoxLayout(this);
    context=new QLabel;context->setObjectName("activityPresentationContext");context->setWordWrap(true);box->addWidget(context);
    auto help=new QLabel(tr("활동 이름·비용·조건·효과와 연출을 함께 편집합니다. 연출 창의 저장은 이 임시 초안으로 돌아옵니다. 마지막에 적용하면 한 번에 되돌릴 수 있고, 취소하면 모두 버립니다."));help->setWordWrap(true);box->addWidget(help);
    auto sceneForm=new QFormLayout;sceneForm->setRowWrapPolicy(QFormLayout::WrapLongRows);box->addLayout(sceneForm);
    for(auto key:{QString("backgroundAssetId"),QString("musicAssetId"),QString("soundAssetId")}){
      auto combo=new QComboBox;combo->setObjectName("activityScene-"+key);combo->addItem(tr("이 항목은 변경하지 않음"),"__keep__");if(key!="soundAssetId")combo->addItem(tr("지우기"),"__clear__");
      for(auto v:assets){auto a=v.toObject();if(a["kind"]!=(key=="backgroundAssetId"?"image":"audio"))continue;auto id=a["id"].toString();combo->addItem(a.value("label").toString(a.value("name").toString(id)),id);combo->setItemData(combo->count()-1,id,Qt::ToolTipRole);}
      auto id=!scene.contains(key)?QString("__keep__"):scene[key].isNull()?QString("__clear__"):scene[key].toString();if(combo->findData(id)<0)combo->addItem(tr("없는 원본: ")+id,id);combo->setCurrentIndex(combo->findData(id));sceneFields[key]=combo;
      sceneForm->addRow(key=="backgroundAssetId"?tr("활동 배경"):key=="musicAssetId"?tr("배경 음악"):tr("효과음"),combo);
      QObject::connect(combo,&QComboBox::currentIndexChanged,this,[this,key,combo]{auto id=combo->currentData().toString();if(id=="__keep__")scene.remove(key);else scene[key]=id=="__clear__"?QJsonValue(QJsonValue::Null):QJsonValue(id);refreshSummary();});
    }
    thumbnail=new QLabel;thumbnail->setObjectName("activityPresentationThumbnail");thumbnail->setMinimumHeight(80);thumbnail->setMaximumHeight(140);thumbnail->setAlignment(Qt::AlignCenter);box->addWidget(thumbnail);
    auto form=new QFormLayout;form->setRowWrapPolicy(QFormLayout::WrapLongRows);box->addLayout(form);
    const QStringList keys{"timelineId","successTimelineId","failureTimelineId"},captions{tr("기본 연출"),tr("성공 연출 · 없으면 기본"),tr("실패 연출 · 없으면 기본")};
    for(int n=0;n<keys.size();++n){const auto key=keys[n];auto row=new QHBoxLayout;auto combo=new QComboBox;combo->setObjectName("activityTimeline-"+key);combo->setMinimumContentsLength(16);combo->setSizeAdjustPolicy(QComboBox::AdjustToMinimumContentsLengthWithIcon);links[key]=combo;row->addWidget(combo,1);
      auto edit=new QPushButton(tr("연출 편집…"));edit->setObjectName("activityTimelineEdit-"+key);editButtons[key]=edit;row->addWidget(edit);
      auto create=new QPushButton(tr("새 연출…"));create->setObjectName("activityTimelineCreate-"+key);row->addWidget(create);
      auto copy=new QPushButton(tr("이 활동용으로 복제"));copy->setObjectName("activityTimelineCopy-"+key);copyButtons[key]=copy;row->addWidget(copy);form->addRow(captions[n],row);
      QObject::connect(combo,&QComboBox::currentIndexChanged,this,[this]{if(!filling){storeLinks();refreshSummary();}});
      QObject::connect(edit,&QPushButton::clicked,this,[this,key]{auto id=links[key]->currentData().toString();if(id.isEmpty())return;auto candidate=project;if(editTimeline(candidate,id)){project=candidate;refill();}});
      QObject::connect(create,&QPushButton::clicked,this,[this,key]{auto candidate=project;auto visual=candidate["visual"].toObject();auto timelines=visual["timelines"].toArray();if(timelines.size()>=500){summary->setText(tr("연출은 최대 500개입니다."));return;}const auto id=nextId(timelines);QJsonObject clip{{"id","clip-1"},{"durationMs",1200},{"text","{activity}\n{outcome} · {changes}"},{"transition","none"}};if(scene["backgroundAssetId"].isString())clip["imageAssetId"]=scene["backgroundAssetId"];timelines.append(QJsonObject{{"id",id},{"name",activityLabel+tr(" 연출")},{"clips",QJsonArray{clip}}});visual["timelines"]=timelines;candidate["visual"]=visual;setLink(candidate,key,id);if(editTimeline(candidate,id)){project=candidate;refill();}});
      QObject::connect(copy,&QPushButton::clicked,this,[this,key]{auto source=links[key]->currentData().toString();auto visual=project["visual"].toObject();auto timelines=visual["timelines"].toArray();if(timelines.size()>=500){summary->setText(tr("연출은 최대 500개입니다."));return;}for(auto v:timelines)if(v.toObject()["id"]==source){auto copied=v.toObject();const auto id=nextId(timelines);copied["id"]=id;copied["name"]=activityLabel+tr(" 연출");timelines.append(copied);visual["timelines"]=timelines;project["visual"]=visual;setLink(project,key,id);refill();return;}});
    }
    repeat=new QComboBox;repeat->setObjectName("activityTimelineRepeat");repeat->addItem(tr("일정 칸당 한 번"),"once");repeat->addItem(tr("논리 날짜마다 반복"),"logicalDays");form->addRow(tr("재생 횟수"),repeat);QObject::connect(repeat,&QComboBox::currentIndexChanged,this,[this]{if(!filling){storeLinks();refreshSummary();}});
    summary=new QLabel;summary->setObjectName("activityPresentationSummary");summary->setWordWrap(true);summary->setTextInteractionFlags(Qt::TextSelectableByMouse);box->addWidget(summary);box->addStretch();refill();
  }
  static QString nextId(const QJsonArray &timelines){QSet<QString> ids;for(auto v:timelines)ids.insert(v.toObject()["id"].toString());int n=1;while(ids.contains(QString("activity-timeline-%1").arg(n)))++n;return QString("activity-timeline-%1").arg(n);}
  QJsonObject binding()const{for(auto v:project["visual"].toObject()["activityTimelines"].toArray())if(v.toObject()["activityId"]==activityId)return v.toObject();return {};}
  void setLink(QJsonObject &target,QString key,QString id){auto visual=target["visual"].toObject();auto bindings=visual["activityTimelines"].toArray();QJsonObject b;int found=-1;for(int n=0;n<bindings.size();++n)if(bindings[n].toObject()["activityId"]==activityId){b=bindings[n].toObject();found=n;break;}b["activityId"]=activityId;if(id.isEmpty())b.remove(key);else b[key]=id;if(found<0)bindings.append(b);else bindings[found]=b;visual["activityTimelines"]=bindings;target["visual"]=visual;}
  void storeLinks(){auto visual=project["visual"].toObject();auto bindings=visual["activityTimelines"].toArray();auto b=binding();const bool existed=!b.isEmpty();b["activityId"]=activityId;bool any=false;for(auto i=links.begin();i!=links.end();++i){auto id=i.value()->currentData().toString();if(id.isEmpty())b.remove(i.key());else{b[i.key()]=id;any=true;}}const auto repetitions=repeat->currentData().toString();if(!existed||b.contains("repeat")||repetitions!="once")b["repeat"]=repetitions;QJsonArray updated;bool found=false;for(auto v:bindings){if(v.toObject()["activityId"]!=activityId){updated.append(v);continue;}found=true;if(any)updated.append(b);}if(!found&&any)updated.append(b);if(updated.isEmpty())visual.remove("activityTimelines");else visual["activityTimelines"]=updated;project["visual"]=visual;}
  void refill(){filling=true;const auto b=binding();for(auto i=links.begin();i!=links.end();++i){auto combo=i.value();combo->clear();combo->addItem(tr("연결 없음"),QString());for(auto v:project["visual"].toObject()["timelines"].toArray()){auto t=v.toObject();combo->addItem(t["name"].toString(),t["id"].toString());combo->setItemData(combo->count()-1,t["id"].toString(),Qt::ToolTipRole);}auto id=b[i.key()].toString();if(combo->findData(id)<0)combo->addItem(tr("누락된 연출: ")+id,id);combo->setCurrentIndex(combo->findData(id));}repeat->setCurrentIndex(repeat->findData(b.value("repeat").toString("once")));filling=false;refreshSummary();}
  void refreshSummary(){if(!summary||!thumbnail)return;context->setText(tr("편집 중인 활동: %1").arg(activityLabel));QStringList lines;for(auto i=links.begin();i!=links.end();++i){const auto id=i.value()->currentData().toString();int uses=0;for(auto v:project["visual"].toObject()["activityTimelines"].toArray()){auto b=v.toObject();if(b["timelineId"]==id||b["successTimelineId"]==id||b["failureTimelineId"]==id)++uses;}bool exists=false;for(auto v:project["visual"].toObject()["timelines"].toArray())if(v.toObject()["id"]==id){exists=true;int duration=0;for(auto c:v.toObject()["clips"].toArray())duration+=c.toObject()["durationMs"].toInt();lines<<tr("%1 · %2개 클립 · %3초 · 사용 활동 %4개").arg(v.toObject()["name"].toString()).arg(v.toObject()["clips"].toArray().size()).arg(duration/1000.0,0,'f',1).arg(uses);}editButtons[i.key()]->setEnabled(exists);copyButtons[i.key()]->setEnabled(exists);editButtons[i.key()]->setText(uses>1?tr("공유 연출 편집…"):tr("연출 편집…"));}lines.removeDuplicates();if(lines.isEmpty())lines<<tr("연출을 연결하면 활동 뒤에 이미지·문구·성장 결과를 보여줄 수 있습니다.");else lines<<tr("공유 연출을 편집하면 연결된 모든 활동이 바뀝니다. 이 활동만 바꾸려면 먼저 복제하세요.");summary->setText(lines.join('\n'));thumbnail->clear();const auto image=scene["backgroundAssetId"].toString();for(auto v:assets)if(v.toObject()["id"]==image){QPixmap pix(v.toObject()["absolutePath"].toString());if(!pix.isNull())thumbnail->setPixmap(pix.scaled(300,130,Qt::KeepAspectRatio,Qt::SmoothTransformation));}thumbnail->setVisible(!image.isEmpty());}
  QString validation()const{const auto b=binding();if(b["timelineId"].toString().isEmpty()&&(!b["successTimelineId"].toString().isEmpty()||!b["failureTimelineId"].toString().isEmpty()))return tr("성공·실패 연출을 사용하려면 기본 연출도 연결하세요.");for(auto key:{"timelineId","successTimelineId","failureTimelineId"}){auto id=b[key].toString();if(id.isEmpty())continue;bool found=false;for(auto v:project["visual"].toObject()["timelines"].toArray())if(v.toObject()["id"]==id)found=true;if(!found)return tr("누락된 연출 연결을 수정하세요: ")+id;}if(b["repeat"]=="logicalDays"&&!project["gameplay"].toObject().contains("ruleCalendar"))return tr("날짜별 반복에는 논리 일자 달력을 켜야 합니다.");return {};}
};
}

void StudioWindow::editActivityWorkflow(QString activityId){
  if(bridge.busy()||projectData().isEmpty())return;
  if(auto workspace=findChild<QDockWidget*>("authoringWorkspaceDock");workspace&&workspace->property("workspaceInputPending").toBool()){const auto message=tr("작업실의 입력을 먼저 적용하거나 취소한 뒤 활동 편집기를 여세요.");errorLabel->setText(message);if(auto status=workspace->findChild<QLabel*>("workspaceStatus"))status->setText(message);workspace->show();workspace->raise();return;}
  if(auto focus=QApplication::focusWidget())focus->clearFocus();if(!waitForPendingEdits())return;
  const auto documents=view.value("documents").toArray();QString selectedFile;
  if(activityId.isEmpty()&&contentList->currentItem())for(auto value:documents){auto doc=value.toObject();if(doc["kind"]=="activity"&&doc["file"]==contentList->currentItem()->data(Qt::UserRole).toString())activityId=doc["data"].toObject()["id"].toString();}
  if(activityId.isEmpty())if(auto tree=findChild<QTreeWidget*>("workspaceEntities"))if(auto item=tree->currentItem()){auto selected=item->data(0,Qt::UserRole).toJsonObject();if(selected["kind"]=="activity")activityId=selected["id"].toString();}
  if(activityId.isEmpty())activityId=property("activityWorkflowSelection").toString();
  bool exists=false;for(auto value:documents){auto doc=value.toObject();if(doc["kind"]=="activity"&&doc["data"].toObject()["id"]==activityId)exists=true;}if(!exists)activityId.clear();
  if(activityId.isEmpty()){
    QDialog dialog(this);dialog.setObjectName("activityWorkflowPicker");dialog.setWindowTitle(tr("편집할 활동 선택"));auto box=new QVBoxLayout(&dialog);auto search=new QLineEdit;search->setObjectName("activityWorkflowSearch");search->setPlaceholderText(tr("활동 이름 검색"));box->addWidget(search);auto list=new QListWidget;list->setObjectName("activityWorkflowActivities");box->addWidget(list);for(auto value:documents){auto doc=value.toObject();if(doc["kind"]!="activity")continue;auto activity=doc["data"].toObject();auto item=new QListWidgetItem(activity["label"].toString(),list);item->setData(Qt::UserRole,activity["id"].toString());item->setToolTip(activity["id"].toString());}if(list->count())list->setCurrentRow(0);auto buttons=new QDialogButtonBox(QDialogButtonBox::Open|QDialogButtonBox::Cancel);box->addWidget(buttons);connect(search,&QLineEdit::textChanged,&dialog,[=](QString text){QListWidgetItem *first=nullptr;for(int n=0;n<list->count();++n){auto item=list->item(n);item->setHidden(!item->text().contains(text,Qt::CaseInsensitive));if(!first&&!item->isHidden())first=item;}list->setCurrentItem(first);buttons->button(QDialogButtonBox::Open)->setEnabled(first);});connect(buttons,&QDialogButtonBox::accepted,&dialog,[&]{if(list->currentItem()&&!list->currentItem()->isHidden())dialog.accept();});connect(buttons,&QDialogButtonBox::rejected,&dialog,&QDialog::reject);connect(list,&QListWidget::itemActivated,&dialog,[&]{dialog.accept();});dialog.resize(480,400);if(dialog.exec()!=QDialog::Accepted||!list->currentItem())return;activityId=list->currentItem()->data(Qt::UserRole).toString();
  }
  for(auto value:documents){auto doc=value.toObject();if(doc["kind"]=="activity"&&doc["data"].toObject()["id"]==activityId)selectedFile=doc["file"].toString();}if(selectedFile.isEmpty())return;
  for(int n=0;n<contentList->count();++n){auto item=contentList->item(n);if(item->data(Qt::UserRole)!=selectedFile)continue;if(item->isHidden())if(auto search=findChild<QLineEdit*>("contentSearch"))search->clear();contentList->setCurrentItem(item);setProperty("activityWorkflowSelection",activityId);editContent();return;}
}
