namespace {
void openHudScreen(StudioWindow &w,const QString &id){
  auto list=w.findChild<QListWidget*>("projectList");
  for(int i=0;i<list->count();i++)if(list->item(i)->data(Qt::UserRole)==id){auto item=list->item(i);list->scrollToItem(item);QTest::mouseClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());QTest::mouseDClick(list->viewport(),Qt::LeftButton,Qt::NoModifier,list->visualItemRect(item).center());return;}
  QFAIL("HUD screen missing");
}
QJsonObject hudScreen(StudioWindow &w,const QString &id){for(auto s:w.projectData().value("visual").toObject().value("screens").toArray())if(s.toObject().value("id")==id)return s.toObject();return {};}
void editHudDialog(StudioWindow &w,std::function<void(QDialog*)> fn){
  QTimer::singleShot(100,&w,[fn]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QCOMPARE(d->objectName(),QString("battleHudDialog"));QTimer::singleShot(15000,d,&QDialog::reject);fn(d);});w.findChild<QAction*>("editBattleHud")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
}
void selectHudElement(StudioWindow &w,const QString &id){auto tree=w.findChild<QTreeWidget*>("hierarchy");for(int r=0;r<tree->topLevelItemCount();r++){auto root=tree->topLevelItem(r);for(int i=0;i<root->childCount();i++){auto item=root->child(i);if(item->data(0,Qt::UserRole)!=id)continue;tree->scrollToItem(item);QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(item).center());return;}}QFAIL("Missing HUD element");}
}
void StudioTests::battleHudAuthoring(){
  const auto root=qEnvironmentVariable("RAISING_BATTLE_HUD_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_BATTLE_HUD_PROJECT to a fresh timeline-lab copy");const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1520,1020);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);
  const auto evidence=engine+"/.cache/qt-battle-hud-evidence";QDir().mkpath(evidence);openHudScreen(w,"battle");const auto before=w.projectData();
  editHudDialog(w,[&](QDialog*d){d->findChild<QPushButton*>("battleHudPreset")->click();auto table=d->findChild<QTableWidget*>("battleHudLayout");QCOMPARE(table->rowCount(),6);table->item(0,1)->setText("Ally vitals");d->findChild<QPushButton*>("battleHudPreset")->click();QCOMPARE(table->rowCount(),6);QVERIFY(!d->findChild<QLabel*>("battleHudError")->text().isEmpty());d->findChild<QSpinBox*>("battleHudHistoryLimit")->setValue(64);d->grab().save(evidence+"/workshop.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  auto authored=w.projectData();QCOMPARE(authored.value("systems").toObject().value("battleHistoryLimit").toInt(),64);QVERIFY(authored!=before);w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),before);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),authored);
  int collections=0;QString component;for(auto e:hudScreen(w,"battle").value("elements").toArray()){auto o=e.toObject();QVERIFY(o.value("kind")!="battle");if(o.value("kind")=="collection")collections++;if(o.value("id")=="hud-ally")component=o.value("componentId").toString();}QCOMPARE(collections,6);
  // Change the shared actor meter through the component editor; both actor lists keep its reference.
  QTimer::singleShot(100,&w,[&]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);auto list=d->findChild<QListWidget*>("componentLibrary");int index=-1;auto cs=w.projectData().value("visual").toObject().value("components").toArray();for(int i=0;i<cs.size();i++)if(cs[i].toObject().value("id")==component)index=i;QVERIFY(index>=0);list->setCurrentRow(index);auto children=d->findChild<QListWidget*>("componentChildren");for(int i=0;i<children->count();i++)if(children->item(i)->text().startsWith("hp ·"))children->setCurrentRow(i);d->findChild<QLineEdit*>("child-fill")->setText("#16242e");d->findChild<QLineEdit*>("child-color")->setText("#69c9b4");d->findChild<QPushButton*>("applyComponentChild")->click();d->grab().save(evidence+"/shared-meter.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editComponents")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  for(auto e:hudScreen(w,"battle").value("elements").toArray())if(e.toObject().value("source").toObject().value("type")=="battleActors")QCOMPARE(e.toObject().value("componentId").toString(),component);
  w.grab().save(evidence+"/battle-canvas.png");
  // Author post-battle projections on the expedition screen, which owns the victory phase.
  openHudScreen(w,"expedition");selectHudElement(w,"expedition-stages");QMetaObject::invokeMethod(w.findChild<ScreenCanvas*>(),"deleteSelected");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  editHudDialog(w,[&](QDialog*d){auto source=d->findChild<QComboBox*>("battleHudSource");for(auto type:{"battleLog","battleRewards"}){source->setCurrentIndex(source->findData(type));d->findChild<QPushButton*>("battleHudAdd")->click();}auto table=d->findChild<QTableWidget*>("battleHudLayout");QCOMPARE(table->rowCount(),2);for(int r=0;r<2;r++){qobject_cast<QSpinBox*>(table->cellWidget(r,3))->setValue(830);qobject_cast<QSpinBox*>(table->cellWidget(r,4))->setValue(r?465:125);qobject_cast<QSpinBox*>(table->cellWidget(r,5))->setValue(370);qobject_cast<QSpinBox*>(table->cellWidget(r,6))->setValue(r?180:320);}d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  w.grab().save(evidence+"/rewards-canvas.png");for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView().value("dirty").toBool());authored=w.projectData();StudioWindow reopened(engine);reopened.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!reopened.busy()&&!reopened.projectData().empty(),20000);QCOMPARE(reopened.projectData(),authored);QFile file(evidence+"/authored-project.json");QVERIFY(file.open(QIODevice::WriteOnly));file.write(QJsonDocument(authored).toJson());
}
void StudioTests::battleHudRoundtrip(){
  const auto root=qEnvironmentVariable("RAISING_BATTLE_HUD_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_BATTLE_HUD_PROJECT to an authored HUD sample");StudioWindow w(qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()));w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);openHudScreen(w,"battle");const auto before=w.projectData();
  editHudDialog(w,[](QDialog*d){auto table=d->findChild<QTableWidget*>("battleHudLayout");QCOMPARE(table->rowCount(),6);d->findChild<QPushButton*>("battleHudAdd")->click();QCOMPARE(table->rowCount(),7);table->setCurrentCell(6,0);d->findChild<QPushButton*>("battleHudRemove")->click();QCOMPARE(table->rowCount(),6);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});QCOMPARE(w.projectData(),before);
  // Source, meter bindings and the ally filter survive the general data UI editor.
  QTimer::singleShot(100,&w,[]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);auto entry=d->findChild<QComboBox*>("dataUiEntry");entry->setCurrentIndex(entry->findData("hud-ally"));QCOMPARE(d->findChild<QComboBox*>("dataUiSource")->currentData().toString(),QString("battleActors"));QCOMPARE(d->findChild<QComboBox*>("dataUiFilterField")->currentData().toString(),QString("side"));d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editDataUi")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
}
void StudioTests::battleHudGuards(){
  const auto root=qEnvironmentVariable("RAISING_BATTLE_HUD_GUARD_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_BATTLE_HUD_GUARD_PROJECT to the small-canvas regression fixture");StudioWindow w(qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()));w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);openHudScreen(w,"battle");QJsonObject collision;for(auto v:hudScreen(w,"battle").value("elements").toArray())if(v.toObject().value("id")=="hud-enemy")collision=v.toObject();QVERIFY(!collision.empty());
  editHudDialog(w,[](QDialog*d){d->findChild<QPushButton*>("battleHudPreset")->click();auto t=d->findChild<QTableWidget*>("battleHudLayout");QCOMPARE(t->rowCount(),7);QCOMPARE(qobject_cast<QSpinBox*>(t->cellWidget(0,7))->value(),40);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});
  for(auto v:hudScreen(w,"battle").value("elements").toArray()){const auto e=v.toObject();if(e.value("id")=="hud-enemy")QCOMPARE(e,collision);else if(e.value("id").toString().startsWith("hud-")){QVERIFY(e.value("x").toInt()+e.value("width").toInt()<=640);QVERIFY(e.value("y").toInt()+e.value("height").toInt()<=360);}}
  for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
}
