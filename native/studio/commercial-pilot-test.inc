void pilotScreen(StudioWindow& w,const QString& id){auto list=w.findChild<QListWidget*>("projectList");QVERIFY(list);for(int i=0;i<list->count();++i)if(list->item(i)->data(Qt::UserRole)==id){list->setCurrentRow(i);list->itemDoubleClicked(list->item(i));return;}QFAIL(qPrintable(id));}
void pilotElement(StudioWindow& w,const QString& id){auto tree=w.findChild<QTreeWidget*>("hierarchy");QVERIFY(tree);tree->clearSelection();for(QTreeWidgetItemIterator it(tree);*it;++it)if((*it)->data(0,Qt::UserRole)==id){tree->setCurrentItem(*it);(*it)->setSelected(true);return;}QFAIL(qPrintable(id));}

void pilotComparison(QDialog& editor,QStringList path,QString kind,QString id,int minimum){
 QVERIFY(logicTestSelect(editor,path));QVERIFY(logicTestChoose(editor,"logicType","compare"));QVERIFY(logicTestChoose(editor,"logic-comparator","gte"));
 QVERIFY(logicTestSelect(editor,path+QStringList{"left"}));QVERIFY(logicTestChoose(editor,"logicType","read"));QVERIFY(logicTestSelect(editor,path+QStringList{"left","target"}));QVERIFY(logicTestChoose(editor,"logicType",kind));
 if(kind=="relationship"){QVERIFY(logicTestChoose(editor,"logic-characterId","mentor"));QVERIFY(logicTestChoose(editor,"logic-relationshipId",id));}else QVERIFY(logicTestChoose(editor,"logic-attributeId",id));
 QVERIFY(logicTestSelect(editor,path+QStringList{"right"}));QVERIFY(logicTestChoose(editor,"logicType","literal"));QVERIFY(logicTestNumber(editor,"value",minimum));
}
