#include <QTemporaryDir>

namespace {
QJsonObject userFieldElement(const StudioWindow &w,const QString &id){for(auto s:w.projectData().value("visual").toObject().value("screens").toArray())for(auto e:s.toObject().value("elements").toArray())if(e.toObject().value("id")==id)return e.toObject();return {};}
void addUserFieldElement(StudioWindow &w,const QString &label){auto palette=w.findChild<QToolButton*>("elementPalette");for(auto action:palette->menu()->actions())if(action->text()==label){action->trigger();return;}QFAIL("element palette action not found");}
}

void StudioTests::userFieldsAuthoringRoundtrip(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QTemporaryDir temp(engine+"/.cache/qt-user-fields-XXXXXX");QVERIFY(temp.isValid());QVERIFY(copyScreenSettingsFixture(engine+"/examples/academy-visual",temp.path()));
  StudioWindow w(engine);w.show();w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);selectSettingsScreen(w,"title");const auto before=w.projectData();
  QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("userFieldsDialog");QVERIFY(d);QTimer::singleShot(15000,d,&QDialog::reject);d->findChild<QPushButton*>("userFieldAdd")->click();auto table=d->findChild<QTableWidget*>("userFieldsTable");QCOMPARE(table->rowCount(),1);table->item(0,0)->setText("player-name");table->item(0,1)->setText(QString::fromUtf8("주인공 이름"));table->item(0,2)->setText(QString::fromUtf8("미😀"));qobject_cast<QSpinBox*>(table->cellWidget(0,3))->setValue(2);qobject_cast<QSpinBox*>(table->cellWidget(0,4))->setValue(2);d->findChild<QDialogButtonBox*>("userFieldsButtons")->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editUserFields")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto fields=w.projectData().value("userFields").toArray();QCOMPARE(fields.size(),1);QCOMPARE(fields[0].toObject().value("initial").toString(),QString::fromUtf8("미😀"));const auto withFields=w.projectData();
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),before);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),withFields);
  addUserFieldElement(w,QString::fromUtf8("사용자 입력란 · 새 게임"));QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&w.selectedId().startsWith("input-"),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));const auto inputId=w.selectedId();QCOMPARE(userFieldElement(w,inputId).value("userFieldId").toString(),QString("player-name"));QVERIFY(w.findChild<QComboBox*>("bindingUserField")->isEnabled());
  addUserFieldElement(w,QString::fromUtf8("텍스트"));QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&w.selectedId().startsWith("text-"),10000);const auto textId=w.selectedId();auto binding=w.findChild<QComboBox*>("textBinding");const int index=binding->findData("user-field");QVERIFY(index>=0);binding->setCurrentIndex(index);QMetaObject::invokeMethod(binding,"activated",Q_ARG(int,index));QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));QCOMPARE(userFieldElement(w,textId).value("userFieldId").toString(),QString("player-name"));QCOMPARE(userFieldElement(w,textId).value("valueFormat").toString(),QString("{value}"));
  auto format=w.findChild<QLineEdit*>("valueFormat");QVERIFY(format->isEnabled());format->setText(QString::fromUtf8("이름: {value}"));QMetaObject::invokeMethod(format,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(userFieldElement(w,textId).value("valueFormat").toString(),QString::fromUtf8("이름: {value}"));const auto authored=w.projectData();
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(w.projectData(),authored);
  const auto revision=w.currentView().value("revision");QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("userFieldsDialog");QVERIFY(d);d->findChild<QDialogButtonBox*>("userFieldsButtons")->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editUserFields")->trigger();QCOMPARE(w.currentView().value("revision"),revision);
  QTimer::singleShot(100,&w,[&]{auto d=w.findChild<QDialog*>("userFieldsDialog");QVERIFY(d);auto table=d->findChild<QTableWidget*>("userFieldsTable");table->setCurrentCell(0,0);d->findChild<QPushButton*>("userFieldRemove")->click();d->findChild<QDialogButtonBox*>("userFieldsButtons")->button(QDialogButtonBox::Save)->click();QVERIFY(d->isVisible());QVERIFY(!d->findChild<QLabel*>("userFieldsError")->text().isEmpty());d->reject();});w.findChild<QAction*>("editUserFields")->trigger();QCOMPARE(w.projectData(),authored);
}

