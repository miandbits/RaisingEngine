  StudioWindow w(engine);w.show();w.openProject(temp.path());QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);selectSettingsScreen(w,"title");const auto before=w.projectData();
  addUserFieldElement(w,QString::fromUtf8("사용자 입력란 · 새 게임"));QCOMPARE(w.projectData(),before);
