void StudioTests::unifiedTimeAuthoring(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());
  const auto root=qEnvironmentVariable("RAISING_UNIFIED_PROJECT",engine+"/.cache/unified-time-"+QString::number(QDateTime::currentMSecsSinceEpoch()));QVERIFY(!QFileInfo::exists(root));
  StudioWindow w(engine);w.show();
  QTimer::singleShot(50,&w,[&]{auto d=w.findChild<QDialog*>("newProjectDialog");QVERIFY(d);auto mode=d->findChild<QComboBox*>("newProjectTemplate");mode->setCurrentIndex(mode->findData("existing"));d->findChild<QLineEdit*>("newProjectSource")->setText(engine+"/tests/fixtures/projects/time-session-demo");d->findChild<QLineEdit*>("newProjectDestination")->setText(root);d->findChild<QDialogButtonBox*>("newProjectButtons")->button(QDialogButtonBox::Ok)->click();});w.findChild<QAction*>("newProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  const auto before=w.projectData().value("progression");
  const auto evidence=engine+"/.cache/unified-time";QDir().mkpath(evidence);
  QTimer::singleShot(50,&w,[&]{auto d=w.findChild<QDialog*>("timeSessionsDialog");QVERIFY(d);d->findChild<QComboBox*>("timeModel")->setCurrentIndex(1);d->findChild<QSpinBox*>("timeTicksPerPeriod")->setValue(10);d->findChild<QCheckBox*>("timeParallel")->setChecked(true);
    auto actors=d->findChild<QTableWidget*>("timeActors");QCOMPARE(actors->rowCount(),2);for(int i=0;i<actors->rowCount();++i)if(actors->item(i,1)->data(Qt::UserRole).toString()=="trainee-2"){qobject_cast<QCheckBox*>(actors->cellWidget(i,0))->setChecked(true);qobject_cast<QSpinBox*>(actors->cellWidget(i,2))->setValue(4);qobject_cast<QSpinBox*>(actors->cellWidget(i,3))->setValue(3);qobject_cast<QSpinBox*>(actors->cellWidget(i,4))->setValue(0);}
    auto activities=d->findChild<QTableWidget*>("timedActivities");for(int i=0;i<activities->rowCount();++i)if(QStringList{"study","rest"}.contains(activities->item(i,1)->data(Qt::UserRole).toString())){qobject_cast<QCheckBox*>(activities->cellWidget(i,0))->setChecked(true);qobject_cast<QSpinBox*>(activities->cellWidget(i,2))->setValue(1);}
    auto appointments=d->findChild<QTableWidget*>("timeAppointments");QCOMPARE(appointments->rowCount(),1);qobject_cast<QSpinBox*>(appointments->cellWidget(0,4))->setValue(2);qobject_cast<QSpinBox*>(appointments->cellWidget(0,5))->setValue(1);
    d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();QVERIFY(d->isVisible());QVERIFY(!d->findChild<QLabel*>("timeError")->text().isEmpty());qobject_cast<QSpinBox*>(appointments->cellWidget(0,5))->setValue(3);d->findChild<QTabWidget*>()->setCurrentIndex(3);d->grab().save(evidence+"/authoring.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();
  });w.findChild<QAction*>("editTimeSessions")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));const auto authored=w.projectData().value("progression");QCOMPARE(authored.toObject().value("model").toString(),QString("unified-v2"));
  w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),before);w.findChild<QAction*>("redoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),authored);
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),authored);
  QTimer::singleShot(50,&w,[&]{auto d=w.findChild<QDialog*>("timeSessionsDialog");QVERIFY(d);QCOMPARE(d->findChild<QComboBox*>("timeModel")->currentIndex(),1);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editTimeSessions")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);QCOMPARE(w.projectData().value("progression"),authored);
  w.findChild<QAction*>("validateProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),15000);for(const auto &d:w.currentView().value("diagnostics").toArray())QVERIFY2(d.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(d.toObject()).toJson())));
  QFile proof(engine+"/.cache/unified-project.txt");QVERIFY(proof.open(QIODevice::WriteOnly));proof.write(root.toUtf8());
}
void StudioTests::unifiedTimePlay(){
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());QFile proof(engine+"/.cache/unified-project.txt");QVERIFY(proof.open(QIODevice::ReadOnly));const auto root=QString::fromUtf8(proof.readAll()).trimmed();
  QProcess prepare;auto env=QProcessEnvironment::systemEnvironment();env.insert("RAISING_UNIFIED_PROJECT",root);prepare.setProcessEnvironment(env);prepare.setWorkingDirectory(engine);prepare.start("node",{"--test","tests/native-player/unified-time.test.mjs"});QVERIFY(prepare.waitForStarted());QVERIFY(prepare.waitForFinished(180000));QVERIFY2(prepare.exitCode()==0,qPrintable(QString::fromUtf8(prepare.readAllStandardOutput()+prepare.readAllStandardError())));
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);w.playAutomation=engine+"/.cache/unified-time/steps.json";w.playReport=engine+"/.cache/unified-time/editor-report.json";QSignalSpy finished(&w,&StudioWindow::playerFinished);w.findChild<QAction*>("playProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(finished.count()>0,120000);QCOMPARE(finished.first().first().toInt(),0);QFile report(w.playReport);QVERIFY(report.open(QIODevice::ReadOnly));const auto result=QJsonDocument::fromJson(report.readAll()).object();QVERIFY(result.value("ok").toBool());bool found=false;for(const auto &v:result.value("steps").toArray())if(v.toObject().value("command").toObject().value("checkpoint")=="calendar-complete"){auto state=v.toObject().value("ui").toObject().value("state").toObject();QCOMPARE(state.value("progression").toObject().value("tick").toInt(),10);QCOMPARE(state.value("periodIndex").toInt(),1);found=true;}QVERIFY(found);
}
