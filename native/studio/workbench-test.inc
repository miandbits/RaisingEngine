namespace {
void selectWorkbenchElement(StudioWindow&w,const QString&id){auto tree=w.findChild<QTreeWidget*>("hierarchy");QTreeWidgetItemIterator it(tree);while(*it){if((*it)->data(0,Qt::UserRole)==id){tree->scrollToItem(*it);QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(*it).center());return;}++it;}QFAIL("Missing workbench element");}
QJsonObject workbenchElement(StudioWindow&w,const QString&id){for(auto s:w.projectData().value("visual").toObject().value("screens").toArray())for(auto e:s.toObject().value("elements").toArray())if(e.toObject().value("id")==id)return e.toObject();return {};}
}
void StudioTests::workbenchAnalysisHistory(){
  const auto root=qEnvironmentVariable("RAISING_WORKBENCH_PROJECT");if(root.isEmpty())QSKIP("Set disposable RAISING_WORKBENCH_PROJECT");StudioWindow w(qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()));w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);w.findChild<QAction*>("showAnalysis")->trigger();auto pane=w.findChild<QWidget*>("analysisPane");QTest::qWait(500);auto runs=pane->findChild<QTableWidget*>("analysisRunTable");auto start=pane->findChild<QPushButton*>("analysisStart");auto progress=pane->findChild<QProgressBar*>("analysisProgress");for(int count:{2,3}){pane->findChild<QSpinBox*>("analysisRuns")->setValue(count);pane->findChild<QLineEdit*>("analysisSeed")->setText(QString::number(800+count));start->click();QTRY_VERIFY_WITH_TIMEOUT(progress->maximum()==count&&progress->value()==count&&start->isEnabled(),30000);QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()==count,10000);QCOMPARE(runs->item(0,1)->text(),QString::number(800+count));QVERIFY(pane->findChild<QComboBox*>("analysisHistory")->currentText().contains(QString::number(count)+QStringLiteral("회")));}
}
void StudioTests::workbenchValidationHierarchy(){
  const auto root=qEnvironmentVariable("RAISING_WORKBENCH_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_WORKBENCH_PROJECT to a fresh battle-hud-lab copy");auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1520,1020);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);const auto evidence=engine+"/.cache/qt-workbench-evidence";QDir().mkpath(evidence);
  auto number=[&](const char*key,int n){auto f=w.findChild<QSpinBox*>(key);QVERIFY(f);f->setValue(n);QMetaObject::invokeMethod(f,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);};
  w.findChild<QAction*>("validateProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(w.findChild<QLabel*>("validationSummary")->text().contains("오류 0건"));QCOMPARE(w.findChild<QTabWidget*>("bottomTabs")->currentIndex(),2);
  w.findChild<QAction*>("addButton")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);const auto button=w.selectedId();number("elementWidth",1500);QVERIFY(w.findChild<QLabel*>("validationSummary")->text().contains("다시 검증"));w.findChild<QAction*>("validateProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.findChild<QLabel*>("validationSummary")->text().contains("오류 0건"));auto problems=w.findChild<QListWidget*>("problems");QVERIFY(problems->count()>0);QTest::mouseClick(problems->viewport(),Qt::LeftButton,Qt::NoModifier,problems->visualItemRect(problems->item(0)).center());QCOMPARE(w.selectedId(),button);w.grab().save(evidence+"/validation-error.png");number("elementWidth",240);
  auto text=w.findChild<QLineEdit*>("buttonText");text->setText("Hierarchy city button");QMetaObject::invokeMethod(text,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);auto target=w.findChild<QComboBox*>("actionTarget");target->setCurrentIndex(target->findData("city"));QMetaObject::invokeMethod(target,"activated",Q_ARG(int,target->currentIndex()));QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  number("elementX",40);number("elementY",40);w.findChild<QPushButton*>("addGroup")->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);const auto group=w.selectedId();number("elementWidth",360);number("elementHeight",140);auto name=w.findChild<QLineEdit*>("elementName");name->setText("Navigation group");QMetaObject::invokeMethod(name,"editingFinished");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  selectWorkbenchElement(w,button);auto parent=w.findChild<QComboBox*>("elementParent");parent->setCurrentIndex(parent->findData(group));QMetaObject::invokeMethod(parent,"activated",Q_ARG(int,parent->currentIndex()));QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QCOMPARE(workbenchElement(w,button).value("parentId").toString(),group);QCOMPARE(workbenchElement(w,button).value("x").toInt(),40);
  selectWorkbenchElement(w,group);number("elementX",100);number("elementY",420);auto visual=w.projectData().value("visual").toObject();auto elements=hudScreen(w,"home").value("elements").toArray();auto projected=canvasElements(visual,elements,QSize(1280,720));QJsonObject child;for(auto e:projected)if(e.toObject().value("id")==button)child=e.toObject();QCOMPARE(child.value("x").toInt(),140);QCOMPARE(child.value("y").toInt(),460);w.findChild<QCheckBox*>("clipChildren")->setChecked(true);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  // A nested child can overflow locally and is clipped; reparenting back restores world coordinates.
  selectWorkbenchElement(w,button);number("elementX",-12);QCOMPARE(workbenchElement(w,button).value("x").toInt(),-12);number("elementX",40);
  selectWorkbenchElement(w,group);QMetaObject::invokeMethod(w.findChild<ScreenCanvas*>(),"duplicateSelected");QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);const auto copy=w.selectedId();QVERIFY(copy!=group);QVERIFY(!workbenchElement(w,button+"-copy1").empty());QCOMPARE(workbenchElement(w,button+"-copy1").value("parentId").toString(),copy);w.findChild<QAction*>("undoEdit")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(workbenchElement(w,copy).empty());selectWorkbenchElement(w,group);
  w.findChild<QCheckBox*>("elementHidden")->setChecked(true);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);projected=canvasElements(w.projectData().value("visual").toObject(),hudScreen(w,"home").value("elements").toArray(),QSize(1280,720));for(auto e:projected)if(e.toObject().value("id")==button)QVERIFY(e.toObject().value("hidden").toBool());w.findChild<QCheckBox*>("elementHidden")->setChecked(false);QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);
  w.findChild<QAction*>("validateProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(w.findChild<QLabel*>("validationSummary")->text().contains("오류 0건"));w.grab().save(evidence+"/hierarchy.png");w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);auto authored=w.projectData();StudioWindow reopened(engine);reopened.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!reopened.busy()&&!reopened.projectData().empty(),20000);QCOMPARE(reopened.projectData(),authored);
}
void StudioTests::workbenchAnalysis5000(){
  const auto root=qEnvironmentVariable("RAISING_WORKBENCH_ANALYSIS_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_WORKBENCH_ANALYSIS_PROJECT for the actual 5000-run GUI acceptance");auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1520,1020);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);const auto evidence=engine+"/.cache/qt-workbench-evidence";QDir().mkpath(evidence);w.findChild<QAction*>("showAnalysis")->trigger();auto pane=w.findChild<QWidget*>("analysisPane");QVERIFY(pane);auto start=pane->findChild<QPushButton*>("analysisStart");auto progress=pane->findChild<QProgressBar*>("analysisProgress");pane->findChild<QSpinBox*>("analysisRuns")->setValue(5000);pane->findChild<QSpinBox*>("analysisWorkers")->setValue(4);pane->findChild<QLineEdit*>("analysisSeed")->setText("4242");QTest::qWait(1000);if(!qEnvironmentVariableIsSet("RAISING_WORKBENCH_REOPEN_ONLY"))start->click();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));
  QTimer report;report.setInterval(15000);connect(&report,&QTimer::timeout,&w,[&]{qInfo("Analysis progress %d/%d",progress->value(),progress->maximum());});report.start();QTRY_VERIFY_WITH_TIMEOUT(progress->value()==5000&&start->isEnabled(),1800000);report.stop();auto summary=pane->findChild<QLabel*>("analysisSummary");QVERIFY(summary->text().contains("5000 / 5000"));auto mapMode=pane->findChild<QComboBox*>("analysisMapMode");mapMode->setCurrentIndex(mapMode->findData("graph"));QMetaObject::invokeMethod(mapMode,"activated",Q_ARG(int,mapMode->currentIndex()));auto graph=pane->findChild<QGraphicsView*>("analysisGraph");QVERIFY(graph->scene()->items().size()>50);auto runs=pane->findChild<QTableWidget*>("analysisRunTable");QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()>0,10000);pane->grab().save(evidence+"/analysis-5000-map.png");
  auto kind=pane->findChild<QComboBox*>("analysisKind");kind->setCurrentIndex(kind->findData("ending"));QMetaObject::invokeMethod(kind,"activated",Q_ARG(int,kind->currentIndex()));QGraphicsItem* endingNode=nullptr;for(auto item:graph->scene()->items())if(item->data(1)=="node"){endingNode=item;break;}QVERIFY(endingNode);graph->centerOn(endingNode);QTest::qWait(100);QTest::mouseClick(graph->viewport(),Qt::LeftButton,Qt::NoModifier,graph->mapFromScene(endingNode->sceneBoundingRect().center()));QTest::qWait(500);QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()>0,10000);QVERIFY(pane->findChild<QLabel*>("analysisNodeInfo")->text().contains("회차"));pane->grab().save(evidence+"/analysis-ending-filter.png");
  runs->setCurrentCell(0,0);pane->findChild<QPushButton*>("analysisOpenRun")->click();auto route=pane->findChild<QTableWidget*>("analysisRouteTable");QTRY_VERIFY_WITH_TIMEOUT(route->rowCount()>0,10000);auto info=pane->findChild<QLabel*>("analysisReplayInfo");QTRY_VERIFY_WITH_TIMEOUT(info->text().contains("명령 0 /"),10000);auto step=pane->findChild<QSpinBox*>("analysisStep");QVERIFY(step->maximum()>10);pane->findChild<QPushButton*>("analysisForward")->click();QTRY_VERIFY_WITH_TIMEOUT(info->text().contains("명령 1 /"),10000);pane->findChild<QPushButton*>("analysisPlay")->click();QTRY_VERIFY_WITH_TIMEOUT(step->value()>=3,15000);pane->findChild<QPushButton*>("analysisPlay")->click();QTest::qWait(500);step->setValue(step->maximum());QTRY_VERIFY_WITH_TIMEOUT(info->text().contains(QString("명령 %1 / %1").arg(step->maximum())),20000);QVERIFY(pane->findChild<QPlainTextEdit*>("analysisStateJson")->toPlainText().contains("finished"));pane->grab().save(evidence+"/analysis-replay.png");
  if(qEnvironmentVariableIsSet("RAISING_WORKBENCH_REOPEN_ONLY")){
    auto state=QJsonDocument::fromJson(pane->findChild<QPlainTextEdit*>("analysisStateJson")->toPlainText().toUtf8()).object().value("state").toObject();auto attrs=state.value("attributes").toObject();QVERIFY(!attrs.empty());const auto key=attrs.keys().first();auto attr=pane->findChild<QComboBox*>("analysisFinalAttribute");attr->setCurrentIndex(attr->findData(key));QVERIFY(attr->currentIndex()>0);pane->findChild<QSpinBox*>("analysisAbilityMin")->setValue(attrs.value(key).toInt());pane->findChild<QSpinBox*>("analysisAbilityMax")->setValue(attrs.value(key).toInt());pane->findChild<QTabWidget*>("analysisTabs")->setCurrentIndex(0);pane->findChild<QPushButton*>("analysisApplyFilter")->click();QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()>0,15000);QVERIFY(pane->findChild<QLabel*>("analysisRunCount")->text().contains("조건에 맞는"));pane->grab().save(evidence+"/analysis-attribute-filter.png");
    attr->setCurrentIndex(0);pane->findChild<QPushButton*>("analysisClearFilter")->click();auto outcome=pane->findChild<QComboBox*>("analysisOutcome");outcome->setCurrentIndex(outcome->findData("limit"));pane->findChild<QPushButton*>("analysisApplyFilter")->click();QTRY_VERIFY_WITH_TIMEOUT(runs->rowCount()==1,15000);QCOMPARE(runs->item(0,0)->text(),QString("4183"));QCOMPARE(runs->item(0,1)->text(),QString("8425"));runs->setCurrentCell(0,0);pane->findChild<QPushButton*>("analysisOpenRun")->click();QTRY_VERIFY_WITH_TIMEOUT(step->maximum()==1000&&info->text().contains("명령 0 /"),10000);step->setValue(1000);QTRY_VERIFY_WITH_TIMEOUT(info->text().contains("명령 1000 / 1000"),20000);QVERIFY(pane->findChild<QPlainTextEdit*>("analysisStateJson")->toPlainText().contains("planning"));pane->grab().save(evidence+"/analysis-limit-replay.png");
