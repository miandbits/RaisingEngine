#include <QSlider>

void StudioTests::timelineLegacyProject(){
  auto root=qEnvironmentVariable("RAISING_TIMELINE_LEGACY_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_TIMELINE_LEGACY_PROJECT to an academy-visual copy");auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);QVERIFY(!w.projectData().contains("gameplay"));const auto baseline=w.projectData();
  for(bool save:{false,true}){QTimer::singleShot(100,&w,[save]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QTimer::singleShot(10000,d,&QDialog::reject);QVERIFY(!d->findChild<QCheckBox*>("timelineCalendarEnabled")->isEnabled());d->findChild<QPushButton*>("timelineAdd")->click();auto clips=d->findChild<QTableWidget*>("timelineClips");clips->item(0,3)->setText("");auto buttons=d->findChild<QDialogButtonBox*>();buttons->button(QDialogButtonBox::Save)->click();QVERIFY(d->isVisible());QVERIFY(!d->findChild<QLabel*>("timelineError")->text().isEmpty());clips->item(0,3)->setText("{activity}");buttons->button(save?QDialogButtonBox::Save:QDialogButtonBox::Cancel)->click();});w.findChild<QAction*>("editTimelines")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));QVERIFY(!w.projectData().contains("gameplay"));if(!save)QCOMPARE(w.projectData(),baseline);}
  for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView().value("dirty").toBool());
}

void StudioTests::timelineAuthoring(){
  const auto root=qEnvironmentVariable("RAISING_TIMELINE_PROJECT");if(root.isEmpty())QSKIP("Set RAISING_TIMELINE_PROJECT to a fresh data-ui-lab copy");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath());StudioWindow w(engine);w.resize(1440,1000);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().empty(),20000);QVERIFY(w.projectData().value("visual").toObject().value("timelines").toArray().empty());
  const auto evidence=engine+"/.cache/qt-timeline-evidence";QDir().mkpath(evidence);
  auto edit=[&](std::function<void(QDialog*)> fn){QTimer::singleShot(100,&w,[fn]{auto d=qobject_cast<QDialog*>(QApplication::activeModalWidget());QVERIFY(d);QCOMPARE(d->objectName(),QString("timelineDialog"));QTimer::singleShot(20000,d,&QDialog::reject);fn(d);});w.findChild<QAction*>("editTimelines")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));};
  edit([&](QDialog*d){
    auto table=d->findChild<QTableWidget*>("timelineClips");QVERIFY(table);
    for(int t=0;t<3;t++){
      d->findChild<QPushButton*>("timelineAdd")->click();d->findChild<QLineEdit*>("timelineName")->setText(QStringList{"Activity days","Success scene","Failure scene"}[t]);
      for(int c=0;c<2;c++){if(c)d->findChild<QPushButton*>("timelineClipAdd")->click();auto duration=qobject_cast<QSpinBox*>(table->cellWidget(c,1));duration->setValue(c==0?1500:900);auto image=qobject_cast<QComboBox*>(table->cellWidget(c,2));image->setCurrentIndex(image->findData(c==0?"visual-courtyard":"visual-library"));table->item(c,3)->setText(c==0?QString("%1 · {activity} · {day} · {outcome}").arg(t==1?"Success":t==2?"Failure":"Activity"):QString("{changes}"));auto transition=qobject_cast<QComboBox*>(table->cellWidget(c,4));transition->setCurrentIndex(transition->findData("fade"));}
      // Reordering is reflected in the preview and persisted stable IDs.
      table->setCurrentCell(1,3);d->findChild<QPushButton*>("timelineClipUp")->click();QCOMPARE(table->item(0,0)->text(),QString("clip-2"));d->findChild<QPushButton*>("timelineClipDown")->click();QCOMPARE(table->item(0,0)->text(),QString("clip-1"));
    }
    d->findChild<QPushButton*>("timelineDuplicate")->click();QCOMPARE(d->findChild<QListWidget*>("timelineLibrary")->count(),4);d->findChild<QPushButton*>("timelineRemove")->click();QCOMPARE(d->findChild<QListWidget*>("timelineLibrary")->count(),3);
    auto library=d->findChild<QListWidget*>("timelineLibrary");library->setCurrentRow(0);auto scrub=d->findChild<QSlider*>("timelineScrub");scrub->setValue(500);d->findChild<QPushButton*>("timelinePlay")->click();QTest::qWait(100);d->findChild<QPushButton*>("timelinePlay")->click();QVERIFY(scrub->value()>500);d->grab().save(evidence+"/timeline-workshop.png");
    d->findChild<QTabWidget*>("timelineTabs")->setCurrentIndex(1);auto mappings=d->findChild<QTableWidget*>("timelineMappings");QVERIFY(mappings);
    for(int r=0;r<mappings->rowCount();r++){const auto label=mappings->item(r,0)->text();if(!label.endsWith(" · study")&&!label.endsWith(" · rest")&&!label.endsWith(" · expedition"))continue;auto base=qobject_cast<QComboBox*>(mappings->cellWidget(r,1));base->setCurrentIndex(base->findData("timeline-1"));auto repeat=qobject_cast<QComboBox*>(mappings->cellWidget(r,4));repeat->setCurrentIndex(repeat->findData(label.endsWith(" · rest")?"once":"logicalDays"));if(label.endsWith(" · expedition")){for(int c=2;c<=3;c++){auto branch=qobject_cast<QComboBox*>(mappings->cellWidget(r,c));branch->setCurrentIndex(branch->findData(QString("timeline-%1").arg(c)));}}}
    auto save=d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save);save->click();QVERIFY(d->isVisible());QVERIFY(d->findChild<QLabel*>("timelineError")->text().contains(QString::fromUtf8("달력")));
    d->findChild<QCheckBox*>("timelineCalendarEnabled")->setChecked(true);d->findChild<QSpinBox*>("timelineCalendarDays")->setValue(30);d->grab().save(evidence+"/timeline-bindings.png");
    d->findChild<QTabWidget*>("timelineTabs")->setCurrentIndex(0);library->setCurrentRow(0);d->findChild<QPushButton*>("timelineRemove")->click();QCOMPARE(library->count(),3);QVERIFY(d->findChild<QLabel*>("timelineError")->text().contains(QString::fromUtf8("해제")));
    table->item(0,3)->setText("{not-supported}");save->click();QVERIFY(d->isVisible());QVERIFY(d->findChild<QLabel*>("timelineError")->text().contains("not-supported"));table->item(0,3)->setText("Activity · {activity} · {day} · {outcome}");save->click();
  });
  auto authored=w.projectData();auto visual=authored.value("visual").toObject();QCOMPARE(visual.value("timelines").toArray().size(),3);QCOMPARE(visual.value("activityTimelines").toArray().size(),3);QCOMPARE(authored.value("gameplay").toObject().value("ruleCalendar").toObject().value("daysPerMonth").toInt(),30);
  for(auto v:w.currentView().value("diagnostics").toArray())QVERIFY2(v.toObject().value("severity")!="error",qPrintable(QString::fromUtf8(QJsonDocument(v.toObject()).toJson())));
  // Opening and saving a populated workshop must preserve all binding and clip data.
  edit([](QDialog*d){auto library=d->findChild<QListWidget*>("timelineLibrary");for(int r=0;r<library->count();r++)library->setCurrentRow(r);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});QCOMPARE(w.projectData(),authored);
  w.findChild<QAction*>("saveProject")->trigger();QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),10000);QVERIFY(!w.currentView().value("dirty").toBool());StudioWindow reopened(engine);reopened.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!reopened.busy()&&!reopened.projectData().empty(),20000);QCOMPARE(reopened.projectData(),authored);
  QFile file(evidence+"/authored-project.json");QVERIFY(file.open(QIODevice::WriteOnly));file.write(QJsonDocument(authored).toJson());
}
