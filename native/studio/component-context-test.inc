void StudioTests::componentContextAuthoring(){
  if(!qEnvironmentVariableIsSet("RAISING_QT_COMPONENT_CONTEXT"))QSKIP("Requires a disposable copy of reusable-activities.");
  const auto engine=qEnvironmentVariable("RAISING_ENGINE_ROOT",QDir::currentPath()),root=qEnvironmentVariable("RAISING_QT_PROJECT");
  StudioWindow w(engine);w.show();w.openProject(root);QTRY_VERIFY_WITH_TIMEOUT(!w.busy()&&!w.projectData().isEmpty(),20000);
  auto settle=[&]{QTRY_VERIFY_WITH_TIMEOUT(!w.busy(),20000);QTest::qWait(120);QCoreApplication::sendPostedEvents(nullptr,QEvent::DeferredDelete);QVERIFY2(w.lastError.isEmpty(),qPrintable(w.lastError));};
  w.findChild<QAction*>("showAuthoringWorkspace")->trigger();settle();auto dock=w.findChild<QDockWidget*>("authoringWorkspaceDock");QVERIFY(dock);
  QStringList actions;
  for(int i=0;i<2;++i){auto kind=dock->findChild<QComboBox*>("workspaceAddKind");kind->setCurrentIndex(kind->findData("action"));dock->findChild<QPushButton*>("workspaceAdd")->click();settle();auto selected=dock->findChild<QTreeWidget*>("workspaceEntities")->currentItem()->data(0,Qt::UserRole).toJsonObject();actions<<selected.value("id").toString();
    const auto title=i==0?QString("검술 다듬기"):QString("비전 연마");auto name=dock->findChild<QLineEdit*>("workspaceField-name");QVERIFY(name);name->setText(title);QMetaObject::invokeMethod(name,"textEdited",Q_ARG(QString,title));
    dock->findChild<QPushButton*>("workspaceAddCost")->click();auto costs=dock->findChild<QTableWidget*>("workspaceCosts");auto a=qobject_cast<QComboBox*>(costs->cellWidget(0,0));a->setCurrentIndex(a->findData("money"));qobject_cast<QSpinBox*>(costs->cellWidget(0,1))->setValue(i+2);
    QTimer::singleShot(30,&w,[&,i]{auto d=w.findChild<QDialog*>("logicEditor");QVERIFY(d);characterNode(d,{});d->findChild<QPushButton*>("logicAdd")->click();characterTarget(d,{"0","target"},"attribute","skill");characterNumber(d,{"0","value"},i==0?5:7);d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});dock->findChild<QPushButton*>("workspaceLogic-effects")->click();dock->findChild<QPushButton*>("workspaceApply")->click();settle();
  }
  QStringList actors;for(auto m:w.projectData().value("roster").toObject().value("members").toArray())actors<<m.toObject().value("characterId").toString();
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("characterStateDialog");QVERIFY(d);for(auto actor:actors){auto list=d->findChild<QListWidget*>("characterActions-"+actor);QVERIFY(list);for(int i=0;i<list->count();++i)if(actions.contains(list->item(i)->data(Qt::UserRole).toString()))list->item(i)->setCheckState(Qt::Checked);}d->findChild<QDialogButtonBox*>("characterStateButtons")->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editCharacterState")->trigger();settle();
  selectWorkspaceItem(dock,"screenElement:screen-1/instance-1");dock->findChild<QPushButton*>("workspaceCanvas")->click();settle();
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("componentsDialog");QVERIFY(d);QTimer::singleShot(30000,d,[d]{d->reject();QFAIL("Component authoring timed out without saving");});auto library=d->findChild<QListWidget*>("componentLibrary");library->setCurrentRow(library->count()-1);d->findChild<QSpinBox*>("componentHeight")->setValue(110);d->findChild<QListWidget*>("componentChildren")->setCurrentRow(0);d->findChild<QSpinBox*>("child-x")->setValue(240);d->findChild<QSpinBox*>("child-width")->setValue(290);d->findChild<QSpinBox*>("child-height")->setValue(28);d->findChild<QSpinBox*>("child-fontSize")->setValue(16);d->findChild<QPushButton*>("applyComponentChild")->click();
    auto context=[&](std::function<void(QDialog*)> edit){QTimer::singleShot(30,d,[&]{auto c=d->findChild<QDialog*>("componentContextDialog");QVERIFY(c);edit(c);c->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});d->findChild<QPushButton*>("componentContext")->click();};
    auto add=[&](QString kind,int x,int y,int width){auto k=d->findChild<QComboBox*>("componentChildKind");k->setCurrentIndex(k->findData(kind));d->findChild<QPushButton*>("addComponentChild")->click();d->findChild<QSpinBox*>("child-x")->setValue(x);d->findChild<QSpinBox*>("child-y")->setValue(y);d->findChild<QSpinBox*>("child-width")->setValue(width);d->findChild<QSpinBox*>("child-height")->setValue(kind=="button"?42:28);d->findChild<QSpinBox*>("child-fontSize")->setValue(18);};
    add("text",0,0,220);context([&](QDialog* c){auto display=c->findChild<QComboBox*>("contextDisplay");display->setCurrentIndex(display->findData("actorId"));});
    add("text",0,30,220);context([&](QDialog* c){auto display=c->findChild<QComboBox*>("contextDisplay");display->setCurrentIndex(display->findData("data-value"));auto n=c->findChild<QComboBox*>("contextNumeric");for(int i=0;i<n->count();++i)if(n->itemData(i).toJsonObject().value("attributeId")=="skill")n->setCurrentIndex(i);});
    add("text",240,30,290);context([&](QDialog* c){auto display=c->findChild<QComboBox*>("contextDisplay");display->setCurrentIndex(display->findData("actionId"));});
    add("button",0,60,250);auto action=d->findChild<QComboBox*>("child-action");QVERIFY(action->findData("executeActorAction")>=0);action->setCurrentIndex(action->findData("executeActorAction"));d->findChild<QLineEdit*>("child-text")->setText("연결된 행동 실행");context([&](QDialog* c){c->findChild<QCheckBox*>("contextUse-actionId")->setChecked(true);characterCondition(c,c->findChild<QPushButton*>("context-enabledCondition"),"attribute","skill",20);});
    add("button",270,60,260);auto assign=d->findChild<QComboBox*>("child-action");assign->setCurrentIndex(assign->findData("assignActivity"));d->findChild<QLineEdit*>("child-text")->setText("이 활동 배정");context([&](QDialog* c){c->findChild<QCheckBox*>("contextUse-activityId")->setChecked(true);});
    d->grab().save(engine+"/.cache/component-context/definition.png");d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QAction*>("editComponents")->trigger();settle();
  const auto card=w.projectData().value("visual").toObject().value("components").toArray().last().toObject();QCOMPARE(card.value("height").toInt(),110);QCOMPARE(card.value("elements").toArray().size(),6);QCOMPARE(card.value("elements").toArray()[2].toObject().value("binding").toString(),QString("data-value"));
  QStringList activities;for(auto doc:w.currentView().value("documents").toArray())if(doc.toObject().value("kind")=="activity"&&doc.toObject().value("data").toObject().value("label").toString().contains("연회"))activities<<doc.toObject().value("data").toObject().value("id").toString();QVERIFY(!activities.empty());
  const auto training=w.projectData().value("roster").toObject().value("members").toArray().first().toObject().value("activityId").toString();
  for(int i=0;i<2;++i){selectWorkspaceItem(dock,"screenElement:screen-1/instance-"+QString::number(i+1));dock->findChild<QPushButton*>("workspaceCanvas")->click();settle();auto h=w.findChild<QSpinBox*>("elementHeight");h->setValue(110);QMetaObject::invokeMethod(h,"editingFinished");settle();auto instanceY=w.findChild<QSpinBox*>("elementY");instanceY->setValue(100);QMetaObject::invokeMethod(instanceY,"editingFinished");settle();
    QTimer::singleShot(30,&w,[&,i]{auto d=w.findChild<QDialog*>("componentOverridesDialog");QVERIFY(d);QTimer::singleShot(30,d,[&,i]{auto c=d->findChild<QDialog*>("componentContextDialog");QVERIFY(c);for(auto pair:QList<QPair<QString,QString>>{{"actorId",actors[i]},{"activityId",i==0?training:activities.first()},{"actionId",actions[i]}}){auto field=c->findChild<QComboBox*>("context-"+pair.first);QVERIFY(field->findData(pair.second)>=0);field->setCurrentIndex(field->findData(pair.second));}c->grab().save(engine+"/.cache/component-context/instance-"+QString::number(i)+".png");c->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});d->findChild<QPushButton*>("instanceContext")->click();d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});w.findChild<QPushButton*>("componentOverrides")->click();settle();
  }
  for(auto pair:QList<QPair<QString,int>>{{"text-2",230},{"schedule-1",280},{"choices-1",280}}){selectWorkspaceItem(dock,"screenElement:screen-1/"+pair.first);dock->findChild<QPushButton*>("workspaceCanvas")->click();settle();auto y=w.findChild<QSpinBox*>("elementY");y->setValue(pair.second);QMetaObject::invokeMethod(y,"editingFinished");settle();}
  const auto before=w.projectData();selectWorkspaceItem(dock,"screenElement:screen-1/instance-1");dock->findChild<QPushButton*>("workspaceCanvas")->click();settle();
  QTimer::singleShot(30,&w,[&]{auto d=w.findChild<QDialog*>("componentOverridesDialog");QTimer::singleShot(30,d,[&]{auto c=d->findChild<QDialog*>("componentContextDialog");c->findChild<QComboBox*>("context-actorId")->setCurrentIndex(0);c->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Save)->click();});d->findChild<QPushButton*>("instanceContext")->click();d->findChild<QDialogButtonBox*>()->button(QDialogButtonBox::Cancel)->click();});w.findChild<QPushButton*>("componentOverrides")->click();settle();QCOMPARE(w.projectData(),before);
  w.findChild<QAction*>("saveProject")->trigger();settle();w.openProject(root);settle();QCOMPARE(w.projectData(),before);
  QFile info(engine+"/.cache/component-context/authoring.json");QVERIFY(info.open(QIODevice::WriteOnly));info.write(QJsonDocument(QJsonObject{{"root",root},{"screen","screen-1"},{"actors",QJsonArray::fromStringList(actors)},{"actions",QJsonArray::fromStringList(actions)},{"training",training}}).toJson());
}
