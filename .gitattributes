# A source archive must not include local projects, even if accidentally staged.
/projects export-ignore
/internal export-ignore
/.cache export-ignore
/dist export-ignore
/release export-ignore
/docs/evidence export-ignore

# The type generator writes LF on every host. Match checkout bytes so a
# clean Windows build does not report unchanged generated types as dirty.
/packages/schema/generated/*.ts text eol=lf
/packages/visual/presentation-policy.generated.ts text eol=lf
/native/player/presentation-policy.generated.hpp text eol=lf
