{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising-engine.example/saves/1.0.0/save.schema.json",
  "title": "Run save envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saveVersion",
    "coreVersion",
    "contentFingerprint",
    "origin",
    "commands",
    "state"
  ],
  "properties": {
    "saveVersion": {
      "const": "1.0.0"
    },
    "coreVersion": {
      "type": "string"
    },
    "contentFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "mode",
        "initialOverrides"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "mode": {
          "enum": [
            "full",
            "activities-only"
          ]
        },
        "initialOverrides": {
          "$ref": "https://raising-engine.example/schemas/0.1.0/common.schema.json#/$defs/overrides"
        },
        "userValues": {
          "$ref": "https://raising-engine.example/schemas/0.1.0/common.schema.json#/$defs/userValues"
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "playerPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/timelineCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduleSpeed": {
          "type": "integer",
          "enum": [
            1,
            4
          ]
        },
        "battleSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/battleSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "description": "Opaque per-plugin presentation state (saveAll), keyed by plugin id. Never consulted by game logic.",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequenceId",
            "elapsedMs",
            "speed",
            "paused",
            "status"
          ],
          "properties": {
            "sequenceId": {
              "type": "string"
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6000000
            },
            "speed": {
              "enum": [
                1,
                4
              ]
            },
            "paused": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "playing",
                "completed",
                "stopped"
              ]
            }
          }
        },
        "scheduleDraft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "month",
            "slot",
            "selected",
            "activities"
          ],
          "properties": {
            "month": {
              "type": "integer",
              "minimum": 0
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "selected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "activities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "saveRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "date",
            "place",
            "screenId",
            "phase",
            "thumbnail",
            "savedAt",
            "sequence",
            "automatic"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "date": {
              "type": "string",
              "maxLength": 511
            },
            "place": {
              "type": "string",
              "maxLength": 511
            },
            "screenId": {
              "type": "string",
              "maxLength": 511
            },
            "phase": {
              "type": "string",
              "maxLength": 511
            },
            "savedAt": {
              "type": "string",
              "maxLength": 511
            },
            "thumbnail": {
              "type": "string",
              "maxLength": 511,
              "pattern": "^(frame-[0-9]+-[0-9]+\\.png)?$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "automatic": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "version",
        "timeline"
      ]
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "$ref": "https://raising-engine.example/schemas/0.1.0/common.schema.json#/$defs/id"
    },
    "command": {
      "$ref": "https://raising-engine.example/schemas/0.1.0/common.schema.json#/$defs/command"
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "nodeId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "event",
            "ending"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "returnPhase": {
          "enum": [
            "planning",
            "ready",
            "period-end"
          ]
        },
        "returnPresentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backgroundAssetId",
            "musicAssetId",
            "portraits"
          ],
          "properties": {
            "backgroundAssetId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "musicAssetId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "portraits": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "characterId",
                  "portraitId",
                  "position"
                ],
                "properties": {
                  "characterId": {
                    "$ref": "#/$defs/id"
                  },
                  "portraitId": {
                    "$ref": "#/$defs/id"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 4
                  },
                  "offsetX": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "offsetY": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "position": {
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  }
                }
              }
            }
          }
        },
        "finishPeriod": {
          "type": "boolean"
        },
        "actorId": {
          "type": "string"
        },
        "appointmentTrigger": {
          "enum": [
            "period-start",
            "after-activity",
            "location-enter"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreVersion",
        "contentFingerprint",
        "mode",
        "stateRevision",
        "periodIndex",
        "phase",
        "schedule",
        "rng",
        "attributes",
        "flags",
        "relationships",
        "completedEvents",
        "lastActivityResult",
        "activeNarrative",
        "endingId",
        "presentation"
      ],
      "properties": {
        "coreVersion": {
          "type": "string"
        },
        "contentFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "mode": {
          "enum": [
            "full",
            "activities-only"
          ]
        },
        "stateRevision": {
          "$ref": "#/$defs/revision"
        },
        "periodPreparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changes"
          ],
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "activityIntermission": {
          "const": true
        },
        "periodIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "phase": {
          "enum": [
            "planning",
            "ready",
            "activity-result",
            "period-end",
            "narrative",
            "finished",
            "expedition",
            "battle"
          ]
        },
        "schedule": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          }
        },
        "completedEvents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "activeNarrative": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cursor"
            }
          ]
        },
        "endingId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "rng": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "seed",
            "state",
            "draws"
          ],
          "properties": {
            "algorithm": {
              "const": "pcg32-xsh-rr-v1"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "state": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "draws": {
              "$ref": "#/$defs/revision"
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backgroundAssetId",
            "musicAssetId",
            "portraits"
          ],
          "properties": {
            "backgroundAssetId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "musicAssetId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "portraits": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "characterId",
                  "portraitId",
                  "position"
                ],
                "properties": {
                  "characterId": {
                    "$ref": "#/$defs/id"
                  },
                  "portraitId": {
                    "$ref": "#/$defs/id"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 4
                  },
                  "offsetX": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "offsetY": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "position": {
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  }
                }
              }
            }
          }
        },
        "lastActivityResult": {
          "description": "Full nested result, value ranges and cursor consistency are checked by deterministic journal replay.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "gameplay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locationId",
            "screenId",
            "inventory",
            "purchased",
            "interactionPeriods",
            "visited"
          ],
          "properties": {
            "locationId": {
              "$ref": "#/$defs/id"
            },
            "screenId": {
              "$ref": "#/$defs/id"
            },
            "inventory": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "purchased": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/id"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              }
            },
            "interactionPeriods": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "visited": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "dietId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dietAppliedPeriod": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "dietNextPeriod": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "policySelections": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "policyNextPeriods": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "policyAppliedPeriods": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "rulePeriods": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "periodStart": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "periodEnd": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": []
            }
          }
        },
        "systems": {
          "type": "object",
          "description": "Checked against deterministic command journal replay."
        },
        "userValues": {
          "$ref": "https://raising-engine.example/schemas/0.1.0/common.schema.json#/$defs/userValues"
        },
        "roster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attributes",
            "assignments"
          ],
          "properties": {
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            },
            "assignments": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "inventory": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            },
            "relationships": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            },
            "completedEvents": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            },
            "flags": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "progression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick",
            "actionPoints",
            "handled",
            "pending"
          ],
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "actionPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "handled": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "outcome"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "fired",
                      "skipped"
                    ]
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999
                  },
                  "atTick": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                }
              }
            },
            "pending": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "remaining",
                    "command"
                  ],
                  "properties": {
                    "remaining": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "command": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "actionId",
                            "quantity"
                          ],
                          "properties": {
                            "type": {
                              "const": "executeAction"
                            },
                            "actionId": {
                              "type": "string"
                            },
                            "quantity": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "actorId": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "actors": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "elapsed",
                  "actionPoints"
                ],
                "properties": {
                  "elapsed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "actionPoints": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            },
            "sessions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "remaining",
                  "command"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "action",
                      "calendar",
                      "wait"
                    ]
                  },
                  "remaining": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "command": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "actionId",
                          "quantity"
                        ],
                        "properties": {
                          "type": {
                            "const": "executeAction"
                          },
                          "actionId": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "actorId": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "uiScreenId": {
          "$ref": "#/$defs/id"
        },
        "customStates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shared": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/id"
              }
            },
            "characters": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/id"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          },
          "required": [
            "shared",
            "characters"
          ]
        }
      }
    },
    "timelineCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resultRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activityId": {
          "$ref": "#/$defs/id"
        },
        "timelineId": {
          "$ref": "#/$defs/id"
        },
        "clipIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12200
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "paused": {
          "type": "boolean"
        },
        "speed": {
          "enum": [
            1,
            4
          ]
        },
        "completed": {
          "type": "boolean"
        }
      },
      "required": [
        "resultRevision",
        "activityId",
        "timelineId",
        "clipIndex",
        "elapsedMs",
        "paused",
        "speed",
        "completed"
      ]
    },
    "battleSelection": {
      "type": "object",
