{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising-engine.example/schemas/0.1.0/systems.schema.json",
  "title": "Systems definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "battleHistoryLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxHpAttributeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "attackAttributeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "defenseAttributeId": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "maxHpAttributeId",
        "attackAttributeId",
        "defenseAttributeId"
      ]
    },
    "equipment": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "itemId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "slot": {
            "enum": [
              "weapon",
              "armor",
              "accessory"
            ]
          },
          "modifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxHp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "attack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "maxHp",
              "attack",
              "defense"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "itemId",
          "slot",
          "modifiers"
        ]
      }
    },
    "consumables": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "heal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "itemId",
          "heal"
        ]
      }
    },
    "enemies": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "maxHp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "attack": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "attackPattern": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "integer", "minimum": 0, "maximum": 1000000 } },
          "damageVariance": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
          "guardRoundDown": { "type": "boolean", "default": false },
          "defense": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "rewards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "itemId": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "itemId",
                    "quantity"
                  ]
                }
              },
              "effects": {
                "$ref": "common.schema.json#/$defs/effects"
              }
            },
            "required": [
              "items",
              "effects"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "maxHp",
          "attack",
          "defense",
          "rewards"
        ]
      }
    },
    "expeditions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "locationId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "entryNodeId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "nodes": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "name": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "description": {
                  "type": "string",
                  "maxLength": 4000
                },
                "connections": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "uniqueItems": true
                },
                "enemyId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "manualBattle": { "type": "boolean", "default": false },
                "battleRequirements": { "$ref": "common.schema.json#/$defs/condition" },
                "exit": {
                  "type": "boolean"
                },
                "presentation": {
                  "$ref": "common.schema.json#/$defs/scene"
                },
                "encounterId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "requirements": {
                  "$ref": "common.schema.json#/$defs/condition"
                },
                "entryActionId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "repeatEntryAction": {
                  "type": "boolean",
                  "default": false
                },
                "actionIds": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                }
              },
              "required": [
                "id",
                "name",
                "connections"
              ]
            },
            "minItems": 1
          },
          "entryActionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "moveActionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "completionActionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "retreatActionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "defeatActionId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "id",
          "name",
          "locationId",
          "entryNodeId",
          "nodes"
        ]
      }
    },
    "quests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "locationId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "requirements": {
            "$ref": "common.schema.json#/$defs/condition"
          },
          "enemyId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "targetCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "rewards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "itemId": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "itemId",
                    "quantity"
                  ]
                }
              },
              "effects": {
                "$ref": "common.schema.json#/$defs/effects"
              }
            },
            "required": [
              "items",
              "effects"
            ]
          },
          "encounterId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "id",
          "name",
          "locationId",
          "requirements",
          "enemyId",
          "targetCount",
          "rewards"
        ]
      }
    },
    "relationshipStages": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "characterId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "relationshipId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "threshold": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "eventId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "id",
          "name",
          "characterId",
          "relationshipId",
          "threshold"
        ]
      }
    },
    "tactics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "units": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "characterId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "faction": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "control": {
                "enum": [
                  "player",
                  "ai"
                ]
              },
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "stats": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxHp": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "attack": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "defense": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "speed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "maxHp",
                  "attack",
                  "defense",
                  "speed"
                ]
              },
              "skillIds": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "statAttributes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxHp": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "attack": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "defense": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "speed": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                }
              }
            },
            "required": [
              "id",
              "name",
              "faction",
              "control",
              "row",
              "column",
              "stats",
              "skillIds"
            ]
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "target": {
                "enum": [
                  "enemy",
                  "frontEnemy",
                  "ally",
                  "self",
                  "allEnemies",
                  "allAllies"
                ]
              },
              "kind": {
                "enum": [
                  "damage",
                  "heal",
                  "status"
                ]
              },
              "power": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "accuracy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "castTurns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "cooldown": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "statusId": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "required": [
              "id",
              "name",
              "target",
              "kind",
              "power",
              "accuracy",
              "castTurns",
              "cooldown"
            ]
          }
        },
        "statuses": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "damage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "heal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "attack": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "defense": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "stun": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "turns",
              "damage",
              "heal",
              "attack",
              "defense",
              "stun"
            ]
          }
        },
        "encounters": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "party": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "waves": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "unitIds": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "$ref": "common.schema.json#/$defs/id"
                      }
                    }
                  },
                  "required": [
                    "unitIds"
                  ]
                }
              },
              "experience": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "rewards": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "itemId": {
                          "$ref": "common.schema.json#/$defs/id"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "itemId",
                        "quantity"
                      ]
                    }
                  },
                  "effects": {
                    "$ref": "common.schema.json#/$defs/effects"
                  }
                },
                "required": [
                  "items",
                  "effects"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "party",
              "waves",
              "experience",
              "rewards"
            ]
          }
        },
        "growth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "experiencePerLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "perLevel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxHp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "attack": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "defense": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "speed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": [
                "maxHp",
                "attack",
                "defense",
                "speed"
              ]
            }
          },
          "required": [
            "experiencePerLevel",
            "maxLevel",
            "perLevel"
          ]
        }
      },
      "required": [
        "units",
        "skills",
        "statuses",
        "encounters",
        "growth"
      ]
    }
  },
  "required": [
    "hero",
    "equipment",
    "consumables",
    "enemies",
    "expeditions",
    "quests",
    "relationshipStages"
  ]
}
