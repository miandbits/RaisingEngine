{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising-engine.example/schemas/0.1.0/gameplay.schema.json",
  "title": "Gameplay definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "startLocationId",
    "locations",
    "items",
    "shops",
    "interactions"
  ],
  "properties": {
    "startLocationId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "shops": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/shop"
      }
    },
    "interactions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "diets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/diet"
      }
    },
    "services": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "policyGroups": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/policyGroup"
      }
    },
    "policyBudgets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/policyBudget"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "ruleCalendar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daysPerMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      },
      "required": [
        "daysPerMonth"
      ]
    }
  },
  "$defs": {
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "connections"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "screenId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "connections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "presentation": {
          "$ref": "common.schema.json#/$defs/scene"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maxStack"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "imageAssetId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "maxStack": {
          "$ref": "#/$defs/positive"
        },
        "initialQuantity": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "locationId",
        "currencyAttributeId",
        "offers"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "currencyAttributeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "offers": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "price",
              "stock"
            ],
            "properties": {
              "itemId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "price": {
                "$ref": "#/$defs/nonnegative"
              },
              "stock": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/nonnegative"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxQuantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "confirmation": {
                "$ref": "#/$defs/confirmation"
              }
            }
          }
        },
        "sellOffers": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "price"
            ],
            "properties": {
              "itemId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "price": {
                "$ref": "#/$defs/nonnegative"
              },
              "maxQuantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "confirmation": {
                "$ref": "#/$defs/confirmation"
              }
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "locationId",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "characterId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "itemId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "quantity": {
          "$ref": "#/$defs/positive"
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "effects": {
          "$ref": "common.schema.json#/$defs/effects"
        },
        "costs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attributeId",
              "amount"
            ],
            "properties": {
              "attributeId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "amount": {
                "$ref": "#/$defs/nonnegative"
              }
            }
          }
        },
        "oncePerPeriod": {
          "type": "boolean"
        },
        "eventId": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "dependentRequired": {
        "quantity": [
          "itemId"
        ]
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "confirmLabel": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "cancelLabel": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "False executes immediately without a confirmation dialog. Existing content keeps confirmation enabled."
        }
      }
    },
    "diet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "locationId",
        "costs",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "costs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attributeId",
              "amount"
            ],
            "properties": {
              "attributeId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "amount": {
                "$ref": "#/$defs/nonnegative"
              }
            }
          }
        },
        "effects": {
          "$ref": "common.schema.json#/$defs/effects"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "intervalPeriods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "locationId",
        "costs",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "costs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attributeId",
              "amount"
            ],
            "properties": {
              "attributeId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "amount": {
                "$ref": "#/$defs/nonnegative"
              }
            }
          }
        },
        "effects": {
          "$ref": "common.schema.json#/$defs/effects"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "maxQuantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/condition"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "costs",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "costs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attributeId",
              "amount"
            ],
            "properties": {
              "attributeId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "amount": {
                "$ref": "#/$defs/nonnegative"
              }
            }
          }
        },
        "effects": {
          "$ref": "common.schema.json#/$defs/effects"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "maxQuantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "locationIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "rejectNoEffect": {
          "type": "boolean"
        },
        "eventId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "flow": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "condition": {
                "$ref": "common.schema.json#/$defs/condition"
              },
              "chance": {
                "$ref": "common.schema.json#/$defs/expression",
                "description": "Optional chance in basis points (10000 = 100%). Evaluated after the condition passes; clamped to 0..10000."
              },
              "thenActionId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "elseActionId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              }
            },
            "required": [
              "id",
              "thenActionId"
            ]
          }
        }
      }
    },
    "policyBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unit": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "name",
        "capacity"
      ]
    },
    "policyGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "locationIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "beforeActivity",
                "afterActivity"
              ]
            },
            "intervalPeriods": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "type"
          ]
        },
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "actionId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "budgetUses": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "budgetId": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "budgetId",
                    "amount"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "actionId"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "trigger",
        "options"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "periodStart",
                "periodEnd",
                "monthStart",
                "monthEnd",
                "dayStart",
                "dayEnd",
                "locationEnter",
                "purchaseComplete",
                "relationshipChanged"
              ]
            },
            "locationId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "shopId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "itemId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "characterId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "relationshipId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "type"
          ]
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "actionId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      },
      "required": [
        "id",
        "name",
        "trigger",
        "actionId"
      ]
    }
  }
}
