{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising-engine.example/schemas/0.1.0/event.schema.json",
  "title": "Event definition",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/header"
    },
    {
      "$ref": "common.schema.json#/$defs/narrative"
    },
    {
      "if": {
        "properties": {
          "repeatable": {
            "const": true
          }
        },
        "required": [
          "repeatable"
        ]
      },
      "then": {
        "properties": {
          "trigger": {
            "const": "interaction"
          }
        },
        "required": [
          "trigger"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "after-activity"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "required": [
          "activityId"
        ],
        "properties": {
          "activityId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "else": {
        "properties": {
          "activityId": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "location-enter"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "required": [
          "locationId"
        ],
        "properties": {
          "locationId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "else": {
        "properties": {
          "locationId": false
        }
      }
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "label": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "description": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "throughPeriod": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "fromPeriod",
        "throughPeriod"
      ]
    },
    "requirements": {
      "$ref": "common.schema.json#/$defs/condition"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "trigger": {
      "enum": [
        "period-end",
        "interaction",
        "after-event",
        "period-start",
        "after-activity",
        "location-enter"
      ]
    },
    "repeatable": {
      "type": "boolean",
      "description": "An interaction may enter this event again after completion while its requirements hold. Completion history remains unique."
    },
    "scope": {
      "enum": [
        "shared",
        "actor"
      ]
    },
    "activityId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "locationId": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "required": [
    "id",
    "label",
    "window",
    "requirements",
    "priority"
  ],
  "unevaluatedProperties": false
}
