{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising-engine.example/schemas/0.1.0/assets.schema.json",
  "title": "Asset manifest",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/header"
    }
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "image",
              "audio",
              "font"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
          }
        },
        "required": [
          "id",
          "kind",
          "path"
        ]
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit packaging-only declarations. These do not participate in gameplay snapshots or save fingerprints.",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "notices": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            },
            "required": [
              "path",
              "sha256",
              "id"
            ]
          }
        }
      }
    }
  },
  "required": [
    "assets"
  ],
  "unevaluatedProperties": false
}
