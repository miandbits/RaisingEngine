{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raising.local/plugins/cutout-animation/rig.schema.json",
  "title": "Cutout rig data (schemaVersion 1)",
  "description": "Envelope `data` for documents of type `rig`. Structure only; semantic checks (cycles, references, key order) run in the C++ core.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canvas", "bones", "slots", "attachments", "clips"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "maxLength": 80 },
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "originX", "originY"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "originX": { "$ref": "#/$defs/coord" },
        "originY": { "$ref": "#/$defs/coord" }
      }
    },
    "bones": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "parent"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "parent": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" },
          "rotation": { "$ref": "#/$defs/angle" },
          "scaleX": { "$ref": "#/$defs/scale" }, "scaleY": { "$ref": "#/$defs/scale" },
          "length": { "description": "Bone length in px along its local +x (plugin 1.5.0; 0/absent = point bone). Drawn by the editor; the two-bone IK effector when the lower bone has no explicit tip.", "type": "number", "minimum": 0, "maximum": 100000 },
          "color": { "description": "Editor-only display colour (#rrggbb or #rrggbbaa). Ignored by runtimes.", "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
        }
      }
    },
    "slots": {
      "description": "Array order is draw order, back to front.",
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "bone", "attachment"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "bone": { "$ref": "#/$defs/id" },
          "attachment": { "anyOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
          "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "attachments": {
      "description": "Default attachments. An active skin is looked up first, then this list.",
      "type": "array", "maxItems": 1024,
      "items": { "$ref": "#/$defs/attachment" }
    },
    "skins": {
      "description": "Outfit/variant sets (plugin 1.2.0): provide or override attachments by (slot, name). Clips keep keying names.",
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "attachments"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "maxLength": 80 },
          "attachments": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/attachment" } }
        }
      }
    },
    "expressions": {
      "description": "Named facial/pose sets (plugin 1.2.0), applied after track 0 and before layer tracks 1..15.",
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "maxLength": 80 },
          "slots": {
            "description": "slot id -> attachment name, or null to hide the slot.",
            "type": "object", "maxProperties": 256, "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
          },
          "bones": {
            "description": "bone id -> absolute channel values (unlisted channels keep animating).",
            "type": "object", "maxProperties": 256, "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" },
                "rotation": { "$ref": "#/$defs/angle" },
                "scaleX": { "$ref": "#/$defs/scale" }, "scaleY": { "$ref": "#/$defs/scale" }
              }
            }
          }
        }
      }
    },
    "ik": {
      "description": "IK constraints (plugin 1.3.0), solved after the expression layer on world transforms in `order` (then array order). Semantics in docs/contract.md.",
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "bones", "target"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "maxLength": 80 },
          "bones": { "description": "1 bone = aim (local +x axis at the target); 2 = two-bone limb, parent then its direct child (effector = `tip`, else the child's first child bone).", "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/id" } },
          "target": { "description": "Bone whose world origin the chain reaches; never in the chain or below it.", "$ref": "#/$defs/id" },
          "tip": { "description": "Explicit two-bone effector (plugin 1.4.0): a direct child of the lower bone. Absent = the lower bone's first child.", "$ref": "#/$defs/id" },
          "mix": { "type": "number", "minimum": 0, "maximum": 1 },
          "aimAxis": { "description": "Aim chains (plugin 1.4.1): the bone-local direction, in degrees (0 = +x, 90 = +y / down the screen), that points at the target. Absent = 0. Two-bone chains: ANIM_IK_AIM_AXIS.", "type": "number", "minimum": -360, "maximum": 360 },
          "bendPositive": { "type": "boolean" },
          "stretch": { "description": "Accepted, not applied in 1.3.0 (warning ANIM_IK_STRETCH).", "type": "boolean" },
          "order": { "type": "integer", "minimum": -1000, "maximum": 1000 }
        }
      }
    },
    "events": {
      "description": "Event definitions (plugin 1.8.0, Spine-like). Optional; once present every clip event key must name one. int/float/string are the default payload of its keys; audio names an audio asset a host may play when the event fires. Presentation only: never a controller binding signal.",
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "int": { "type": "integer", "minimum": -2147483647, "maximum": 2147483647 },
          "float": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "string": { "type": "string", "maxLength": 1000 },
          "audio": { "description": "Audio asset id (kind audio, checked by the service).", "type": "string", "minLength": 1, "maxLength": 64 },
          "volume": { "description": "0..1, default 1 (with audio).", "type": "number", "minimum": 0, "maximum": 1 },
          "balance": { "description": "-1 (left) .. 1 (right), default 0 (with audio).", "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "clips": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "durationMs", "loop", "tracks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "maxLength": 80 },
          "durationMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
          "loop": { "type": "boolean" },
          "tracks": {
            "type": "array", "maxItems": 2048,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["target", "property", "keys"],
              "properties": {
                "target": { "description": "bone:<id>, slot:<id>, rig (property expression, step keys of expression ids / null) or ik:<id> (mix 0..1, bendPositive step bool).", "type": "string", "pattern": "^(?:(bone|slot|ik):[a-z][a-z0-9]*(?:-[a-z0-9]+)*|rig)$" },
                "property": { "description": "sequence (plugin 1.12.0): slot tracks picking frames of the slot's sequence attachment (step keys {mode, index, delay}).", "enum": ["x", "y", "rotation", "scaleX", "scaleY", "alpha", "attachment", "expression", "mix", "bendPositive", "deform", "sequence"] },
                "attachment": { "description": "Deform tracks (plugin 1.4.0): the slot's mesh attachment whose vertices the keys offset.", "$ref": "#/$defs/name" },
                "keys": {
                  "type": "array", "maxItems": 4096,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["timeMs"],
                    "anyOf": [{ "required": ["value"] }, { "required": ["offsets"] }, { "required": ["mode"] }, { "required": ["index"] }],
                    "properties": {
                      "timeMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
                      "value": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/name" }, { "type": "null" }, { "type": "boolean" }] },
                      "offsets": { "description": "Deform keys (plugin 1.4.0): dx, dy per mesh vertex in image pixels, added to the setup vertices.", "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/coord" } },
                      "mode": { "description": "Sequence keys (plugin 1.12.0): hold shows `index`; the others advance one frame per `delay` ms from the key (Spine SequenceMode). Default hold.", "enum": ["hold", "once", "loop", "pingpong", "onceReverse", "loopReverse", "pingpongReverse"] },
                      "index": { "description": "Sequence keys: the frame the key starts at (0-based; reverse modes count from the last frame).", "type": "integer", "minimum": 0, "maximum": 255 },
                      "delay": { "description": "Sequence keys: ms per frame (default 100).", "type": "number", "exclusiveMinimum": 0, "maximum": 60000 },
                      "interp": { "description": "Segment from this key to the next. Default linear; attachment keys are always step.", "enum": ["step", "linear", "bezier"] },
                      "curve": {
                        "description": "Bezier handles [x1, y1, x2, y2] for interp bezier, normalized to the segment: x = fraction of segment time, y = fraction of the value change (may overshoot).",
                        "type": "array", "minItems": 4, "maxItems": 4,
                        "prefixItems": [{ "$ref": "#/$defs/curveX" }, { "$ref": "#/$defs/curveY" }, { "$ref": "#/$defs/curveX" }, { "$ref": "#/$defs/curveY" }]
                      }
                    },
                    "if": { "required": ["interp"], "properties": { "interp": { "const": "bezier" } } },
                    "then": { "required": ["curve"] }
                  }
                }
              }
            }
          },
          "events": {
            "type": "array", "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["timeMs", "name"],
              "properties": {
                "timeMs": { "type": "integer", "minimum": 0, "maximum": 600000 }, "name": { "$ref": "#/$defs/name" },
                "int": { "description": "Overrides the definition's int (plugin 1.8.0).", "type": "integer", "minimum": -2147483647, "maximum": 2147483647 },
                "float": { "description": "Overrides the definition's float.", "type": "number", "minimum": -1000000, "maximum": 1000000 },
                "string": { "description": "Overrides the definition's string.", "type": "string", "maxLength": 1000 }
              }
            }
          }
        }
      }
    },
    "mix": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "defaultMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "pairs": {
          "type": "array", "maxItems": 1024,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "to", "durationMs"],
            "properties": { "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "durationMs": { "type": "integer", "minimum": 0, "maximum": 10000 } }
          }
        }
      }
    },
    "editor": {
      "description": "Non-essential authoring metadata (view). Ignored by runtimes. Bone display colours live on the bones (`color`, plugin 1.5.0).",
      "type": "object"
    }
  },
  "$defs": {
    "attachment": {
      "type": "object", "additionalProperties": false, "required": ["slot", "name"],
      "if": { "required": ["type"], "properties": { "type": { "const": "clipping" } } },
      "then": { "required": ["vertices", "end"] },
      "else": { "required": ["imageAssetId", "width", "height"] },
      "properties": {
        "slot": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "imageAssetId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" },
        "rotation": { "$ref": "#/$defs/angle" },
        "scaleX": { "$ref": "#/$defs/scale" }, "scaleY": { "$ref": "#/$defs/scale" },
        "pivotX": { "type": "number", "minimum": -4, "maximum": 4 },
        "pivotY": { "type": "number", "minimum": -4, "maximum": 4 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "type": { "description": "region (default: the image rectangle), mesh (plugin 1.4.0) or clipping (plugin 1.12.0: no picture; the slots after it through `end` draw only inside its polygon). Semantics in docs/contract.md.", "enum": ["region", "mesh", "clipping"] },
        "vertices": { "description": "Mesh: image-pixel positions of the setup shape, x, y per vertex (3..2048 vertices). Clipping: the clip polygon (3..256 points, simple, concave allowed) in the slot bone's space (through x..scaleY).", "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/coord" } },
        "end": { "description": "Clipping (plugin 1.12.0): the last slot (draw order, inclusive) the polygon clips; must come after the clipping slot.", "$ref": "#/$defs/id" },
        "sequence": {
          "description": "Image sequence (plugin 1.12.0): frames of one size drawn with this attachment's placement (imageAssetId = frames[0]); slot sequence keys pick the frame, setupIndex without keys. atlas: written by the export packer, one region (or null) per frame.",
          "type": "object", "additionalProperties": false, "required": ["frames"],
          "properties": {
            "frames": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "setupIndex": { "type": "integer", "minimum": 0, "maximum": 255 },
            "atlas": { "type": "array", "maxItems": 256, "items": { "anyOf": [{ "type": "null" }, { "type": "object" }] } }
          }
        },
        "uvs": { "description": "Mesh: texture coordinates 0..1, u, v per vertex.", "type": "array", "maxItems": 4096, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "triangles": { "description": "Mesh: vertex index triples (1..4096 triangles).", "type": "array", "maxItems": 12288, "items": { "type": "integer", "minimum": 0, "maximum": 2047 } },
        "hull": { "description": "Mesh, editor only: the first `hull` vertices are the outline polygon in order (re-triangulation source, plugin 1.6.0).", "type": "integer", "minimum": 0, "maximum": 2048 },
        "edges": { "description": "Mesh, editor only: index pairs of the outline edges and of internal edges the author pinned (kept by re-triangulation, plugin 1.6.0).", "type": "array", "maxItems": 16384, "items": { "type": "integer", "minimum": 0, "maximum": 2047 } },
        "atlas": {
          "description": "Written by the export packer (plugin 1.9.0), never by authoring: the picture is the sub-image (x, y, width, height; page pixels) of image asset `page`. `trim` (regions only): the rectangle of the attachment image that sub-image shows (the rest was transparent). Semantics in docs/contract.md.",
          "type": "object", "additionalProperties": false, "required": ["page", "x", "y", "width", "height"],
          "properties": {
            "page": { "type": "string", "minLength": 1, "maxLength": 64 },
            "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
            "trim": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
              "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } }
          }
        },
        "weights": {
          "description": "Weighted mesh: per vertex 1..4 bone shares (normalized to sum 1); the bind pose is the setup pose. Absent = the mesh follows the slot bone.",
          "type": "array", "maxItems": 2048,
          "items": { "type": "array", "minItems": 1, "maxItems": 4, "items": {
            "type": "object", "additionalProperties": false, "required": ["bone", "weight"],
            "properties": { "bone": { "$ref": "#/$defs/id" }, "weight": { "type": "number", "minimum": 0, "maximum": 1 } } } }
        }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "maxLength": 64 },
    "coord": { "type": "number", "minimum": -100000, "maximum": 100000 },
    "angle": { "type": "number", "minimum": -36000, "maximum": 36000 },
    "scale": { "type": "number", "minimum": -100, "maximum": 100 },
    "curveX": { "type": "number", "minimum": 0, "maximum": 1 },
    "curveY": { "type": "number", "minimum": -4, "maximum": 5 }
  }
}
