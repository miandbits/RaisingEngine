{
  "$schema": "../../../../packages/schema/event.schema.json",
  "formatVersion": "0.1.0",
  "id": "final-exam",
  "label": "마지막 날의 수료 시험",
  "window": {
    "fromPeriod": 5,
    "throughPeriod": 5
  },
  "requirements": {
    "op": "all",
    "conditions": [
      {
        "op": "flag",
        "flagId": "registered",
        "equals": true
      },
      {
        "op": "compare",
        "comparator": "gte",
        "left": {
          "op": "read",
          "target": {
            "kind": "attribute",
            "attributeId": "skill"
          }
        },
        "right": {
          "op": "literal",
          "value": 20
        }
      }
    ]
  },
  "priority": 80,
  "entryNodeId": "intro",
  "nodes": [
    {
      "id": "intro",
      "type": "dialogue",
      "speakerId": "mentor",
      "text": "배운 내용을 잘 보여줬구나. 수료를 축하해!",
      "next": "certify"
    },
    {
      "id": "certify",
      "type": "effect",
      "effects": [
        {
          "op": "setFlag",
          "flagId": "certified",
          "value": true
        },
        {
          "op": "add",
          "target": {
            "kind": "attribute",
            "attributeId": "skill"
          },
          "value": {
            "op": "literal",
            "value": 5
          }
        }
      ],
      "next": "end"
    },
    {
      "id": "end",
      "type": "end"
    }
  ]
}
