              {
                "costs": [
                  {
                    "amount": 2,
                    "attributeId": "money"
                  }
                ],
                "from": [
                  "ready"
                ],
                "id": "prepare",
                "name": "수련 준비",
                "to": "training"
              },
              {
                "costs": [
                  {
                    "amount": 3,
                    "attributeId": "money"
                  }
                ],
