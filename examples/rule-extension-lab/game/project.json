                  "training"
                ],
                "id": "complete",
                "name": "경지 돌파",
                "requirements": {
                  "args": {
                    "minimum": 10,
                    "stat": {
                      "$param": "stat"
                    }
                  },
                  "op": "ruleCondition",
                  "packageId": "dojo",
                  "ruleId": "threshold",
                  "version": "1.0.0"
                },
                "to": "mastered"
              },
              {
                "from": [
                  "mastered"
                ],
                "id": "restart",
                "name": "다음 수련 준비",
                "to": "ready"
              }
            ]
          }
        ],
        "version": "1.0.0"
      }
