{
  "$schema": "../../../packages/schema/event.schema.json",
  "formatVersion": "0.1.0",
  "id": "exam-invitation",
  "label": "수료 시험 초대",
  "window": {
    "fromPeriod": 2,
    "throughPeriod": 2
  },
  "requirements": {
    "op": "compare",
    "comparator": "gte",
    "left": {
      "op": "read",
      "target": {
        "kind": "attribute",
        "attributeId": "skill"
      }
    },
    "right": {
      "op": "literal",
      "value": 10
    }
  },
  "priority": 50,
  "entryNodeId": "intro",
  "nodes": [
    {
      "id": "intro",
      "type": "dialogue",
      "speakerId": "mentor",
      "text": "다음 달에 수료 시험이 있어. 참가하려면 접수비 5가 필요해.",
      "next": "registration"
    },
    {
      "id": "registration",
      "type": "choice",
      "prompt": "수료 시험에 참가할까요?",
      "choices": [
        {
          "id": "register",
          "text": "접수비 5를 내고 참가한다.",
          "requirements": {
            "op": "compare",
            "comparator": "gte",
            "left": {
              "op": "read",
              "target": {
                "kind": "attribute",
                "attributeId": "money"
              }
            },
            "right": {
              "op": "literal",
              "value": 5
            }
          },
          "effects": [
            {
              "op": "add",
              "target": {
                "kind": "attribute",
                "attributeId": "money"
              },
              "value": {
                "op": "literal",
                "value": -5
              }
            },
            {
              "op": "setFlag",
              "flagId": "registered",
              "value": true
            },
            {
              "op": "add",
              "target": {
                "kind": "relationship",
                "characterId": "mentor",
                "relationshipId": "trust"
              },
              "value": {
                "op": "literal",
                "value": 1
              }
            }
          ],
          "next": "end"
        },
        {
          "id": "decline",
          "text": "이번에는 참가하지 않는다.",
          "requirements": {
            "op": "always"
          },
          "effects": [],
          "next": "end"
        }
      ]
    },
    {
      "id": "end",
      "type": "end"
    }
  ]
}
