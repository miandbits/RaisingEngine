    },
    {
      "id": "reward",
      "type": "effect",
      "effects": [
        {
          "op": "add",
          "target": {
            "kind": "relationship",
            "characterId": "mentor",
            "relationshipId": "trust"
          },
          "value": {
            "op": "literal",
